"cite": "32 S. C., 159", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "31 S. C., 301", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4391912], "opinion_index": -1, "case_paths": ["/sc/31/0301-01"]}, {"cite": "42 S. C., 162", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4402524], "opinion_index": -1, "case_paths": ["/sc/42/0162-01"]}, {"cite": "25 S. C., 461", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716833], "opinion_index": -1, "case_paths": ["/sc/25/0461-01"]}, {"cite": "21 S. C., 583", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343713], "opinion_index": -1, "case_paths": ["/sc/21/0583-01"]}, {"cite": "1 Bail., 185", "category": "reporters:state", "reporter": "Bail.", "case_ids": [8483658], "opinion_index": -1, "case_paths": ["/scl/17/0185-01"]}, {"cite": "33 S. C., 254", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 584", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 S. C., 478", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "10 S. C., 469", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "6 S. C., 169", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4371750], "weight": 3, "opinion_index": -1, "case_paths": ["/sc/6/0169-01"]}, {"cite": "24 S. C., 202", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "31 S. C., 307", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "14 S. E., 675", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "35 S. C., 94", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396216], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/35/0094-01"]}, {"cite": "9 S. E., 729", "category": "reporte