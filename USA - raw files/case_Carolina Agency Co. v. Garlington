{"id": 1929795, "name": "CAROLINA AGENCY CO. v. GARLINGTON", "name_abbreviation": "Carolina Agency Co. v. Garlington", "decision_date": "1910-03-05", "docket_number": "7470", "first_page": "114", "last_page": "128", "citations": [{"type": "official", "cite": "85 S.C. 114"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "61 Miss., 170", "category": "reporters:state", "reporter": "Miss.", "case_ids": [1796511], "opinion_index": -1, "case_paths": ["/miss/61/0170-01"]}, {"cite": "10 Wall, 306", "category": "reporters:scotus_early", "reporter": "Wall,", "opinion_index": -1}, {"cite": "5 Rich., 63", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "95 U. S., 174", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "62 S. C., 526", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415714], "opinion_index": -1, "case_paths": ["/sc/62/0526-01"]}, {"cite": "39 S. C., 484", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364810], "opinion_index": -1, "case_paths": ["/sc/39/0484-01"]}, {"cite": "37 S. C., 87", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "31 S. C., 46", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "89 Fed. R., 964", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "24 Neb., 782", "category": "reporters:state", "reporter": "Neb.", "case_ids": [4415072], "opinion_index": -1, "case_paths": ["/neb/24/0782-01"]}, {"cite": "5 Minn., 569", "category": "reporters:state", "reporter": "Minn.", "opinion_index": -1}, {"cite": "35 S. W., 708", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "85 Col., 642", "category": "reporters:state", "reporter": "Col.,", "opinion_index": -1}, {"cite"