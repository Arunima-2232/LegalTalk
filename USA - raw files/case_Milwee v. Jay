{"id": 4404969, "name": "MILWEE v. JAY", "name_abbreviation": "Milwee v. Jay", "decision_date": "1896-08-01", "docket_number": "", "first_page": "430", "last_page": "446", "citations": [{"type": "official", "cite": "47 S.C. 430"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "7 Wend., 267", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2009761], "opinion_index": -1, "case_paths": ["/wend/7/0267-01"]}, {"cite": "2 Hill, 326", "category": "reporters:state", "reporter": "Hill,", "case_ids": [11253889], "opinion_index": -1, "case_paths": ["/scl/20/0326-01"]}, {"cite": "21 S. C., 600", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343022, 2343270], "opinion_index": -1, "case_paths": ["/sc/21/0600-01", "/sc/21/0600-02"]}, {"cite": "49 Wis., 94", "category": "reporters:state", "reporter": "Wis.", "opinion_index": -1}, {"cite": "70 Tex., 740", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2194250], "opinion_index": -1, "case_paths": ["/tex/70/0740-01"]}, {"cite": "104 Pa. St., 356", "category": "reporters:state", "reporter": "Pa.", "case_ids": [452122], "opinion_index": -1, "case_paths": ["/pa/104/0356-01"]}, {"cite": "7 Wend., 367", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2009608], "opinion_index": -1, "case_paths": ["/wend/7/0367-01"]}, {"cite": "136 Mass., 326", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2149187], "opinion_index": -1, "case_paths": ["/mass/136/0326-01"]}, {"cite": "4 Strob., 95", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "1 Rich., 210", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486508], "opinion_index": -1, "case_paths": ["/scl/30/0210-01"]}, {"cite": "6 Pet., 93", "category": "reporters:scotus_early", "reporter": "Pet.", "opinion_index": -1},