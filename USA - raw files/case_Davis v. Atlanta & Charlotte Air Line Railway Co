{"id": 2350505, "name": "DAVIS v. ATLANTA AND CHARLOTTE AIR LINE RAILWAY COMPANY", "name_abbreviation": "Davis v. Atlanta & Charlotte Air Line Railway Co.", "decision_date": "1902-04-08", "docket_number": "", "first_page": "370", "last_page": "394", "citations": [{"type": "official", "cite": "63 S.C. 370"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "26 S. C., 263", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "28 S. C., 440", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4389471], "opinion_index": -1, "case_paths": ["/sc/28/0440-01"]}, {"cite": "10 L. R. A., 794", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "71 Tex., 614", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2192734], "opinion_index": -1, "case_paths": ["/tex/71/0614-01"]}, {"cite": "80 N. Y., 29", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "15 Wall., 90", "category": "reporters:scotus_early", "reporter": "Wall.,", "opinion_index": -1}, {"cite": "17 Wall., 445", "category": "reporters:scotus_early", "reporter": "Wall.,", "case_ids": [62432], "opinion_index": -1, "case_paths": ["/us/84/0445-01"]}, {"cite": "32 Am. St. R., 615", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "65 la., 658", "category": "reporters:state", "reporter": "Iowa", "case_ids": [4378541], "opinion_index": -1, "case_paths": ["/iowa/65/0658-01"]}, {"cite": "34 S. C., 299", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 139", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 S. C., 497", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "136 N. Y., 650", "category": "reporters:state",