{"id": 4425101, "name": "MADDEN & CO. v. PHOENIX INS. CO.", "name_abbreviation": "Madden & Co. v. Phoenix Ins.", "decision_date": "1904-11-30", "docket_number": "", "first_page": "295", "last_page": "309", "citations": [{"type": "official", "cite": "70 S.C. 295"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "55 S'. C., 450", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4410194], "opinion_index": -1, "case_paths": ["/sc/55/0450-01"]}, {"cite": "98 Ga., 754", "category": "reporters:state", "reporter": "Ga.", "case_ids": [384041], "opinion_index": -1, "case_paths": ["/ga/98/0754-01"]}, {"cite": "65 Ark., 240", "category": "reporters:state", "reporter": "Ark.", "case_ids": [609348], "opinion_index": -1, "case_paths": ["/ark/65/0240-01"]}, {"cite": "13 S. W., 1103", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "67 S'. W., 153", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "48 S. W., 559", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "115 Ga., 454", "category": "reporters:state", "reporter": "Ga.", "case_ids": [412872, 412874], "opinion_index": -1, "case_paths": ["/ga/115/0454-01", "/ga/115/0454-02"]}, {"cite": "113 la., 555", "category": "reporters:state", "reporter": "Iowa", "case_ids": [2468573], "weight": 2, "opinion_index": -1, "case_paths": ["/la/113/0555-01"]}, {"cite": "128 Ala., 451", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3439074], "opinion_index": -1, "case_paths": ["/ala/128/0451-01"]}, {"cite": "110 Pa. St., 548", "category": "reporters:state", "reporter": "Pa.", "case_ids": [543776], "opinion_index": -1, "case_paths": ["/pa/110/0548-01"]}, {"cite": "41 Pa. St., 161", "category": "reporters:state", "reporter": "Pa.", "case_ids": [4800