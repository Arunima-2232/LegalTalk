{"id": 2352432, "name": "MAYS v. SEABOARD AIR LINE RY.", "name_abbreviation": "Mays v. Seaboard Air Line Ry.", "decision_date": "1906-11-29", "docket_number": "", "first_page": "455", "last_page": "471", "citations": [{"type": "official", "cite": "75 S.C. 455"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "38 L. R. A., 674", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "7 U. S., 553", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "50 S. C., 259", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4407966], "opinion_index": -1, "case_paths": ["/sc/50/0259-01"]}, {"cite": "70 S. C., 56", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4423982], "opinion_index": -1, "case_paths": ["/sc/70/0056-01"]}, {"cite": "69 S. C., 460", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422083], "opinion_index": -1, "case_paths": ["/sc/69/0460-01"]}, {"cite": "43 U. S., 704", "category": "reporters:federal", "reporter": "U.S.", "pin_cites": [{"page": "864"}], "opinion_index": -1}, {"cite": "99 U. S., 700", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3373942], "opinion_index": -1, "case_paths": ["/us/99/0700-01"]}, {"cite": "60 Me., 390", "category": "reporters:state", "reporter": "Me.", "opinion_index": -1}, {"cite": "37 Wis., 445", "category": "reporters:state", "reporter": "Wis.", "opinion_index": -1}, {"cite": "63 S. C., 53", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 U. S., 495", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [102729], "opinion_index": -1, "case_paths": ["/us/41/0495-01"]}, {"cite": "31 U. S., 494", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "8 S. E., 466", "category": "r