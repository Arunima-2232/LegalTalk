{"id": 4417738, "name": "BODIE v. CHAR. & WEST. CAR. RY. CO.", "name_abbreviation": "Bodie v. Char. & West. Car. Ry. Co.", "decision_date": "1903-05-18", "docket_number": "", "first_page": "302", "last_page": "326", "citations": [{"type": "official", "cite": "66 S.C. 302"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "64 S. C., 112", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "42 S. C., 471", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C., 407", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Strob., 550", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "42 S. C., 414", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 S. C., 479", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "42 S. C., 467", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 S. C., 215", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "18 S. C., 282", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4379589], "pin_cites": [{"page": "270"}], "opinion_index": -1, "case_paths": ["/sc/18/0282-01"]}, {"cite": "38 S. C., 213", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 263", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "44 S. C., 443", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 169", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. C., 510", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Bay, 52", "category": "reporters:state", "reporter":