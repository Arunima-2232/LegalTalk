{"id": 4415205, "name": "TINDAL v. NEAL", "name_abbreviation": "Tindal v. Neal", "decision_date": "1900-09-18", "docket_number": "", "first_page": "4", "last_page": "22", "citations": [{"type": "official", "cite": "59 S.C. 4"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "2 Hill Ch., 638", "category": "reporters:state", "reporter": "Hill Eq.", "case_ids": [1833159], "opinion_index": -1, "case_paths": ["/sc-eq/11/0487-01"]}, {"cite": "15 S. C., 421", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716468], "opinion_index": -1, "case_paths": ["/sc/15/0421-01"]}, {"cite": "43 S. C., 414", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346385], "opinion_index": -1, "case_paths": ["/sc/43/0414-01"]}, {"cite": "8 How., 495", "category": "reporters:scotus_early", "reporter": "How.", "case_ids": [3350446], "opinion_index": -1, "case_paths": ["/us/49/0495-01"]}, {"cite": "4 Pet-, 1", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [3308801], "opinion_index": -1, "case_paths": ["/us/29/0001-01"]}, {"cite": "3 Pet., 376", "category": "reporters:scotus_early", "reporter": "Pet.", "opinion_index": -1}, {"cite": "73 U. S-, 458", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3456203], "opinion_index": -1, "case_paths": ["/us/73/0458-01"]}, {"cite": "20 S. C., 75", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Rich. Eq., 285", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "72 U. S., 268", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3458182], "opinion_index": -1, "case_paths": ["/us/72/0268-01"]}, {"cite": "2 S. C., 78", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "11 Rich. Eq., 530", "category": "reporters:state", "reporte