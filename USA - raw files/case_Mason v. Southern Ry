{"id": 4413803, "name": "MASON v. SOUTHERN RY.", "name_abbreviation": "Mason v. Southern Ry.", "decision_date": "1900-06-27", "docket_number": "", "first_page": "70", "last_page": "82", "citations": [{"type": "official", "cite": "58 S.C. 70"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "28 S. C., 1585", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "6 Gray, 450", "category": "reporters:state", "reporter": "Gray", "case_ids": [1994686], "opinion_index": -1, "case_paths": ["/mass/72/0450-01"]}, {"cite": "12 S. C., 97", "category": "reporters:state", "reporter": "S.C.", "case_ids": [361284], "opinion_index": -1, "case_paths": ["/sc/12/0097-01"]}, {"cite": "52 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378506], "opinion_index": -1, "case_paths": ["/sc/52/0323-01"]}, {"cite": "16 S. C., 550", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377214], "opinion_index": -1, "case_paths": ["/sc/16/0550-01"]}, {"cite": "25 S. C., 3225", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4400787], "opinion_index": -1, "case_paths": ["/sc/41/0001-01"]}, {"cite": "29 S. C., 517", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 S. C., 292", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4394688], "pin_cites": [{"page": "444"}], "opinion_index": -1, "case_paths": ["/sc/34/0292-01"]}, {"cite": "33 S. C., 1355", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 S. C., 63", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387895], "opinion_index": -1, "case_paths": ["/sc/27/0063-01"]}, {"cite": "119 U. S., 995", "category": "reporters:feder