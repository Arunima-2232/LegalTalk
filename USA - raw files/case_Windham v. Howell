{"id": 1917208, "name": "WINDHAM v. HOWELL", "name_abbreviation": "Windham v. Howell", "decision_date": "1907-09-17", "docket_number": "6659", "first_page": "187", "last_page": "199", "citations": [{"type": "official", "cite": "78 S.C. 187"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "18 S. C., 600", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4379396, 4379406], "opinion_index": -1, "case_paths": ["/sc/18/0600-01", "/sc/18/0600-02"]}, {"cite": "70 S. C., 217", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4424995], "opinion_index": -1, "case_paths": ["/sc/70/0217-01"]}, {"cite": "50 S. C., 536", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 S. C., 408", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387863], "opinion_index": -1, "case_paths": ["/sc/27/0408-01"]}, {"cite": "70 S. C., 219", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C., 293", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "66 S. C., 18", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4417791], "opinion_index": -1, "case_paths": ["/sc/66/0018-01"]}, {"cite": "61 S. C., 287", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 123", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 374", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 S. C., 569", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716662], "opinion_index": -1, "case_paths": ["/sc/36/0569-01"]}, {"cite": "23 S. C., 391", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "36 S. C., 301", "category": "reporters:state", "rep