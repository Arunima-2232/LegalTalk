{"id": 4414736, "name": "ROBERT v. ELLIS", "name_abbreviation": "Robert v. Ellis", "decision_date": "1900-11-28", "docket_number": "", "first_page": "137", "last_page": "162", "citations": [{"type": "official", "cite": "59 S.C. 137"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "51 S. C., 555", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716846], "opinion_index": -1, "case_paths": ["/sc/51/0555-01"]}, {"cite": "56 S. C., 7", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503164], "opinion_index": -1, "case_paths": ["/sc/56/0007-01"]}, {"cite": "11 Strob. Eq., 101", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "8 Rich. Eq., 259", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713389], "opinion_index": -1, "case_paths": ["/sc-eq/29/0259-01"]}, {"cite": "27 S. C., 479", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387611], "opinion_index": -1, "case_paths": ["/sc/27/0479-01"]}, {"cite": "28 S. C., 485", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 290", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377945], "pin_cites": [{"page": "304"}], "opinion_index": -1, "case_paths": ["/sc/16/0290-01"]}, {"cite": "37 S. C., 258539", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "7 Rich. Eq., 419", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "33 S. C., 293", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392955], "opinion_index": -1, "case_paths": ["/sc/33/0293-01"]}, {"cite": "36 S. C., 366", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Strob. Eq., 59", "category": "reporters:state", "reporter": "Strob. Eq.", "