{"id": 4374910, "name": "CURETON v. MILLS", "name_abbreviation": "Cureton v. Mills", "decision_date": "1880-04-24", "docket_number": "CASE No. 865", "first_page": "409", "last_page": "430", "citations": [{"type": "official", "cite": "13 S.C. 409"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "7 S. C. 60", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4372761], "opinion_index": -1, "case_paths": ["/sc/7/0060-01"]}, {"cite": "5 Pet. 518", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [534540], "opinion_index": -1, "case_paths": ["/us/30/0332-01"]}, {"cite": "2 Bail. 436", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2510564], "opinion_index": -1, "case_paths": ["/scl/18/0436-01"]}, {"cite": "44 Texas 497", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2162060], "opinion_index": -1, "case_paths": ["/tex/44/0497-01"]}, {"cite": "45 Iowa 221", "category": "reporters:state", "reporter": "Iowa", "case_ids": [2312739], "weight": 2, "opinion_index": -1, "case_paths": ["/iowa/45/0221-01"]}, {"cite": "6 How. 59", "category": "reporters:scotus_early", "reporter": "How.", "opinion_index": -1}, {"cite": "16 Wall. 610", "category": "reporters:scotus_early", "reporter": "Wall.", "case_ids": [411271], "opinion_index": -1, "case_paths": ["/us/83/0610-01"]}, {"cite": "2 Bail. 438", "category": "reporters:state", "reporter": "Bail.", "opinion_index": -1}, {"cite": "5 Ired. Eq. 367", "category": "reporters:state", "reporter": "Ired. Eq.", "opinion_index": -1}, {"cite": "7 S. C. 63", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4373477], "opinion_index": -1, "case_paths": ["/sc/7/0063-01"]}, {"cite": "8 S. C. 112", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503594], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/8/0