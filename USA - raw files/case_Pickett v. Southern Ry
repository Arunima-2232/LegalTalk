{"id": 4428455, "name": "PICKETT v. SOUTHERN RY.-CAROLINA DIVISION", "name_abbreviation": "Pickett v. Southern Ry.", "decision_date": "1906-04-18", "docket_number": "", "first_page": "236", "last_page": "245", "citations": [{"type": "official", "cite": "74 S.C. 236"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "64 S. C., 242", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381994], "opinion_index": -1, "case_paths": ["/sc/64/0242-01"]}, {"cite": "30 S. C., 575", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "601 S. C., 495", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 113", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "30 S. C., 574", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "70 S. C., 243", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "701 S. C., 344", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "18 S. C., 315", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 S. C., 491", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4373836], "opinion_index": -1, "case_paths": ["/sc/13/0491-01"]}, {"cite": "28 S. C., 386", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 S. C., 334", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Greene, 147", "category": "reporters:state", "reporter": "Greene", "case_ids": [1872431], "opinion_index": -1, "case_paths": ["/greene/1/0147-01"]}, {"cite": "68 S. C., 506", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4421093], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/68/0506-01"]}, {