{"id": 8716773, "name": "NEAL v. BLECKLEY", "name_abbreviation": "Neal v. Bleckley", "decision_date": "1898-03-17", "docket_number": "", "first_page": "506", "last_page": "534", "citations": [{"type": "official", "cite": "51 S.C. 506"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 S. C., 551", "category": "reporters:state", "reporter": "S.C.", "case_ids": [359582], "opinion_index": -1, "case_paths": ["/sc/11/0551-01"]}, {"cite": "29 S. C., 278", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4390571], "opinion_index": -1, "case_paths": ["/sc/29/0278-01"]}, {"cite": "3 Rich., 440", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "125 Mass., 138", "category": "reporters:state", "reporter": "Mass.", "case_ids": [730951], "opinion_index": -1, "case_paths": ["/mass/125/0138-01"]}, {"cite": "24 Hun., 277", "category": "reporters:state", "reporter": "Hun.,", "opinion_index": -1}, {"cite": "70 Ala., 596", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3269301], "opinion_index": -1, "case_paths": ["/ala/70/0596-01"]}, {"cite": "95 Mo., 337", "category": "reporters:state", "reporter": "Mo.", "case_ids": [1017044], "opinion_index": -1, "case_paths": ["/mo/95/0337-01"]}, {"cite": "54 Mass., 471", "category": "reporters:state", "reporter": "Mass.", "case_ids": [1978369], "opinion_index": -1, "case_paths": ["/mass/54/0471-01"]}, {"cite": "111 N.Y., 228", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2218136], "opinion_index": -1, "case_paths": ["/ny/111/0228-01"]}, {"cite": "128 N.Y., 558", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "118 Ill., 275", "category": "reporters:state", "reporter": "Ill.", "case_ids": [5380918], "opinion_index": -1, "case_paths": ["/ill/118/0275-01"]}, {"cite": "13 Phila., 201", "