{"id": 8716262, "name": "SCAIFE v. THOMSON", "name_abbreviation": "Scaife v. Thomson", "decision_date": "1881-07-02", "docket_number": "CASE No. 1047", "first_page": "337", "last_page": "370", "citations": [{"type": "official", "cite": "15 S.C. 337"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "29 N. J. 153", "category": "reporters:state", "reporter": "N.J.", "opinion_index": -1}, {"cite": "14 Rich. Eq. 256", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "2 Black 418", "category": "reporters:scotus_early", "reporter": "Black", "case_ids": [3466098], "year": 1880, "opinion_index": -1, "case_paths": ["/us/67/0418-01"]}, {"cite": "47 Barb. 263", "category": "reporters:state", "reporter": "Barb.", "case_ids": [1946992], "opinion_index": -1, "case_paths": ["/barb/47/0263-01"]}, {"cite": "8 Mass. 3", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2028473], "opinion_index": -1, "case_paths": ["/mass/8/0009-01"]}, {"cite": "2 Strob. Eq. 283", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "16 How. 275", "category": "reporters:scotus_early", "reporter": "How.", "case_ids": [3483484], "opinion_index": -1, "case_paths": ["/us/57/0275-01"]}, {"cite": "8 Wheat. 77", "category": "reporters:scotus_early", "reporter": "Wheat.", "opinion_index": -1}, {"cite": "1 Story 478", "category": "reporters:federal", "reporter": "Story", "case_ids": [6104080], "opinion_index": -1, "case_paths": ["/f-cas/4/0127-01"]}, {"cite": "1 Strob. Eq. 350", "category": "reporters:state", "reporter": "Strob. Eq.", "case_ids": [2192173], "opinion_index": -1, "case_paths": ["/sc-eq/20/0350-01"]}, {"cite": "3 Desaus. 245", "category": "reporters:state", "reporter": "Des.", "opinion_index": -1}, {"cite": "19 Gratt. 38", "category": "reporters:state", "reporter": "G