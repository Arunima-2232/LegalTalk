{"id": 1935080, "name": "ATLANTIC COAST LINE R. R. CO. v. SEABOARD AIR LINE RAILWAY", "name_abbreviation": "Atlantic Coast Line R. R. v. Seaboard Air Line Railway", "decision_date": "1911-04-25", "docket_number": "7877", "first_page": "464", "last_page": "477", "citations": [{"type": "official", "cite": "88 S.C. 464"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "36 S. C. 125", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715550], "opinion_index": -1, "case_paths": ["/sc/36/0125-01"]}, {"cite": "1 S. C, 46", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503788], "opinion_index": -1, "case_paths": ["/sc/1/0046-01"]}, {"cite": "27 L. R. A. 710", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "136 U. S. 436", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [1217862], "opinion_index": -1, "case_paths": ["/us/136/0436-01"]}, {"cite": "129 U. S. 26", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8299111], "opinion_index": -1, "case_paths": ["/us/129/0026-01"]}, {"cite": "113 U. S. 27", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3513187], "opinion_index": -1, "case_paths": ["/us/113/0027-01"]}, {"cite": "167 U. S. 88", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3594469], "opinion_index": -1, "case_paths": ["/us/167/0088-01"]}, {"cite": "151 U. S. 556", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8298979], "opinion_index": -1, "case_paths": ["/us/151/0556-01"]}, {"cite": "170 U. S. 57", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3599395], "opinion_index": -1, "case_paths": ["/us/170/0057-01"]}, {"cite": "34 At. 619", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "37 At. 90", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "25 N. E. 588", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "9 S. E. 783", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "58 Fed. 50", "category": "reporters:federal", "reporter": "F.", "case_ids": [6731432], "opinion_index": -1, "case_paths": ["/f/58/0050-01"]}, {"cite": "2 N. W. 16", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "36 L. R. A. 566", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "53 Pa. St. 224", "category": "reporters:state", "reporter": "Pa.", "case_ids": [1004755], "opinion_index": -1, "case_paths": ["/pa/53/0224-01"]}, {"cite": "52 N. W. 687", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "4 S. C. 402", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 S. C. 415", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C. 293", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "63 S. C. 38", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350907], "opinion_index": -1, "case_paths": ["/sc/63/0038-01"]}, {"cite": "42 S. C. 93", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C. 39", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4384004], "opinion_index": -1, "case_paths": ["/sc/24/0039-01"]}, {"cite": "21 S. C. 234", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C. 411", "category": "reporters:state", "reporter": "S.C.", "case_ids": [363276], "opinion_index": -1, "case_paths": ["/sc/17/0411-01"]}, {"cite": "87 S. C. 270", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1933003], "opinion_index": -1, "case_paths": ["/sc/