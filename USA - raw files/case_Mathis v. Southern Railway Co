{"id": 8716187, "name": "MATHIS v. SOUTHERN RAILWAY CO.", "name_abbreviation": "Mathis v. Southern Railway Co.", "decision_date": "1898-09-28", "docket_number": "", "first_page": "246", "last_page": "258", "citations": [{"type": "official", "cite": "53 S.C. 246"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "16 S. C., 495", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 340", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C., 134", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "16 S. C., 102", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "14 S. C., 553", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 306", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716079], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/51/0306-01"]}, {"cite": "52 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378577], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/52/0001-01"]}, {"cite": "107 U. S., 518", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "21 S. C., 420", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343375], "opinion_index": -1, "case_paths": ["/sc/21/0420-01"]}, {"cite": "2 Rich., 154", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8857742], "opinion_index": -1, "case_paths": ["/scl/31/0154-01"]}, {"cite": "103 Mo., 570", "category": "reporters:state", "reporter": "Mo.", "case_ids": [418659], "opinion_index": -1, "case_paths": ["/mo/103/0570-01"]}, {"cite": "4 Gill, 406", "category": "reporters:state", "reporter": "Gill", "case_ids": [1678299], "opinion_index": -1, "case_paths": ["/gil