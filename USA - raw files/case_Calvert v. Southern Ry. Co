{"id": 381982, "name": "CALVERT v. SOUTHERN RY. CO", "name_abbreviation": "Calvert v. Southern Ry. Co.", "decision_date": "1900-08-10", "docket_number": "", "first_page": "139", "last_page": "162", "citations": [{"type": "official", "cite": "64 S.C. 139"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "170 U. S., 100", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3599735], "pin_cites": [{"page": "552"}], "opinion_index": -1, "case_paths": ["/us/170/0100-01"]}, {"cite": "176 U. S., 659", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "161 U. S., 545", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5701404], "opinion_index": -1, "case_paths": ["/us/161/0545-01"]}, {"cite": "53 S. C., 246", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716187], "opinion_index": -1, "case_paths": ["/sc/53/0246-01"]}, {"cite": "103 U. S., 485", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [1522224], "opinion_index": 0, "case_paths": ["/us/103/0485-01"]}, {"cite": "104 U. S., 5", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3494392], "opinion_index": 0, "case_paths": ["/us/104/0005-01"]}, {"cite": "2 Sup. Ct. Rep., 432", "category": "reporters:federal", "reporter": "S. Ct.", "case_ids": [3499692], "opinion_index": 0, "case_paths": ["/us/107/0581-01"]}, {"cite": "48 S. C., 49", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4406221], "opinion_index": 0, "case_paths": ["/sc/48/0049-01"]}, {"cite": "174 U. S., 552", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3606679], "weight": 2, "opinion_index": 0, "case_paths": ["/us/174/0552-01"]}, {"cite": "2 Howard, 497", "category": "reporters:state", "reporter": "Howard", "opinion_index": 0}, {"cite": "5 Cranch, 61", "category": "re