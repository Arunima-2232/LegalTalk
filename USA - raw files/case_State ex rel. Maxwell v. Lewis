{"id": 2343384, "name": "State ex rel. Maxwell v. Lewis", "name_abbreviation": "State ex rel. Maxwell v. Lewis", "decision_date": "1884-07-03", "docket_number": "No. 1590", "first_page": "598", "last_page": "599", "citations": [{"type": "official", "cite": "21 S.C. 598"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 116, "char_count": 1200, "ocr_confidence": 0.487, "pagerank": {"raw": 3.022018560637989e-07, "percentile": 0.8539526821834015}, "sha256": "0ded575a562500bc7b8b3a4a9988252e2f88200c803945ff9622334d40b54417", "simhash": "1:85cfcdfc5f8f71ee", "word_count": 202}, "last_updated": "2023-07-14T20:46:27.121246+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["State ex rel. Maxwell v. Lewis."], "opinions": [{"text": "Opinion by\nMr. Chiee Justice Simpson,\nThe relator, alleging infancy and non-service of process, applied to the Circuit Court for a writ of certiorari directed to \u25a0 Whaley, a trial justice, requiring him to certify the proceedings in the case of Lewis v. Maxwell, heard and decided by him October 27, 1883. The return by the trial justice set forth all the proceedings, which showed a service by the trial justice upon the-defendant in that case of the summons and complaint, an appearance by the defendant, and that there was no plea of infancy, the trial justice stating \u201cthat no plea of minority ivas ever made before me in the oral answer or in evidence.\u201d Upon hearing, this return, the court, Witherspoon, J., dismissed the proceedings, with costs. An appeal from this judgment was dismissed, the court saying that the question must be determined by an inspection of the return and the face of the proceedings, and they failed to show the relator\u2019s infancy, and did show his voluntary appearance, even though there had been an irregular and perhaps unwarranted service.'", "type": "majority", "author": "Mr. Chiee Justice Simpson,"}], "attorneys": ["Bowen Lee, for appellant. Cr. M. Trenholm, contra."], "corrections": "", "head_matter": "No. 1590.\nState ex rel. Maxwell v. Lewis.\nApril Term, 1884.\nJuly 3, 1884.\nBowen Lee, for appellant. Cr. M. Trenholm, contra."}, "file_name": "0598-01", "first_page_order": 618, "last_page_order": 619}