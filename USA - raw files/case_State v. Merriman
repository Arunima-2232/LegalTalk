{"id": 4395209, "name": "State v. Merriman", "name_abbreviation": "State v. Merriman", "decision_date": "1891-01-26", "docket_number": "No. 2840", "first_page": "607", "last_page": "607", "citations": [{"type": "official", "cite": "35 S.C. 607"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "34 S. C., 28", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}], "analysis": {"cardinality": 75, "char_count": 697, "ocr_confidence": 0.569, "sha256": "16451e3b0cea4daa6176f825d7a1ce669596d8b5cea147ab950b8bcd8f56a7c2", "simhash": "1:ed2d56ffefc19696", "word_count": 121}, "last_updated": "2024-02-27T18:54:34.472509+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["State v. Merriman."], "opinions": [{"text": "per Curiam,\nThis was a petition to recall the remittitur, the real object being to obtain a consideration of the question of the constitutionality of the court which dismissed the petition for rehearing in June, 1891. The court ruled that the remittitur of this court having been duly sent to the Circuit Court under the seal of this court, and the Circuit Court having already acted in carrying out the mandate thereof by reassigning a day for the execution of the sentence before imposed, it is now too late to make the motion. Petition dismissed", "type": "majority", "author": "per Curiam,"}], "attorneys": ["Sough Kennedy and Prince Stevenson, for the motion."], "corrections": "", "head_matter": "No. 2840.\nState v. Merriman.\nNovember Term, 1891.\n(See 34 S. C., 28 and 576.)\nJanuary 26, 1891.\nSough Kennedy and Prince Stevenson, for the motion."}, "file_name": "0607-04", "first_page_order": 617, "last_page_order": 617}