{"id": 1935192, "name": "GIBSON v. ATLANTIC COAST LINE R. R. CO.", "name_abbreviation": "Gibson v. Atlantic Coast Line R. R.", "decision_date": "1911-04-15", "docket_number": "7857", "first_page": "360", "last_page": "368", "citations": [{"type": "official", "cite": "88 S.C. 360"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "9 Wheat. 8", "category": "reporters:scotus_early", "reporter": "Wheat.", "opinion_index": -1}, {"cite": "78 S. C. 54", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "50 S. C. 129", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408100], "opinion_index": -1, "case_paths": ["/sc/50/0129-01"]}, {"cite": "72 S. C. 44", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "78 S. C. 47", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C. 317", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915582], "opinion_index": -1, "case_paths": ["/sc/77/0317-01"]}, {"cite": "76 S. C. 308", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429643], "opinion_index": -1, "case_paths": ["/sc/76/0308-01"]}, {"cite": "79 S. C. 341", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1919543], "opinion_index": -1, "case_paths": ["/sc/79/0341-01"]}, {"cite": "66 S. C. 477", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4417921], "opinion_index": -1, "case_paths": ["/sc/66/0477-01"]}, {"cite": "77 S. C. 471", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "71 S. C. 506", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4425546], "opinion_index": -1, "case_paths": ["/sc/71/0506-01"]}, {"cite": "5 S. C. 358", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4369532], "opinion_in