{"id": 1929890, "name": "ALDERMAN v. WELLS, TREASURER", "name_abbreviation": "Alderman v. Wells", "decision_date": "1910-04-12", "docket_number": "7546", "first_page": "507", "last_page": "520", "citations": [{"type": "official", "cite": "85 S.C. 507"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "54 Ga., 330", "category": "reporters:state", "reporter": "Ga.", "case_ids": [873082], "opinion_index": -1, "case_paths": ["/ga/54/0330-01"]}, {"cite": "60 Ga., 93", "category": "reporters:state", "reporter": "Ga.", "case_ids": [17651], "opinion_index": -1, "case_paths": ["/ga/60/0093-01"]}, {"cite": "46 Penn., 31", "category": "reporters:state", "reporter": "Penn.,", "opinion_index": -1}, {"cite": "3 Strob., 395", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8486870], "opinion_index": -1, "case_paths": ["/scl/34/0395-01"]}, {"cite": "111 U. S., 701", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3506722], "opinion_index": -1, "case_paths": ["/us/111/0701-01"]}, {"cite": "115 U. S., 321", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3514416], "opinion_index": -1, "case_paths": ["/us/115/0321-01"]}, {"cite": "71 Mich., 21", "category": "reporters:state", "reporter": "Mich.", "weight": 2, "opinion_index": -1}, {"cite": "78 S. C., 211", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1917256], "opinion_index": -1, "case_paths": ["/sc/78/0211-01"]}, {"cite": "63 S. C., 429", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "43 Mo., 480", "category": "reporters:state", "reporter": "Mo.", "opinion_index": -1}, {"cite": "43 Mo., 491", "category": "reporters:state", "reporter": "Mo.", "case_ids": [952531], "weight": 2, "opinion_index": -1, "case_paths": ["/mo/43/0491-01"]}, {"cite": "68 S. C., 411", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4421603], "opinion_index": -1, "case_paths": ["/sc/68/0411-01"]}, {"cite": "22 Mo. App., 8", "category": "reporters:state", "reporter": "Mo. App.", "case_ids": [543504], "opinion_index": -1, "case_paths": ["/mo-app/22/0008-01"]}, {"cite": "67 Pac., 68", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "25 Mo., 258", "category": "reporters:state", "reporter": "Mo.", "case_ids": [8854772], "opinion_index": -1, "case_paths": ["/mo/25/0258-01"]}, {"cite": "31 S. W., 52", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "36 Atl., 173", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "82 N. W. 336", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "60 N. E., 870", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "147 U. S., 190", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3565526], "opinion_index": -1, "case_paths": ["/us/147/0190-01"]}, {"cite": "25 Pac., 73", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "59 Md., 378", "category": "reporters:state", "reporter": "Md.", "case_ids": [1038933], "opinion_index": -1, "case_paths": ["/md/59/0378-01"]}, {"cite": "62 S. C., 34", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "157 U'. S., 429", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3583743], "opinion_index": -1, "case_paths": ["/us/157/0429-01"]}, {"cite": "67 Am. St. R., 224", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "22 Fed., 602", "category": "reporters:federal", "reporter": "F.", "case_ids": [6720166], "opinion_index": -1, "case_paths": ["/f/22/0602-01"]}, {"cite": "21 Fed., 539", "category": "reporters:federal", "reporter": "F.", "case_ids": [37753