{"id": 4404855, "name": "HUNTER v. RUFF; BUCHANAN v. RUFF", "name_abbreviation": "Hunter v. Ruff", "decision_date": "1896-07-06", "docket_number": "", "first_page": "525", "last_page": "556", "citations": [{"type": "official", "cite": "47 S.C. 525"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "3 S. C., 437", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 S. C., 173", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4386603], "opinion_index": -1, "case_paths": ["/sc/26/0173-01"]}, {"cite": "25 S. C., 279", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "18 S. C., 126", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C., 125", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Hill, 403", "category": "reporters:state", "reporter": "Hill,", "case_ids": [11254302], "opinion_index": -1, "case_paths": ["/scl/20/0403-01"]}, {"cite": "1 Hill, 287", "category": "reporters:state", "reporter": "Hill,", "opinion_index": -1}, {"cite": "2 Bay, 169", "category": "reporters:state", "reporter": "Bay", "case_ids": [8672455], "opinion_index": -1, "case_paths": ["/scl/2/0169-01"]}, {"cite": "14 S. C., 480", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4376342], "opinion_index": -1, "case_paths": ["/sc/14/0480-01"]}, {"cite": "2 Strob., 218", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "2 Hill, 438", "category": "reporters:state", "reporter": "Hill,", "case_ids": [11254644], "opinion_index": -1, "case_paths": ["/scl/20/0438-01"]}, {"cite": "15 S. C., 42", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 290", "category": "reporters:state", "reporter": "S.C.", "case_ids": [43779