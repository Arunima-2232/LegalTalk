{"id": 4419190, "name": "DICKSON v. BURCKMYER (two Cases)", "name_abbreviation": "Dickson v. Burckmyer", "decision_date": "1903-11-28", "docket_number": "", "first_page": "526", "last_page": "541", "citations": [{"type": "official", "cite": "67 S.C. 526"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "50 S. C., 466", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. C., 290", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "31 S. C., 567", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "40 S. C., 14", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 S. C., 395", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 518", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 Miss., 748", "category": "reporters:state", "reporter": "Miss.", "case_ids": [368525], "opinion_index": -1, "case_paths": ["/miss/62/0748-01"]}, {"cite": "62 N. Y., 362", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "23 Cal., 287", "category": "reporters:state", "reporter": "Cal.", "case_ids": [2262728], "opinion_index": -1, "case_paths": ["/cal/23/0287-01"]}, {"cite": "14 Rich., 266", "category": "reporters:state", "reporter": "Rich.", "weight": 2, "opinion_index": -1}, {"cite": "40 S. C., 132", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 33", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 503", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415981], "opinion_index": -1, "case_paths": ["/sc/62/0503-01"]}, {"cite": "40 S. C., 114", "category": "reporters:state", "reporter": "S.C.", "case_ids"