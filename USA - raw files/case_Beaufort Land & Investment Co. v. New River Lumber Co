{"id": 1931588, "name": "BEAUFORT LAND AND INVESTMENT CO. v. NEW RIVER LUMBER CO.", "name_abbreviation": "Beaufort Land & Investment Co. v. New River Lumber Co.", "decision_date": "1910-07-18", "docket_number": "7630", "first_page": "358", "last_page": "367", "citations": [{"type": "official", "cite": "86 S.C. 358"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "80 S. C., 310", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1921059], "opinion_index": -1, "case_paths": ["/sc/80/0310-01"]}, {"cite": "81 S. C., 20", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1922952], "opinion_index": -1, "case_paths": ["/sc/81/0020-01"]}, {"cite": "2 Mills, 98", "category": "reporters:state", "reporter": "Mills Surr.", "opinion_index": -1}, {"cite": "3 Strob., 127", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8486252], "opinion_index": -1, "case_paths": ["/scl/34/0127-01"]}, {"cite": "63 S. C., 220", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 129", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915529], "opinion_index": -1, "case_paths": ["/sc/77/0129-01"]}, {"cite": "81 S. C., 453", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1922950], "opinion_index": -1, "case_paths": ["/sc/81/0453-01"]}, {"cite": "1 Rich., 140", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "3 Rich., 82", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "79 S. C., 442", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "67 S. C., 18", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4419139], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/67/0018-01"]}, {"cite": "80 S. C., 380", "category": "reporters