{"id": 1926333, "name": "GREENVILLE-CAROLINA POWER CO. v. UNITED STATES FIDELITY AND GUARANTY CO.", "name_abbreviation": "Greenville-Carolina Power Co. v. United States Fidelity & Guaranty Co.", "decision_date": "1909-06-18", "docket_number": "7226", "first_page": "90", "last_page": "102", "citations": [{"type": "official", "cite": "83 S.C. 90"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "68 S. W., 971", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "72 N. E., 317", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "106 U. S., 388", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "10 S. C, 122", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715521], "opinion_index": -1, "case_paths": ["/sc/10/0122-01"]}, {"cite": "71 C. C. A.,' 655", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "21 C. C. A., 5", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "5 L. R. A., 270", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "66 N. W., 528", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "34 C. C. A., 164", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "17 C. C. A., 56", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "19 C. C. A., 264", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "11 C. C. A., 96", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "26 C. C. A., 146", "category": "reporters:federal", "reporter": "C.C.A.", "opinion_index": -1}, {"cite": "19 C. C. A., 381", "category": "