{"id": 4420995, "name": "FALES & JENKS MCH. CO. v. BROWNING", "name_abbreviation": "Fales & Jenks Mch. Co. v. Browning", "decision_date": "1903-12-08", "docket_number": "", "first_page": "13", "last_page": "26", "citations": [{"type": "official", "cite": "68 S.C. 13"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "10 How., 461", "category": "reporters:scotus_early", "reporter": "How.", "case_ids": [3358201], "opinion_index": -1, "case_paths": ["/us/51/0461-01"]}, {"cite": "3 Brev., 186", "category": "reporters:state", "reporter": "Brev.", "opinion_index": -1}, {"cite": "10 Rich., 543", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486642], "opinion_index": -1, "case_paths": ["/scl/44/0543-01"]}, {"cite": "1 Rich., 285", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "46 S. C., 203", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348666], "opinion_index": -1, "case_paths": ["/sc/46/0203-01"]}, {"cite": "5 S. C., 340", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Strob. Eq., 64", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "10 SC., 200", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Rich., 121", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486356], "opinion_index": -1, "case_paths": ["/scl/37/0121-01"]}, {"cite": "48 S. C., 310", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 81", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4401145], "opinion_index": -1, "case_paths": ["/sc/41/0081-01"]}, {"cite": "63 S. C., 567", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 S. C., 330", "category": "reporters:state", "re