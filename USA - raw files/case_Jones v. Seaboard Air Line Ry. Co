{"id": 4419505, "name": "JONES v. SEABOARD AIR LINE RY. CO.", "name_abbreviation": "Jones v. Seaboard Air Line Ry. Co.", "decision_date": "1903-07-21", "docket_number": "", "first_page": "181", "last_page": "202", "citations": [{"type": "official", "cite": "67 S.C. 181"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "67 Miss., 28", "category": "reporters:state", "reporter": "Miss.", "opinion_index": -1}, {"cite": "28 S. C., 23", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4389439], "opinion_index": -1, "case_paths": ["/sc/28/0023-01"]}, {"cite": "62 S. C., 281", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415864], "opinion_index": -1, "case_paths": ["/sc/62/0281-01"]}, {"cite": "59 S. C., 311", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415416], "opinion_index": -1, "case_paths": ["/sc/59/0311-01"]}, {"cite": "32 S. C., 129", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "78 Tex., 279", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2221190], "opinion_index": -1, "case_paths": ["/tex/78/0279-01"]}, {"cite": "63 S- C., 120", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "86 N. Y., 140", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [546212], "opinion_index": -1, "case_paths": ["/ny/86/0140-01"]}, {"cite": "62 S. C., 25", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4416159], "pin_cites": [{"page": "62"}], "opinion_index": -1, "case_paths": ["/sc/62/0025-01"]}, {"cite": "39 S. C., 472", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364824], "opinion_index": -1, "case_paths": ["/sc/39/0472-01"]}, {"cite": "61 S. C., 552", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "63 S. C., 568", "c