{"id": 8715714, "name": "FARLEY v. THE CHARLESTON BASKET AND VENEER CO.", "name_abbreviation": "Farley v. Charleston Basket & Veneer Co.", "decision_date": "1897-12-04", "docket_number": "", "first_page": "222", "last_page": "244", "citations": [{"type": "official", "cite": "51 S.C. 222"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "139 U. S., 559", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "144 U. S., 429", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "38 S. C., 282", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4398283], "opinion_index": -1, "case_paths": ["/sc/38/0282-01"]}, {"cite": "24 S. C., 370", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C., 29", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C., 452", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 Rich., 201", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486127], "opinion_index": -1, "case_paths": ["/scl/49/0201-01"]}, {"cite": "8 Rich., 127", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "21 S.C.,. 495", "category": "reporters:federal", "reporter": "S. Ct.", "case_ids": [2343734], "opinion_index": -1, "case_paths": ["/sc/21/0495-01"]}, {"cite": "150 U. S., 359", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "8 Allen, 441", "category": "reporters:state", "reporter": "Allen", "case_ids": [2120358], "weight": 2, "opinion_index": -1, "case_paths": ["/mass/90/0441-01"]}, {"cite": "18 S. C., 281", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "24 S. C., 592", "category": "reporters:state", "reporter"