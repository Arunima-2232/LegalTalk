{"id": 4408902, "name": "STATE v. CHERAW AND DARLINGTON R. R.", "name_abbreviation": "State v. Cheraw & Darlington R. R.", "decision_date": "1899-03-10", "docket_number": "", "first_page": "564", "last_page": "579", "citations": [{"type": "official", "cite": "54 S.C. 564"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "35 S. C, 309", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 How., 272", "category": "reporters:scotus_early", "reporter": "How.", "opinion_index": -1}, {"cite": "5 Rich., 115", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "2 Strob., 563", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "1 Brev., 491", "category": "reporters:state", "reporter": "Brev.", "opinion_index": -1}, {"cite": "1 Bay., 390", "category": "reporters:state", "reporter": "Bay", "opinion_index": -1}, {"cite": "19 Wall., 229", "category": "reporters:scotus_early", "reporter": "Wall.,", "opinion_index": -1}, {"cite": "13 Pet., 486", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [3338433], "opinion_index": -1, "case_paths": ["/us/38/0486-01"]}, {"cite": "42 S. C., 231", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 Wall., 673", "category": "reporters:scotus_early", "reporter": "Wall.,", "opinion_index": -1}, {"cite": "16 S. C., 35", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C, 592", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "11 L. R. A., 817", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "19 L. R. A., 485", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "111 U. S., 701", "category": "reporters:federal"