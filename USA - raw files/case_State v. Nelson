{"id": 1935191, "name": "STATE v. NELSON", "name_abbreviation": "State v. Nelson", "decision_date": "1911-03-11", "docket_number": "7818", "first_page": "125", "last_page": "125", "citations": [{"type": "official", "cite": "88 S.C. 125"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "54 S. C. 163", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408954], "opinion_index": -1, "case_paths": ["/sc/54/0163-01"]}, {"cite": "15 S. C. 414", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716415], "opinion_index": -1, "case_paths": ["/sc/15/0414-01"]}, {"cite": "31 S. E. 866", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "54 S. C. 162", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409104], "opinion_index": 0, "case_paths": ["/sc/54/0162-01"]}, {"cite": "15 S. C. 414", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716415], "weight": 2, "opinion_index": 0, "case_paths": ["/sc/15/0414-01"]}], "analysis": {"cardinality": 133, "char_count": 1542, "ocr_confidence": 0.522, "pagerank": {"raw": 5.8591662004228935e-08, "percentile": 0.3636246746431935}, "sha256": "99c0a53fd329822c2c2270508cac235e746e54fe136074274fa5f1e3900a9e78", "simhash": "1:db61d632ca25721e", "word_count": 268}, "last_updated": "2024-02-27T22:01:30.399981+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["STATE v. NELSON."], "opinions": [{"text": "The opinion of the Court was delivered by\nMr. Justice Hydrick.\nWhere there is any testimony tending to show that a defendant, on trial for crime, was at the time of the alleged offense, under the age of fourteen years, it is error to refuse to charge that one under founteen years of age is presumed to be incapable of committing crime, and the State must remove such presumption. State v. Toney, 15 S. C. 414; State v. Coleman, 54 S. C. 162, 31 S. E. 866. This does not mean that there must be direct and positive evidence of the fact of capacity independent and outside of the facts and circumstances of the transaction involved. But the question of capacity should be submitted to the jury under all the facts and circumstances in evidence. State v. Toney, supra.\nReversed.", "type": "majority", "author": "Mr. Justice Hydrick."}], "attorneys": ["Mr. L. D. Jennings, for appellant,", "Solicitor P. H. Stoll, contra."], "corrections": "", "head_matter": "7818\nSTATE v. NELSON.\nCrime \u2014 Presumption\u2014Capacity.\u2014Where there is any testimony tending to show a defendant charged with crime was under fourteen years of age when the alleged orime was committed, the trial Judge should instruct the jury that one under fourteen years of age is presumed to be incapable of committing crime and the State must remove such presumption. Capacity may be inferred from the facts and circumstances of the case.\nBefore W. C. Davis, Special Judge, Sumter, April, 1910.\nReversed.\nIndictment against Thomas Nelson for housebreaking and larceny. Defendant appeals.\nMr. L. D. Jennings, for appellant,\ncites: As to capacity to commit crime: 15 S. C. 414; 54 S. C. 163; 16 En'cy. 313; 22 Cyc. 623.\nSolicitor P. H. Stoll, contra.\nMarch 11, 1911."}, "file_name": "0125-01", "first_page_order": 139, "last_page_order": 139}