{"id": 4429470, "name": "NICKLES v. SEABOARD AIR LINE RY.", "name_abbreviation": "Nickles v. Seaboard Air Line Ry.", "decision_date": "1906-04-12", "docket_number": "", "first_page": "102", "last_page": "144", "citations": [{"type": "official", "cite": "74 S.C. 102"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "20 Ky. L. R., 1021", "category": "reporters:state", "reporter": "Ky. L. Rptr.", "opinion_index": -1}, {"cite": "155 U. S., 117", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3580573], "opinion_index": -1, "case_paths": ["/us/155/0117-01"]}, {"cite": "44 Neb., 191", "category": "reporters:state", "reporter": "Neb.", "opinion_index": -1}, {"cite": "54 S. C., 234", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409334], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/54/0234-01"]}, {"cite": "55 S. C., 389", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409858], "opinion_index": -1, "case_paths": ["/sc/55/0389-01"]}, {"cite": "9 Rich., 84", "category": "reporters:state", "reporter": "Rich.", "case_ids": [2516040], "opinion_index": -1, "case_paths": ["/scl/43/0084-01"]}, {"cite": "61 S. C., 489", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "35 S. C., 493", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396188], "opinion_index": -1, "case_paths": ["/sc/35/0493-01"]}, {"cite": "22 S. C., 484", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4381721], "opinion_index": -1, "case_paths": ["/sc/22/0484-01"]}, {"cite": "34 S. C., 311", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4394551], "opinion_index": -1, "case_paths": ["/sc/34/0311-01"]}, {"cite": "52 S. C., 344", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 303", "cat