{"id": 4418389, "name": "MOORE v. SCOTT", "name_abbreviation": "Moore v. Scott", "decision_date": "1903-05-18", "docket_number": "", "first_page": "283", "last_page": "300", "citations": [{"type": "official", "cite": "66 S.C. 283"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "12 L. R. A., 856", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "10 S. C, 317", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716292], "opinion_index": -1, "case_paths": ["/sc/10/0317-01"]}, {"cite": "18 S. C., 355", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Wall., 175", "category": "reporters:scotus_early", "reporter": "Wall.,", "case_ids": [3472079], "opinion_index": -1, "case_paths": ["/us/68/0175-01"]}, {"cite": "21 S. C., 527", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Rich. Eq., 490", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "3 S. C., 497", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S. C., 515", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "38 S. C., 198", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 192", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 S. C., 202", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 S. C., 155", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Rich. Eq., 491", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "30 S. C., 197", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Rich. Eq., 53", "category": "reporters:stat