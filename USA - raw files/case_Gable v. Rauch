{"id": 4407774, "name": "GABLE v. RAUCH", "name_abbreviation": "Gable v. Rauch", "decision_date": "1897-07-14", "docket_number": "", "first_page": "95", "last_page": "110", "citations": [{"type": "official", "cite": "50 S.C. 95"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "10 Rich., 200", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "14 S. C., 474", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C., 21", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364805], "opinion_index": -1, "case_paths": ["/sc/39/0021-01"]}, {"cite": "3 Strob., 44", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8486061], "opinion_index": -1, "case_paths": ["/scl/34/0044-01"]}, {"cite": "8 Rich., 142", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "2 Strob., 34", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "43 S. C., 151", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 42", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Strob., 297", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8486699], "opinion_index": -1, "case_paths": ["/scl/34/0297-01"]}, {"cite": "5 Rich., 212", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8483666], "opinion_index": -1, "case_paths": ["/scl/39/0212-01"]}, {"cite": "37 S. C., 348", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396899], "opinion_index": -1, "case_paths": ["/sc/37/0348-01"]}, {"cite": "1 Mill., 338", "category": "reporters:state", "reporter": "Mill", "opinion_index": -1}, {"cite": "8 Rich., 135", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8484752], "opinion