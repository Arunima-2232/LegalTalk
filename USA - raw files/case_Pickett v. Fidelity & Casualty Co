{"id": 8716173, "name": "PICKETT, RECEIVER, v. FIDELITY AND CASUALTY CO.", "name_abbreviation": "Pickett v. Fidelity & Casualty Co.", "decision_date": "1901-04-20", "docket_number": "", "first_page": "477", "last_page": "492", "citations": [{"type": "official", "cite": "60 S.C. 477"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "353 J 15", "category": "reporters:state", "reporter": "Johns.", "opinion_index": -1}, {"cite": "1 Hill, 145", "category": "reporters:state", "reporter": "Hill,", "case_ids": [8483617], "opinion_index": -1, "case_paths": ["/scl/19/0145-01"]}, {"cite": "22 Mass., 380", "category": "reporters:state", "reporter": "Mass.", "opinion_index": -1}, {"cite": "103 N. Y., 527", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2204992], "opinion_index": -1, "case_paths": ["/ny/103/0527-01"]}, {"cite": "78 Wis., 17", "category": "reporters:state", "reporter": "Wis.", "opinion_index": -1}, {"cite": "2 Bay, 145", "category": "reporters:state", "reporter": "Bay", "case_ids": [8672366], "opinion_index": -1, "case_paths": ["/scl/2/0145-01"]}, {"cite": "5 Watts & S., 440", "category": "reporters:state", "reporter": "Watts & Serg.", "case_ids": [478615], "opinion_index": -1, "case_paths": ["/watts-serg/5/0440-01"]}, {"cite": "8 Watts, 157", "category": "reporters:state", "reporter": "Watts", "case_ids": [1848452], "opinion_index": -1, "case_paths": ["/watts/8/0157-01"]}, {"cite": "9 Pa. St., 366", "category": "reporters:state", "reporter": "Pa.", "case_ids": [960784], "opinion_index": -1, "case_paths": ["/pa/9/0366-01"]}, {"cite": "8 Wend., 452", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2147301], "opinion_index": -1, "case_paths": ["/wend/8/0452-01"]}, {"cite": "3 Den., 321", "category": "reporters:state", "reporter": "Denio", "case_ids": [2187518], "opinion_index": -1, "case_p