{"id": 1917221, "name": "AETNA FIRE INS. CO. v. JONES, COMPTROLLER", "name_abbreviation": "Aetna Fire Ins. v. Jones", "decision_date": "1907-11-06", "docket_number": "6702", "first_page": "445", "last_page": "456", "citations": [{"type": "official", "cite": "78 S.C. 445"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "51 N. Y., 949", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "93 N. Y., 313", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [552951], "opinion_index": -1, "case_paths": ["/ny/93/0313-01"]}, {"cite": "23 So., 843", "category": "reporters:state_regional", "reporter": "So.", "opinion_index": -1}, {"cite": "92 N. Y., 311", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2190149], "opinion_index": -1, "case_paths": ["/ny/92/0311-01"]}, {"cite": "74 S. C., 449", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "71 S. C., 487", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 415", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 S. C., 135", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S. C., 427", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383479], "opinion_index": -1, "case_paths": ["/sc/23/0427-01"]}, {"cite": "11 S. C., 309", "category": "reporters:state", "reporter": "S.C.", "case_ids": [359568], "opinion_index": -1, "case_paths": ["/sc/11/0309-01"]}, {"cite": "21 S. C., 476", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "202 U. S., 246", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3646470], "opinion_index": -1, "case_paths": ["/us/202/0246-01"]}, {"cite": "177 U. S., 28", "category": "reporters:federal", "r