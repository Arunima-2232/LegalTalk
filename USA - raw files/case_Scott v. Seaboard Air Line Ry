{"id": 4419704, "name": "SCOTT v. SEABOARD AIR LINE RY.", "name_abbreviation": "Scott v. Seaboard Air Line Ry.", "decision_date": "1903-07-15", "docket_number": "", "first_page": "136", "last_page": "147", "citations": [{"type": "official", "cite": "67 S.C. 136"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "25 S. C., 192", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "100 Ala., 451", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3287878], "opinion_index": -1, "case_paths": ["/ala/100/0451-01"]}, {"cite": "104 Ala., 241", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3219838], "opinion_index": -1, "case_paths": ["/ala/104/0241-01"]}, {"cite": "79 Ky., 164", "category": "reporters:state", "reporter": "Ky.", "opinion_index": -1}, {"cite": "12 S. C., 8", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C., 28", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 S. C., 36", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 S. C., 229", "category": "reporters:state", "reporter": "S.C.", "case_ids": [375417], "opinion_index": -1, "case_paths": ["/sc/65/0229-01"]}, {"cite": "61 S. C., 345", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373611], "pin_cites": [{"page": "482"}], "opinion_index": -1, "case_paths": ["/sc/61/0345-01"]}, {"cite": "60 S. C., 170", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 311", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415416], "opinion_index": -1, "case_paths": ["/sc/59/0311-01"]}, {"cite": "58 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 95", "category": "reporters:sta