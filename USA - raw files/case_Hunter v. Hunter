{"id": 2350407, "name": "HUNTER v. HUNTER", "name_abbreviation": "Hunter v. Hunter", "decision_date": "1902-03-11", "docket_number": "", "first_page": "78", "last_page": "95", "citations": [{"type": "official", "cite": "63 S.C. 78"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "16 S. C., 198", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377430], "opinion_index": -1, "case_paths": ["/sc/16/0198-01"]}, {"cite": "3 Rich., 182", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486517], "opinion_index": -1, "case_paths": ["/scl/37/0182-01"]}, {"cite": "119 Mass., 79", "category": "reporters:state", "reporter": "Mass.", "case_ids": [737034], "opinion_index": -1, "case_paths": ["/mass/119/0079-01"]}, {"cite": "146 Mass., 20", "category": "reporters:state", "reporter": "Mass.", "case_ids": [784138], "opinion_index": -1, "case_paths": ["/mass/146/0020-01"]}, {"cite": "8 Johns., 189", "category": "reporters:state", "reporter": "Johns.", "case_ids": [2134511], "opinion_index": -1, "case_paths": ["/johns/8/0189-01"]}, {"cite": "23 S. C., 586", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 351", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 S. C., 198", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Story, 478", "category": "reporters:federal", "reporter": "Story", "case_ids": [6104080], "opinion_index": -1, "case_paths": ["/f-cas/4/0127-01"]}, {"cite": "40 Cal., 221", "category": "reporters:state", "reporter": "Cal.", "case_ids": [8712304], "opinion_index": -1, "case_paths": ["/cal/40/0221-01"]}, {"cite": "34 S. C., 330", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4394844], "opinion_index": -1, "case_paths": ["/sc/34/0330-01"]}, {"cite": "51 S. C., 57"