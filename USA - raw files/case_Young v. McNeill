{"id": 1917268, "name": "YOUNG v. McNEILL", "name_abbreviation": "Young v. McNeill", "decision_date": "1907-09-11", "docket_number": "6651", "first_page": "143", "last_page": "156", "citations": [{"type": "official", "cite": "78 S.C. 143"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "6 Wall, 715", "category": "reporters:scotus_early", "reporter": "Wall,", "opinion_index": -1}, {"cite": "81 N. C., 116", "category": "reporters:state", "reporter": "N.C.", "opinion_index": -1}, {"cite": "109 U. S., 608", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8167], "opinion_index": -1, "case_paths": ["/us/109/0608-01"]}, {"cite": "71 S. C., 518", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4424957], "opinion_index": -1, "case_paths": ["/sc/71/0518-01"]}, {"cite": "5 Rich., 541", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8485251], "pin_cites": [{"page": "525"}], "opinion_index": -1, "case_paths": ["/scl/39/0541-01"]}, {"cite": "3 Am. Dec., 61", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "22 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4382034], "opinion_index": -1, "case_paths": ["/sc/22/0323-01"]}, {"cite": "54 S. C., 395", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 507", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 Md., 129", "category": "reporters:state", "reporter": "Md.", "case_ids": [1768410], "opinion_index": -1, "case_paths": ["/md/36/0129-01"]}, {"cite": "32 Gratt., 315", "category": "reporters:state", "reporter": "Gratt.", "opinion_index": -1}, {"cite": "31 S. C., 13", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392941], "opinion_index": -1, "case_paths": ["/sc/31/0013-01"]},