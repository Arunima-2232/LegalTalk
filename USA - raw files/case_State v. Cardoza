{"id": 359602, "name": "THE STATE v. F L. CARDOZA", "name_abbreviation": "State v. Cardoza", "decision_date": "1878-11-29", "docket_number": "CASE No. 660", "first_page": "195", "last_page": "262", "citations": [{"type": "official", "cite": "11 S.C. 195"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "3 Strob. 519", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "3 Strob. 517", "category": "reporters:state", "reporter": "Strob.", "weight": 2, "opinion_index": -1}, {"cite": "1 Bail. 300", "category": "reporters:state", "reporter": "Bail.", "case_ids": [8484562], "opinion_index": -1, "case_paths": ["/scl/17/0300-01"]}, {"cite": "2 Tread. 776", "category": "reporters:state", "reporter": "Tread.", "case_ids": [8483821], "opinion_index": -1, "case_paths": ["/scl/7/0776-01"]}, {"cite": "4 Strob. 266", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8484089], "opinion_index": -1, "case_paths": ["/scl/35/0266-01"]}, {"cite": "4 Wend. 232", "category": "reporters:state", "reporter": "Wend.", "opinion_index": -1}, {"cite": "2 Mill 138", "category": "reporters:state", "reporter": "Mill", "opinion_index": -1}, {"cite": "1 Bay 353", "category": "reporters:state", "reporter": "Bay", "case_ids": [9507204], "opinion_index": -1, "case_paths": ["/scl/1/0353-01"]}, {"cite": "5 Stat. 177", "category": "laws:leg_session", "reporter": "Stat.", "opinion_index": -1}, {"cite": "11 Stat. 154", "category": "laws:leg_session", "reporter": "Stat.", "opinion_index": -1}, {"cite": "10 Rich. 351", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486322], "pin_cites": [{"page": "407"}], "opinion_index": -1, "case_paths": ["/scl/44/0351-01"]}, {"cite": "10 Rich. 549", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "10 Rich. 412", "category": "repor