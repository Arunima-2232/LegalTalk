{"id": 4416022, "name": "LATIMER v. SOVEREIGN CAMP WOODMEN OF THE WORLD", "name_abbreviation": "Latimer v. Sovereign Camp Woodmen of the World", "decision_date": "1901-11-29", "docket_number": "", "first_page": "145", "last_page": "165", "citations": [{"type": "official", "cite": "62 S.C. 145"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "56 N. E., 255", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "139 Mo., 416", "category": "reporters:state", "reporter": "Mo.", "case_ids": [475111], "opinion_index": -1, "case_paths": ["/mo/139/0416-01"]}, {"cite": "79 N. W., 542", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "57 N. W., 202", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "80 N. W., 1020", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "75 la., 345", "category": "reporters:state", "reporter": "Iowa", "opinion_index": -1}, {"cite": "24 Fed., 161", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "24 Atl., 656", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "65 N. Y., 241", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "34 Wis., 289", "category": "reporters:state", "reporter": "Wis.", "opinion_index": -1}, {"cite": "65 N. Y., 233", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "75 la., 346", "category": "reporters:state", "reporter": "Iowa", "case_ids": [2061185], "opinion_index": -1, "case_paths": ["/iowa/75/0346-01"]}, {"cite": "84 Col., 570", "category": "reporters:state", "reporter": "Col.,", "opinion_index": -1}, {"cite": "26 Hun., 604", "category": "reporters:state", "reporter": "Hun.,", "opi