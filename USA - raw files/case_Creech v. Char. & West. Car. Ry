{"id": 4417697, "name": "CREECH v. CHAR. & WEST. CAR. RY.", "name_abbreviation": "Creech v. Char. & West. Car. Ry.", "decision_date": "1903-07-03", "docket_number": "", "first_page": "528", "last_page": "539", "citations": [{"type": "official", "cite": "66 S.C. 528"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "63 N. Y., 556", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [527246], "opinion_index": -1, "case_paths": ["/ny/63/0556-01"]}, {"cite": "56 N. Y., 302", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [519136], "opinion_index": -1, "case_paths": ["/ny/56/0302-01"]}, {"cite": "49 N. Y., 177", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2057458], "opinion_index": -1, "case_paths": ["/ny/49/0177-01"]}, {"cite": "69 N. Y., 196", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "75 Mo., 475", "category": "reporters:state", "reporter": "Mo.", "case_ids": [963540], "opinion_index": -1, "case_paths": ["/mo/75/0475-01"]}, {"cite": "99 Ala., 545", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3250339], "opinion_index": -1, "case_paths": ["/ala/99/0545-01"]}, {"cite": "63 N. W., 1027", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "108 N. C., 34", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8649655], "opinion_index": -1, "case_paths": ["/nc/108/0034-01"]}, {"cite": "91 Ala., 421", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5550945], "weight": 2, "opinion_index": -1, "case_paths": ["/ala/91/0421-01"]}, {"cite": "128 Mo., 661", "category": "reporters:state", "reporter": "Mo.", "case_ids": [780944], "opinion_index": -1, "case_paths": ["/mo/128/0661-01"]}, {"cite": "67 Miss., 604", "category": "reporters:state", "reporter": "Miss.", "opinio