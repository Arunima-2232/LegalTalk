{"id": 1926416, "name": "NEW YORK LIFE INS. CO. v. BRADLEY, TREASURER", "name_abbreviation": "New York Life Ins. v. Bradley", "decision_date": "1909-08-28", "docket_number": "7284", "first_page": "418", "last_page": "432", "citations": [{"type": "official", "cite": "83 S.C. 418"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "49 S. C., 188", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715403], "opinion_index": -1, "case_paths": ["/sc/49/0188-01"]}, {"cite": "60 N. H., 500", "category": "reporters:state", "reporter": "N.H.", "case_ids": [4477682], "opinion_index": -1, "case_paths": ["/nh/60/0500-01"]}, {"cite": "93 la., 119", "category": "reporters:state", "reporter": "Iowa", "case_ids": [8646488], "opinion_index": -1, "case_paths": ["/iowa/93/0119-01"]}, {"cite": "23 R. I., 118", "category": "reporters:state", "reporter": "R.I.", "case_ids": [4844375], "opinion_index": -1, "case_paths": ["/ri/23/0118-01"]}, {"cite": "58 Neb., 245", "category": "reporters:state", "reporter": "Neb.", "case_ids": [5323222], "opinion_index": -1, "case_paths": ["/neb/58/0245-01"]}, {"cite": "140 Mich., 593", "category": "reporters:state", "reporter": "Mich.", "case_ids": [1508006], "opinion_index": -1, "case_paths": ["/mich/140/0593-01"]}, {"cite": "11 Conn., 257", "category": "reporters:state", "reporter": "Conn.", "opinion_index": -1}, {"cite": "43 N.'Y., 107", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2048110], "opinion_index": -1, "case_paths": ["/ny/43/0107-01"]}, {"cite": "5 Denio, 155", "category": "reporters:state", "reporter": "Denio", "opinion_index": -1}, {"cite": "26 Vt., 373", "category": "reporters:state", "reporter": "Vt.", "opinion_index": -1}, {"cite": "43 Vt., 30", "category": "reporters:state", "reporter": "Vt.", "case_ids": [744269], "opinion_index": -1, "case_paths": ["/vt/43/003