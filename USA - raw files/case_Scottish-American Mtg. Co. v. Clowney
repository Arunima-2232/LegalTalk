{"id": 4424578, "name": "SCOTTISH-AMERICAN MTG. CO. v. CLOWNEY", "name_abbreviation": "Scottish-American Mtg. Co. v. Clowney", "decision_date": "1904-11-24", "docket_number": "", "first_page": "229", "last_page": "242", "citations": [{"type": "official", "cite": "70 S.C. 229"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "63 S. C., 78", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350407], "opinion_index": -1, "case_paths": ["/sc/63/0078-01"]}, {"cite": "58 S. C., 178", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4413597], "opinion_index": -1, "case_paths": ["/sc/58/0178-01"]}, {"cite": "29 S. C., 508", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 S. C., 377", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4394438], "opinion_index": -1, "case_paths": ["/sc/34/0377-01"]}, {"cite": "51 S. C., 506", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716773], "opinion_index": -1, "case_paths": ["/sc/51/0506-01"]}, {"cite": "163 Pa. St., 600", "category": "reporters:state", "reporter": "Pa.", "case_ids": [859041], "opinion_index": -1, "case_paths": ["/pa/163/0600-01"]}, {"cite": "66 S. C., 193", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 398", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383941], "opinion_index": -1, "case_paths": ["/sc/24/0398-01"]}, {"cite": "22 S. C., 328", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "20 S. C., 71", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2342008], "opinion_index": -1, "case_paths": ["/sc/20/0071-01"]}, {"cite": "3 Hill, 361", "category": "reporters:state", "reporter": "Hill,", "opinion_index": -1}, {"cite": "5 Rich. Eq., 270", "category": "reporter