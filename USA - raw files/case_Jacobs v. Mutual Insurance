{"id": 378515, "name": "JACOBS v. THE MUTUAL INSURANCE CO. OF GREENVILLE", "name_abbreviation": "Jacobs v. Mutual Insurance", "decision_date": "1898-03-24", "docket_number": "", "first_page": "110", "last_page": "120", "citations": [{"type": "official", "cite": "52 S.C. 110"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "23 S. C., 69", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "152 Mass., 272", "category": "reporters:state", "reporter": "Mass.", "case_ids": [814010], "opinion_index": -1, "case_paths": ["/mass/152/0272-01"]}, {"cite": "166 N. Y., 276", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "6 Gray, 169", "category": "reporters:state", "reporter": "Gray", "case_ids": [1994700], "opinion_index": -1, "case_paths": ["/mass/72/0169-01"]}, {"cite": "42 N. J. Eq., 459", "category": "reporters:state", "reporter": "N.J. Eq.", "case_ids": [8875966], "opinion_index": -1, "case_paths": ["/nj-eq/42/0459-01"]}, {"cite": "14 Gray, 80", "category": "reporters:state", "reporter": "Gray", "opinion_index": -1}, {"cite": "69 Ind., 354", "category": "reporters:state", "reporter": "Ind.", "opinion_index": -1}, {"cite": "97 Ind., 299", "category": "reporters:state", "reporter": "Ind.", "case_ids": [1328886], "opinion_index": -1, "case_paths": ["/ind/97/0299-01"]}, {"cite": "9 Allen, 329", "category": "reporters:state", "reporter": "Allen", "case_ids": [2118888], "opinion_index": -1, "case_paths": ["/mass/91/0329-01"]}, {"cite": "40 Mich., 241", "category": "reporters:state", "reporter": "Mich.", "case_ids": [1328431], "opinion_index": -1, "case_paths": ["/mich/40/0241-01"]}, {"cite": "120 Ind., 554", "category": "reporters:state", "reporter": "Ind.", "case_ids": [1375184], "opinion_index": -1, "case_paths": ["/ind/120/0554-01"]}, {"cite": "81 Me., 373", "catego