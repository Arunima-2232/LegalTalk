{"id": 1917214, "name": "HARBERT v. ATLANTA AND CHARLOTTE AIR LINE RY. CO.", "name_abbreviation": "Harbert v. Atlanta & Charlotte Air Line Ry. Co.", "decision_date": "1907-12-04", "docket_number": "6718", "first_page": "537", "last_page": "551", "citations": [{"type": "official", "cite": "78 S.C. 537"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "75 SC., 390", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2352544], "opinion_index": -1, "case_paths": ["/sc/75/0390-01"]}, {"cite": "73 S. C., 313", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "73 S. C., 411", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "478"}], "opinion_index": -1}, {"cite": "70 S. C., 453", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "69 S. C., 454", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422341], "opinion_index": -1, "case_paths": ["/sc/69/0454-01"]}, {"cite": "64 S. C., 229", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381974], "opinion_index": -1, "case_paths": ["/sc/64/0229-01"]}, {"cite": "62 S. C., 281", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415864], "opinion_index": -1, "case_paths": ["/sc/62/0281-01"]}, {"cite": "54 Col., 145", "category": "reporters:state", "reporter": "Col.,", "opinion_index": -1}, {"cite": "50 Fed., 77", "category": "reporters:federal", "reporter": "F.", "case_ids": [6715373], "opinion_index": -1, "case_paths": ["/f/50/0077-01"]}, {"cite": "58 Fed. R., 205", "category": "reporters:federal", "reporter": "F.", "case_ids": [6732307], "opinion_index": -1, "case_paths": ["/f/58/0205-01"]}, {"cite": "70 S. C., 281", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C., 355", "category": "reporters:stat