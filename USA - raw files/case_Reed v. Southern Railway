{"id": 2352500, "name": "REED v. SOUTHERN RAILWAY-CAROLINA DIVISION", "name_abbreviation": "Reed v. Southern Railway", "decision_date": "1906-09-12", "docket_number": "", "first_page": "162", "last_page": "173", "citations": [{"type": "official", "cite": "75 S.C. 162"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "70 S. C., 76", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4410383], "opinion_index": -1, "case_paths": ["/sc/55/0001-01"]}, {"cite": "58 S. C., 70", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4413803], "opinion_index": -1, "case_paths": ["/sc/58/0070-01"]}, {"cite": "70 S. C., 211", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4424780], "pin_cites": [{"page": "470"}], "opinion_index": -1, "case_paths": ["/sc/70/0211-01"]}, {"cite": "67 S. C., 146", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "69 S. C., 445", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422470], "opinion_index": -1, "case_paths": ["/sc/69/0445-01"]}, {"cite": "66 L. R. A., 75", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "41 S. C., 421", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "28 S. C., 404", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "25 S. C., 216", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716062], "opinion_index": -1, "case_paths": ["/sc/25/0216-01"]}, {"cite": "61 S. C., 468", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373626], "opinion_index": -1, "case_paths": ["/sc/61/0468-01"]}, {"cite": "60 S. C., 9", "category": "reporters:state", "reporter": "S.C.", "case_