{"id": 2350647, "name": "KIRBY v. SOUTHERN RY.", "name_abbreviation": "Kirby v. Southern Ry.", "decision_date": "1902-04-15", "docket_number": "", "first_page": "494", "last_page": "525", "citations": [{"type": "official", "cite": "63 S.C. 494"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "58 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 91", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503362], "opinion_index": -1, "case_paths": ["/sc/56/0091-01"]}, {"cite": "34 S. C., 450", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 19", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 99", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "484"}], "opinion_index": -1}, {"cite": "95 U. S., 162", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "41 S. C., 8", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4400787], "opinion_index": -1, "case_paths": ["/sc/41/0001-01"]}, {"cite": "47 S. C., 385", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 434", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4414722], "opinion_index": -1, "case_paths": ["/sc/59/0434-01"]}, {"cite": "34 S. C., 299", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "450"}], "opinion_index": -1}, {"cite": "33 S. C., 139", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C., 23", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364845], "opinion_index": -1, "case_paths": ["/sc/39/0023-01"]