{"id": 375443, "name": "YOUNG v. WESTERN UNION TEL. CO.", "name_abbreviation": "Young v. Western Union Tel. Co.", "decision_date": "1903-01-10", "docket_number": "", "first_page": "93", "last_page": "104", "citations": [{"type": "official", "cite": "65 S.C. 93"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "26 S. C., 268", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 335", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412368], "opinion_index": -1, "case_paths": ["/sc/57/0228-01"]}, {"cite": "54 S. C., 498", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409362], "opinion_index": -1, "case_paths": ["/sc/54/0498-01"]}, {"cite": "53 S. C., 214", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415818], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/62/0001-01"]}, {"cite": "26 S. C., 96", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. W., 256", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "11 Col., 335", "category": "reporters:state", "reporter": "Col.,", "opinion_index": -1}, {"cite": "65 N. Y., 165", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "54 Ark., 221", "category": "reporters:state", "reporter": "Ark.", "case_ids": [1320353], "opinion_index": -1, "case_paths": ["/ark/54/0221-01"]}, {"cite": "42 S. C., 368", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "154 U. S-, 1", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3580803], "opinion_index":