opinion_index": -1}, {"cite": "38 N. E., 549", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "15 S. E., 371", "category": "reporters:state_regional", "reporter": "S.E.", "weight": 2, "opinion_index": -1}, {"cite": "3 S. E., 862", "category": "reporters:state_regional", "reporter": "S.E.", "weight": 2, "opinion_index": -1}, {"cite": "49 N. E., 843", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "41 A., 28", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "24 So., 892", "category": "reporters:state_regional", "reporter": "So.", "opinion_index": -1}, {"cite": "18 S. E., 934", "category": "reporters:state_regional", "reporter": "S.E.", "weight": 4, "opinion_index": -1}, {"cite": "54 P., 833", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "41 A., 1007", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "77 N. W., 517", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "51 N. E-, 233", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "51 S. W., 351", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "51 S. C., 237", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 192", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "495"}], "opinion_index": -1}, {"cite": "56 S. C., 95", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 N. Y, 42", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "69 Mo., 305", "category": "reporters:state", "reporter": "Mo.", "case_ids": [453144], "opinion_index": -1, "case_paths": ["/mo/69