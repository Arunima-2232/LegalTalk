{"id": 4417669, "name": "STATE EX REL. SOUTHERN RY. v. EARLE (Two Appeals.)", "name_abbreviation": "State ex rel. Southern Ry. v. Earle", "decision_date": "1903-04-22", "docket_number": "", "first_page": "194", "last_page": "204", "citations": [{"type": "official", "cite": "66 S.C. 194"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "1 S. C., 51", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "261"}], "opinion_index": -1}, {"cite": "2 Strob., 250", "category": "reporters:state", "reporter": "Strob.", "case_ids": [8486522], "opinion_index": -1, "case_paths": ["/scl/33/0250-01"]}, {"cite": "62 S. C., 469", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4416277], "opinion_index": -1, "case_paths": ["/sc/62/0469-01"]}, {"cite": "33 S. C., 61", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Strob., 310", "category": "reporters:state", "reporter": "Strob.", "pin_cites": [{"page": "241"}], "opinion_index": -1}, {"cite": "48 S. C., 584", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "29 S. C., 363", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Bail., 164", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2509205], "opinion_index": -1, "case_paths": ["/scl/18/0164-01"]}, {"cite": "10 S. C., 303", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "30 Ala., 135", "category": "reporters:state", "reporter": "Ala.", "case_ids": [8496947], "opinion_index": -1, "case_paths": ["/ala/30/0135-01"]}, {"cite": "84 Ala., 115", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5574236], "opinion_index": -1, "case_paths": ["/ala/8