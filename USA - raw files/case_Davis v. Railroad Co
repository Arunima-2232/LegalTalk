{"id": 4390989, "name": "Davis v. Railroad Company", "name_abbreviation": "Davis v. Railroad Co.", "decision_date": "1889-03-08", "docket_number": "No. 2378", "first_page": "613", "last_page": "614", "citations": [{"type": "official", "cite": "30 S.C. 613"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 88, "char_count": 776, "ocr_confidence": 0.551, "sha256": "e50ea7873bd8249defb4837a4d532365b4e1a35581d554898024bc2777009d90", "simhash": "1:2d0b25e8f518410e", "word_count": 129}, "last_updated": "2023-07-14T18:07:02.879123+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["Davis v. Railroad Company."], "opinions": [{"text": "Opinion by\nMr. Chibe Justice Simpson,\nAction before a trial justice to recover damages for stock alleged to have been killed by the defendant\u2019s moving train. At the trial, the trial justice was requested to charge \u201cthat if the stock was killed accidentally, and not by reason of negligence on the part of the defendant, then plaintiff cannot recover.\u201d This request was refused. Held, that such refusal was error, and such error as would have entitled plaintiff to a new trial even if clearly contained in other requests which were charged; but such error was not plainly corrected in any other portion of this .charge. Judgment (Kershaw, J.) reversed.", "type": "majority", "author": "Mr. Chibe Justice Simpson,"}], "attorneys": ["Mark Reynolds, for appellant.", "J. 0. James, contra."], "corrections": "", "head_matter": "No. 2378.\nDavis v. Railroad Company.\nNovember Term, 1888.\nMarch 8, 1889.\nMark Reynolds, for appellant.\nJ. 0. James, contra."}, "file_name": "0613-02", "first_page_order": 623, "last_page_order": 624}