{"id": 375479, "name": "DYSON v. JONES", "name_abbreviation": "Dyson v. Jones", "decision_date": "1903-03-06", "docket_number": "", "first_page": "308", "last_page": "320", "citations": [{"type": "official", "cite": "65 S.C. 308"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "14 S. C., 341", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4375674], "opinion_index": -1, "case_paths": ["/sc/14/0341-01"]}, {"cite": "2 S. C., 248", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716118], "opinion_index": -1, "case_paths": ["/sc/2/0248-01"]}, {"cite": "10 S. C., 133", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715556], "opinion_index": -1, "case_paths": ["/sc/10/0133-01"]}, {"cite": "37 S. C., 161", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4397668], "opinion_index": -1, "case_paths": ["/sc/37/0161-01"]}, {"cite": "2 Hill Eq., 257", "category": "reporters:state", "reporter": "Hill Eq.", "case_ids": [1833154], "opinion_index": -1, "case_paths": ["/sc-eq/11/0200-01"]}, {"cite": "17 S. C., 42", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "10 S. C., 347", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "14 S. C., 473", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 S. C., 156", "category": "reporters:state", "reporter": "S.C.", "case_ids": [351642], "opinion_index": -1, "case_paths": ["/sc/4/0156-01"]}, {"cite": "4 Rich. Eq., 60", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713405], "opinion_index": -1, "case_paths": ["/sc-eq/25/0060-01"]}, {"cite": "4 Strob. Eq., 96", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "13 S. C., 21", "category": "reporters:state", "reporter": "S.C."