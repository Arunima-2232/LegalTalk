{"id": 4421148, "name": "STATE V. McDANIEL", "name_abbreviation": "State V. McDaniel", "decision_date": "1904-03-25", "docket_number": "", "first_page": "304", "last_page": "318", "citations": [{"type": "official", "cite": "68 S.C. 304"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "59 S. C., 229", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415011], "opinion_index": -1, "case_paths": ["/sc/59/0229-01"]}, {"cite": "29 S. C., 4", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4389838], "opinion_index": -1, "case_paths": ["/sc/29/0004-01"]}, {"cite": "33 S. C., 117", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4393447], "opinion_index": -1, "case_paths": ["/sc/33/0117-01"]}, {"cite": "61 S. C., 556", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373607], "opinion_index": -1, "case_paths": ["/sc/61/0556-01"]}, {"cite": "63 S. C., 219", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350257], "pin_cites": [{"page": "391"}], "opinion_index": -1, "case_paths": ["/sc/63/0219-01"]}, {"cite": "54 S. C., 240", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409035], "opinion_index": -1, "case_paths": ["/sc/54/0240-01"]}, {"cite": "29 S. C., 201", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4390646], "opinion_index": -1, "case_paths": ["/sc/29/0201-01"]}, {"cite": "13 S. C., 462", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 495", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "32 S. C., 40", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Rich., 176", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8857913], "opinion_index": -1, "case_paths": ["/scl/31/0176-01"]}, {"c