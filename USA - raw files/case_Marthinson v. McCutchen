{"id": 1928073, "name": "MARTHINSON v. McCUTCHEN", "name_abbreviation": "Marthinson v. McCutchen", "decision_date": "1909-11-23", "docket_number": "7381", "first_page": "256", "last_page": "267", "citations": [{"type": "official", "cite": "84 S.C. 256"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "78 S. C., 134", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1917227], "opinion_index": -1, "case_paths": ["/sc/78/0134-01"]}, {"cite": "33 Am. Dec., 548", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "28 Am. Dec., 413", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "1 Mill, 411", "category": "reporters:state", "reporter": "Mill", "case_ids": [2547777], "opinion_index": -1, "case_paths": ["/scl/8/0411-01"]}, {"cite": "3 Brev., 245", "category": "reporters:state", "reporter": "Brev.", "case_ids": [8858877], "opinion_index": -1, "case_paths": ["/scl/5/0245-01"]}, {"cite": "1 Strob., 522", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "57 S. C., 418", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "138 U. S., 514", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3549376], "opinion_index": -1, "case_paths": ["/us/138/0514-01"]}, {"cite": "44 S. C., 22", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346885], "opinion_index": -1, "case_paths": ["/sc/44/0022-01"]}, {"cite": "62 S. C., 46", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Strob., 400", "category": "reporters:state", "reporter": "Strob.", "opinion_index": -1}, {"cite": "2 Mill, 371", "category": "reporters:state", "reporter": "Mill", "case_ids": [2552434], "opinion_index": -1, "case_paths": ["/scl/9/0371-01"]}, {"cite": "5