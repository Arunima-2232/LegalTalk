{"id": 4410495, "name": "NEWTON v. WOODLEY", "name_abbreviation": "Newton v. Woodley", "decision_date": "1899-05-09", "docket_number": "", "first_page": "132", "last_page": "152", "citations": [{"type": "official", "cite": "55 S.C. 132"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "50 S. C., 19", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "191"}], "opinion_index": -1}, {"cite": "47 S. C., 405", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 Neb., 815", "category": "reporters:state", "reporter": "Neb.", "case_ids": [4413979], "opinion_index": -1, "case_paths": ["/neb/24/0815-01"]}, {"cite": "7 Rob., 939", "category": "reporters:state", "reporter": "Rob.,", "opinion_index": -1}, {"cite": "53 S. C., 39", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "29 L. R. A., 761", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "3 Pet., 6", "category": "reporters:scotus_early", "reporter": "Pet.", "opinion_index": -1}, {"cite": "1 Wall., 384", "category": "reporters:scotus_early", "reporter": "Wall.,", "case_ids": [3470838], "opinion_index": -1, "case_paths": ["/us/68/0384-01"]}, {"cite": "141 U. S., 384", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3555626], "opinion_index": -1, "case_paths": ["/us/141/0384-01"]}, {"cite": "6 N. J. Eq., 625", "category": "reporters:state", "reporter": "N.J. Eq.", "case_ids": [789552], "opinion_index": -1, "case_paths": ["/nj-eq/6/0625-01"]}, {"cite": "30 Hun., 201", "category": "reporters:state", "reporter": "Hun.,", "opinion_index": -1}, {"cite": "8 Blackf., 67", "category": "reporters:state", "reporter": "Blackf.", "case_ids": [1380929], "opinion_index": -1, "case_paths": ["/blackf/8/0067-01"]}, {"cite": "53 S. C., 32", "category": "r