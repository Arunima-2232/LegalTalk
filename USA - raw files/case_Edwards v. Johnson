{"id": 8715119, "name": "EDWARDS v. JOHNSON", "name_abbreviation": "Edwards v. Johnson", "decision_date": "1911-11-20", "docket_number": "8041", "first_page": "90", "last_page": "106", "citations": [{"type": "official", "cite": "90 S.C. 90"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "22 N. E. 346", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "71 N. W. 635", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "78 N. W. 604", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "155 U. S. 13", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3581023], "opinion_index": -1, "case_paths": ["/us/155/0013-01"]}, {"cite": "101 N. W. 363", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "71 N. E. 1111", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "61 L. R. A. 176", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "167 Fed. R. 631", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "7 Pac. 286", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "6 Pac. 803", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "81 Pac. 356", "category": "reporters:state_regional", "reporter": "P.", "case_ids": [2236208], "opinion_index": -1, "case_paths": ["/or/46/0465-01"]}, {"cite": "7 N. W. 393", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "33 S. E. 382", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "1 S. W. 560", "category": "reporters:state_regional", "reporter": "S.W.", "opinion