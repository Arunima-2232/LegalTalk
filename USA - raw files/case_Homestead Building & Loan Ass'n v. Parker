{"id": 9503179, "name": "EX PARTE CAROLINA NATIONAL BANK IN RE HOMESTEAD BUILDING AND LOAN ASSOCIATION v. PARKER", "name_abbreviation": "Homestead Building & Loan Ass'n v. Parker", "decision_date": "1899-07-28", "docket_number": "", "first_page": "12", "last_page": "28", "citations": [{"type": "official", "cite": "56 S.C. 12"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "54 Md., 636", "category": "reporters:state", "reporter": "Md.", "case_ids": [1832500], "opinion_index": -1, "case_paths": ["/md/54/0636-01"]}, {"cite": "21 S. C. 491", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 N. C., 502", "category": "reporters:state", "reporter": "N.C.", "opinion_index": -1}, {"cite": "36 N. J., 632", "category": "reporters:state", "reporter": "N.J.", "opinion_index": -1}, {"cite": "77 N. C, 72", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8681799], "opinion_index": -1, "case_paths": ["/nc/77/0072-01"]}, {"cite": "63 N. C., 502", "category": "reporters:state", "reporter": "N.C.", "case_ids": [11277886], "opinion_index": -1, "case_paths": ["/nc/63/0502-01"]}, {"cite": "84 N. C, 616", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8698311], "weight": 2, "opinion_index": -1, "case_paths": ["/nc/84/0616-01"]}, {"cite": "30 Md., 280", "category": "reporters:state", "reporter": "Md.", "opinion_index": -1}, {"cite": "52 S. C., 305", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378522], "opinion_index": -1, "case_paths": ["/sc/52/0305-01"]}, {"cite": "27 S. C, 368", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4386981], "opinion_index": -1, "case_paths": ["/sc/27/0368-01"]}, {"cite": "26 S. C, 581", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4386086], "opinion_index": -1, "case_paths": ["/sc/26/0581-01"]