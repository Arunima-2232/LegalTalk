{"id": 4421673, "name": "RHODES v. SOUTHERN RY.", "name_abbreviation": "Rhodes v. Southern Ry.", "decision_date": "1904-04-20", "docket_number": "", "first_page": "494", "last_page": "506", "citations": [{"type": "official", "cite": "68 S.C. 494"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "61 S. C., 480", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "32 S. C., 301", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 413", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Hill, 379", "category": "reporters:state", "reporter": "Hill,", "case_ids": [11254179], "opinion_index": -1, "case_paths": ["/scl/20/0379-01"]}, {"cite": "34 S. C., 17", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412799], "opinion_index": -1, "case_paths": ["/sc/58/0001-01"]}, {"cite": "37 S. C., 419", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "174"}], "opinion_index": -1}, {"cite": "48 S. C., 15", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "50 S. C., 403", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4407843], "opinion_index": -1, "case_paths": ["/sc/50/0403-01"]}, {"cite": "63 S. C., 559", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350422], "opinion_index": -1, "case_paths": ["/sc/63/0559-01"]}, {"cite": "17 Wash., 582", "category": "reporters:state", "reporter": "Wash.,", "case_ids": [5113321], "opinion_index": -1, "case_paths": ["/wash/17/0582-01"]}, {"cite": "84 Ind., 50", "category": "reporters:state", "reporter": "Ind.", "case_ids": [1317049], "opinion_index": -1, "case_paths": ["/ind/84/0050-01"]}, {"cit