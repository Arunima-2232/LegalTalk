{"id": 4426454, "name": "KEAN v. LANDRUM", "name_abbreviation": "Kean v. Landrum", "decision_date": "1905-11-02", "docket_number": "", "first_page": "556", "last_page": "566", "citations": [{"type": "official", "cite": "72 S.C. 556"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 Am. St. R., 608", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "64 N. Y., 196", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2161851], "opinion_index": -1, "case_paths": ["/ny/64/0196-01"]}, {"cite": "50 N. Y., 670", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2059658], "opinion_index": -1, "case_paths": ["/ny/50/0670-01"]}, {"cite": "119 U. S., 502", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8300084], "opinion_index": -1, "case_paths": ["/us/119/0502-01"]}, {"cite": "59 S. C'., 86", "category": "reporters:federal", "reporter": "S. Ct.", "opinion_index": -1}, {"cite": "35 S, C., 187", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4395294], "opinion_index": -1, "case_paths": ["/sc/35/0187-01"]}, {"cite": "70 S. C., 487", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4424823], "opinion_index": -1, "case_paths": ["/sc/70/0487-01"]}, {"cite": "50 Am. Dec., 679", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "55 S. C., 405", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "70 S. C., 526", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S, C., 151", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S. C., 438", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383374], "opinion_index": -1, "case_paths": ["/sc/23/0438-01"]}, {"cite": "7 S. C., 17