{"id": 4413659, "name": "HENDRIX v. HODDEN", "name_abbreviation": "Hendrix v. Hodden", "decision_date": "1900-08-24", "docket_number": "", "first_page": "495", "last_page": "532", "citations": [{"type": "official", "cite": "58 S.C. 495"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "9 S. C., 430", "category": "reporters:state", "reporter": "S.C.", "case_ids": [356608], "opinion_index": -1, "case_paths": ["/sc/9/0430-01"]}, {"cite": "1 S. C., 194", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9504344], "opinion_index": -1, "case_paths": ["/sc/1/0194-01"]}, {"cite": "55 S. C., 343", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4410566], "opinion_index": -1, "case_paths": ["/sc/55/0343-01"]}, {"cite": "23 S. C., 373", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383358], "opinion_index": -1, "case_paths": ["/sc/23/0373-01"]}, {"cite": "15 S. C., 136", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715619], "opinion_index": -1, "case_paths": ["/sc/15/0136-01"]}, {"cite": "16 S. C., 71", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 444", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4397369], "opinion_index": -1, "case_paths": ["/sc/37/0444-01"]}, {"cite": "35 S. C., 14", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "14 S. C., 48", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 356", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343432], "opinion_index": -1, "case_paths": ["/sc/21/0356-01"]}, {"cite": "49 S. C., 49", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C., 166", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1},