{"id": 8714919, "name": "LUNDY v. SOUTHERN BELL TELEPHONE AND TELEGRAPH CO.", "name_abbreviation": "Lundy v. Southern Bell Telephone & Telegraph Co.", "decision_date": "1911-11-13", "docket_number": "8033", "first_page": "25", "last_page": "41", "citations": [{"type": "official", "cite": "90 S.C. 25"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "87 S. C. 184", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1933010], "opinion_index": -1, "case_paths": ["/sc/87/0184-01"]}, {"cite": "83 S. C. 200", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1926435], "opinion_index": -1, "case_paths": ["/sc/83/0200-01"]}, {"cite": "173 Mo. 661", "category": "reporters:state", "reporter": "Mo.", "opinion_index": -1}, {"cite": "80 S. C. 5", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "101 Ky. 34", "category": "reporters:state", "reporter": "Ky.", "case_ids": [4420506], "opinion_index": -1, "case_paths": ["/ky/101/0034-01"]}, {"cite": "109 Ala. 287", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5651181], "opinion_index": -1, "case_paths": ["/ala/109/0287-01"]}, {"cite": "72 S. C. 392", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "63 S. C. 391", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "83 S. C. 354", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1926410], "opinion_index": -1, "case_paths": ["/sc/83/0354-01"]}, {"cite": "78 S. C. 129", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 Barb. 221", "category": "reporters:state", "reporter": "Barb.", "case_ids": [5013483], "opinion_index": -1, "case_paths": ["/barb/27/0221-01"]}, {"cite": "114 Fed. 843", "category": "reporters:federal", "reporter": "F.", "case_ids": [6721