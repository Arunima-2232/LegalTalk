{"id": 4429352, "name": "OSTEEN v. SOUTHERN RY.-CAROLINA DIVISION", "name_abbreviation": "Osteen v. Southern Ry.", "decision_date": "1907-03-25", "docket_number": "", "first_page": "368", "last_page": "381", "citations": [{"type": "official", "cite": "76 S.C. 368"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "60 S. C., 74", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 507", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 344", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 S. C., 499", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 S. C., 218", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 S. C., 122", "category": "reporters:state", "reporter": "S.C.", "case_ids": [375387], "pin_cites": [{"page": "430, 510"}], "opinion_index": -1, "case_paths": ["/sc/65/0122-01"]}, {"cite": "64 S. C., 514", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381918], "opinion_index": -1, "case_paths": ["/sc/64/0514-01"]}, {"cite": "69 S. C., 545", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422425], "opinion_index": -1, "case_paths": ["/sc/69/0545-01"]}, {"cite": "74 S. C., 320", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 449", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 S. C., 324", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "118 F., 24", "category": "reporters:federal", "reporter": "F.", "case_ids": [3697440], "opinion_index": -1, "case_paths": ["/f/118/0024-01"]}, {"cite": "102 Fed., 62", "category": "reporters:federal", "reporter": "F.", "case_ids": [6718102], "op