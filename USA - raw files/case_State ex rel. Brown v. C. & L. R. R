{"id": 4373992, "name": "THE STATE, EX RELATIONE BROWN, v. C. & L. R. R. CO.", "name_abbreviation": "State ex rel. Brown v. C. & L. R. R.", "decision_date": "1880-03-25", "docket_number": "CASE No. 848", "first_page": "290", "last_page": "317", "citations": [{"type": "official", "cite": "13 S.C. 290"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "9 Cranch 43", "category": "reporters:scotus_early", "reporter": "Cranch", "case_ids": [533628], "opinion_index": -1, "case_paths": ["/us/13/0043-01"]}, {"cite": "40 Conn. 72", "category": "reporters:state", "reporter": "Conn.", "case_ids": [743996], "opinion_index": -1, "case_paths": ["/conn/40/0072-01"]}, {"cite": "9 Mich. 165", "category": "reporters:state", "reporter": "Mich.", "case_ids": [1922336], "opinion_index": -1, "case_paths": ["/mich/9/0165-01"]}, {"cite": "104 Mass. 87", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2147638], "opinion_index": -1, "case_paths": ["/mass/104/0087-01"]}, {"cite": "12 Ohio 375", "category": "reporters:state", "reporter": "Ohio", "opinion_index": -1}, {"cite": "28 Mich. 228", "category": "reporters:state", "reporter": "Mich.", "case_ids": [1953446], "opinion_index": -1, "case_paths": ["/mich/28/0228-01"]}, {"cite": "26 La. 478", "category": "reporters:state", "reporter": "La.", "opinion_index": -1}, {"cite": "1 Otto 540", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "17 Wall. 322", "category": "reporters:scotus_early", "reporter": "Wall.", "case_ids": [62506], "opinion_index": -1, "case_paths": ["/us/84/0322-01"]}, {"cite": "8 Blackf. 361", "category": "reporters:state", "reporter": "Blackf.", "case_ids": [1380883], "opinion_index": -1, "case_paths": ["/blackf/8/0361-01"]}, {"cite": "9 Mo. 507", "category": "reporters:state", "reporter": "Mo.", "opinion_index": -1}, {"cite": "11 S