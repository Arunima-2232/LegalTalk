{"id": 4425546, "name": "BROOM v. WESTERN UNION TEL. CO.", "name_abbreviation": "Broom v. Western Union Tel. Co.", "decision_date": "1905-04-19", "docket_number": "", "first_page": "506", "last_page": "512", "citations": [{"type": "official", "cite": "71 S.C. 506"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "23 S. C., 286", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383451], "opinion_index": -1, "case_paths": ["/sc/23/0286-01"]}, {"cite": "54 S. C., 601", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 226", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 Mo. App., 257", "category": "reporters:state", "reporter": "Mo. App.", "case_ids": [535841], "opinion_index": -1, "case_paths": ["/mo-app/17/0257-01"]}, {"cite": "4 S. C., 241", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 S. C., 103", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "36 S. C., 493", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716420], "opinion_index": -1, "case_paths": ["/sc/36/0493-01"]}, {"cite": "21 Wall., 264", "category": "reporters:scotus_early", "reporter": "Wall.,", "case_ids": [3411563], "opinion_index": -1, "case_paths": ["/us/88/0264-01"]}, {"cite": "17 Mo. App., 357", "category": "reporters:state", "reporter": "Mo. App.", "opinion_index": -1}, {"cite": "11 L. R. A., 103", "category": "reporters:federal", "reporter": "L.R.A.", "weight": 2, "opinion_index": -1}, {"cite": "14 S. E., 94", "category": "reporters:state_regional", "reporter": "S.E.", "weight": 3, "opinion_index": -1}, {"cite": "63 S. C., 433", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350842], "opinion_index": -1, "case_paths": ["/sc/63/0433-01"]}, {"cite": "