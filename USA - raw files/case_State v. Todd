{"id": 1919580, "name": "STATE v. TODD", "name_abbreviation": "State v. Todd", "decision_date": "1908-02-17", "docket_number": "6746", "first_page": "115", "last_page": "115", "citations": [{"type": "official", "cite": "79 S.C. 115"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 83, "char_count": 808, "ocr_confidence": 0.561, "sha256": "73d6ebc3874a2263b85314272a0041a046c888b7966c037a92f3086dcac2973b", "simhash": "1:4cc57aebff0114f3", "word_count": 135}, "last_updated": "2023-07-14T17:47:17.532814+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["STATE v. TODD."], "opinions": [{"text": "The opinion of the Court was delivered by\nMr. Justice Woods.\nThe defendant, Tom Todd, was tried and convicted at the June term, 1907, of the Court of General Sessions for Newberry County for violation of the dispensary law.\nThe appeal in this case, being based upon same grounds as the appeal in State v. Graham, is dismissed, for the reasons set forth in the opinion therein.\nThe judgment of this Court is, that the judgment of the Circuit Court be affirmed.", "type": "majority", "author": "Mr. Justice Woods."}], "attorneys": ["Messrs. Blease & Dominick, for appellant.", "Solicitor R. A. Cooper, contra."], "corrections": "", "head_matter": "6746\nSTATE v. TODD.\nRuled by case of State v. Graham, post, 116.\nBefore F. Barron Grier, Special Judge, Newberry,\nJune term, 1907.\nAffirmed.\nIndictment against Tom Todd for violating dispensary law. From sentence on verdict of guilty., defendant appeals.\nMessrs. Blease & Dominick, for appellant.\nSolicitor R. A. Cooper, contra.\nFebruary 17, 1908."}, "file_name": "0115-01", "first_page_order": 127, "last_page_order": 127}