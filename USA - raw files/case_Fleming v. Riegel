{"id": 8715182, "name": "FLEMING v. RIEGEL", "name_abbreviation": "Fleming v. Riegel", "decision_date": "1911-11-25", "docket_number": "8043", "first_page": "109", "last_page": "122", "citations": [{"type": "official", "cite": "90 S.C. 109"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "56 Am. St. R. 119", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "65 S. C. 5", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "68 S. C. 235", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "32 S. C. 533", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "18 S. C. 501", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C. 534", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4400427], "opinion_index": -1, "case_paths": ["/sc/41/0534-01"]}, {"cite": "1 Hill Ch. 57", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "2 Strob. Eq. 76", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "7 Am. D. 305", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "24 S. E. 600", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "4 L. R. A. 521", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "35 Pac. 1045", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "35 L. R. A. 317", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "37 L. R. A. 690", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "135 U. S. 507", "category": "reporters:federal", "reporter": "U.S."