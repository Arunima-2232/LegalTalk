{"id": 373608, "name": "SUBER v. RICHARDS", "name_abbreviation": "Suber v. Richards", "decision_date": "1901-08-20", "docket_number": "", "first_page": "393", "last_page": "404", "citations": [{"type": "official", "cite": "61 S.C. 393"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "57 S. C., 427", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412502], "pin_cites": [{"page": "*138, 280"}], "opinion_index": -1, "case_paths": ["/sc/57/0427-01"]}, {"cite": "59 S. 'C., 268", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415396], "opinion_index": -1, "case_paths": ["/sc/59/0268-01"]}, {"cite": "47 S. C., 181", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 56", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "43 S. C., 99", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "30 S. C., 170", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 82", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C., 339", "category": "reporters:state", "reporter": "S.C.", "case_ids": [363305], "opinion_index": -1, "case_paths": ["/sc/17/0339-01"]}, {"cite": "57 S. C., 224", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 244", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 394", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "65 Ala., 309", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5543309], "opinion_index": -1, "case_paths": ["/ala/65/0309-01"]}, {"cite": "58 Vt, 271", "category": "reporters:state", "reporter": "Vt.", "case_ids": [762087], "pin_cites": [{"pag