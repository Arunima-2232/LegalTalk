{"id": 4395522, "name": "KENNEDY v. BOYKIN", "name_abbreviation": "Kennedy v. Boykin", "decision_date": "1892-02-19", "docket_number": "", "first_page": "61", "last_page": "88", "citations": [{"type": "official", "cite": "35 S.C. 61"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 R. I., 364", "category": "reporters:state", "reporter": "R.I.", "case_ids": [1329114], "opinion_index": -1, "case_paths": ["/ri/11/0364-01"]}, {"cite": "77 Penn., 151", "category": "reporters:state", "reporter": "Penn.,", "opinion_index": -1}, {"cite": "1 Cranch, 161", "category": "reporters:scotus_early", "reporter": "Cranch,", "case_ids": [6760537], "weight": 3, "pin_cites": [{"page": "248"}], "opinion_index": -1, "case_paths": ["/dc/1/0161-01"]}, {"cite": "89 Penn., 345", "category": "reporters:state", "reporter": "Penn.,", "opinion_index": -1}, {"cite": "146 Mass., 611", "category": "reporters:state", "reporter": "Mass.", "opinion_index": -1}, {"cite": "61 Miss., 597", "category": "reporters:state", "reporter": "Miss.", "opinion_index": -1}, {"cite": "16 Ohio, 548", "category": "reporters:state", "reporter": "Ohio", "opinion_index": -1}, {"cite": "27 S. C., 90", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4388020], "opinion_index": -1, "case_paths": ["/sc/27/0090-01"]}, {"cite": "2 Rich., 481", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8859842], "opinion_index": -1, "case_paths": ["/scl/31/0481-01"]}, {"cite": "2 Strob., 378", "category": "reporters:state", "reporter": "Strob.", "weight": 2, "opinion_index": -1}, {"cite": "2 Rich., 487", "category": "reporters:state", "reporter": "Rich.", "weight": 2, "pin_cites": [{"page": "491"}], "opinion_index": -1}, {"cite": "3 McCord, 411", "category": "reporters:state", "reporter": "McCord", "case_ids": [8860219], "opinion_index": -1, "case_paths": ["/scl