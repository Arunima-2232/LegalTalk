{"id": 4402047, "name": "FROST v. BERKELEY PHOSPHATE COMPANY", "name_abbreviation": "Frost v. Berkeley Phosphate Co.", "decision_date": "1894-10-22", "docket_number": "", "first_page": "402", "last_page": "414", "citations": [{"type": "official", "cite": "42 S.C. 402"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "14 L. R. A., 329", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "18 L. R. A., 756", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "9 L. R. A., 711", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "21 S. C., 400", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "22 Atl. Rep., 758", "category": "reporters:state_regional", "reporter": "A.", "opinion_index": -1}, {"cite": "22 S. C., 476", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4382415], "opinion_index": -1, "case_paths": ["/sc/22/0476-01"]}, {"cite": "11 Rich., 217", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8485947], "opinion_index": -1, "case_paths": ["/scl/45/0217-01"]}, {"cite": "4 South. Rep., 713", "category": "reporters:state_regional", "reporter": "So.", "opinion_index": -1}, {"cite": "15 Wall., 538", "category": "reporters:scotus_early", "reporter": "Wall.,", "opinion_index": -1}, {"cite": "22 N. E. Rep., 989", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "63 N. Y., 576", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "67 N. Y., 336", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "11 Cush., 221", "category": "reporters:state", "reporter": "Cush.", "case_ids": [1970396], "opinion_index": -1, "case_paths": ["/mass/65/0221-01"]}, {"cite": "51 N.