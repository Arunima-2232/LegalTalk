{"id": 4415906, "name": "NASH, ADMR., v. WOODWARD", "name_abbreviation": "Nash v. Woodward", "decision_date": "1902-02-18", "docket_number": "", "first_page": "418", "last_page": "426", "citations": [{"type": "official", "cite": "62 S.C. 418"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "24 S. C., 165", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4384904], "opinion_index": -1, "case_paths": ["/sc/24/0165-01"]}, {"cite": "3 Rich., 184", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "60 S. C., 477", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716173], "opinion_index": -1, "case_paths": ["/sc/60/0477-01"]}, {"cite": "21 S. C., 221", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343397], "weight": 2, "pin_cites": [{"page": "242"}], "opinion_index": -1, "case_paths": ["/sc/21/0221-01"]}, {"cite": "54 S. C., 325", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. C., 77", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "27 S. C., 623", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387848, 4388045], "opinion_index": -1, "case_paths": ["/sc/27/0623-02", "/sc/27/0623-01"]}, {"cite": "16 S. C., 231", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4376976], "opinion_index": -1, "case_paths": ["/sc/16/0231-01"]}, {"cite": "27 S. C., 92", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4388093], "opinion_index": -1, "case_paths": ["/sc/27/0092-01"]}, {"cite": "42 S. C., 107", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 213", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 Cow., 420", "category": "reporters:state", "reporter": "Co