{"id": 1931611, "name": "ARMSTRONG v. A. C. TUXBURY LUMBER CO.", "name_abbreviation": "Armstrong v. A. C. Tuxbury Lumber Co.", "decision_date": "1910-06-01", "docket_number": "7589", "first_page": "116", "last_page": "136", "citations": [{"type": "official", "cite": "86 S.C. 116"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "80 S. C., 238", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 443", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 426", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915535], "opinion_index": -1, "case_paths": ["/sc/77/0426-01"]}, {"cite": "56 S. C., 91", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503362], "opinion_index": -1, "case_paths": ["/sc/56/0091-01"]}, {"cite": "67 S. C., 146", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "84 S. W., 1100", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "77 S. C., 408", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "70 S. C., 475", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "76 S. C., 553", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 459", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "80 S. C., 234", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "72 S. C., 348", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 547", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 488", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "60 S. C., 68", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "211 U. S., 467", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "34 S. C., 214", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "69 S. C., 529", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422274], "opinion_index": -1, "case_paths": ["/sc/69/0529-01"]}, {"cite": "72 S. C., 398", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4426373], "opinion_index": -1, "case_paths": ["/sc/72/0398-01"]}, {"cite": "75 S. C., 102", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2352461], "opinion_index": -1, "case_paths": ["/sc/75/0102-01"]}, {"cite": "61 S. C., 494", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "76 S. C., 550", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429683], "opinion_index": -1, "case_paths": ["/sc/76/0550-01"]}, {"cite": "54 S. C., 485", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409296], "opinion_index": -1, "case_paths": ["/sc/54/0485-01"]}, {"cite": "16 S. C., 331", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377929], "opinion_index": -1, "case_paths": ["/sc/16/0331-01"]}, {"cite": "77 S. C., 328", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915515], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/77/0328-01"]}, {"cite": "72 S. C., 336", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4426533], "opinion_index": -1, "case_paths": ["/sc/72/0336-01"]}, {"cite": "66 S. C., 533", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "64 S. C., 561", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S.'C., 495", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4413659], "opinion_index": -1, "case_p