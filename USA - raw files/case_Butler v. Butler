{"id": 2351202, "name": "BUTLER v. BUTLER", "name_abbreviation": "Butler v. Butler", "decision_date": "1906-03-03", "docket_number": "", "first_page": "402", "last_page": "403", "citations": [{"type": "official", "cite": "73 S.C. 402"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "105 U. S., 533", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "27 L. R. A., 99", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "60 Am. St. R., 510", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "36 S. C., 25", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "25 S. C., 200", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "496"}], "opinion_index": -1}, {"cite": "24 S. C., 239", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 162", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343186], "opinion_index": -1, "case_paths": ["/sc/21/0162-01"]}, {"cite": "24 S. C., 238", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4384888], "opinion_index": -1, "case_paths": ["/sc/24/0238-01"]}, {"cite": "25 S. C., 505", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 S. C., 445", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4374515], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/13/0445-01"]}, {"cite": "24 S. C., 238", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4384888], "opinion_index": 0, "case_paths": ["/sc/24/0238-01"]}], "analysis": {"cardinality": 132, "char_count": 1344, "ocr_confidence": 0.591, "pagerank": {"raw": 1.3925126757598597e-07, "percentile": 0.6430797702877659}, "sha256": "7440d84c97efba05225751f361d6092188b1b37725d8630bb45f5f63194200c3", "simhash": "1:8481a39cee861cbf", "word_count": 246}, "last_updated": "2024-02-27T18:07:35.203113+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["BUTLER v. BUTLER."], "opinions": [{"text": "The opinion of the Court was delivered by\nMr. Justice Woods.\nThe brothers and sisters and the nephews and nieces of Silas- Butler brought this action for partition against his widow. Partition in kind having been found impracticable, the land was sold by order of the Court. The master reported that attorneys for plaintiff should be allowed a fee of $2-50 for their services in the partition suit, to be paid out of the proceeds of sale of land before distribution. Upon exception to this recommendation of the master, the Circuit Judge held there was no warrant for the allowance of a fee to the attorneys for the plaintiffs out of the common fund. The precise point was decided in Westmoreland v. Martin, 24 S. C., 238.\nThe judgment of this Court is, that the judgment of the Circuit Court be affirmed.", "type": "majority", "author": "Mr. Justice Woods."}], "attorneys": ["Messrs. Able & Blease, for appellants,", "Mr. Wm. N. Graydon, contra,"], "corrections": "", "head_matter": "BUTLER v. BUTLER.\nPartition. \u2014 Attorney for plaintiffs in partition suit is not erP'tled to fee out of common fund.\nBefore Prince, J., Saluda, April, 1905.\nAffirmed.\nAction by Henry Butler et ail. against Lucinda Butler et al. Plaintiffs appeal from Circuit decree.\nMessrs. Able & Blease, for appellants,\ncite: 13 S. C., 445; 25 S. C., 505.\nMr. Wm. N. Graydon, contra,\ncites: 24 S. C., 238; 13 S. C., 445; 21 S. C., 162; 24 S. C., 239; 25 S. C., 200, 496; 36 S. C., 25; 60 Am. St. R., 510; 27 L. R. A., 99; 105 U. S., 533.\nMarch 3, 1906."}, "file_name": "0402-01", "first_page_order": 412, "last_page_order": 413}