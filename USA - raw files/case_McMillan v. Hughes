eporters:state", "reporter": "S.C.", "case_ids": [4386889, 4386966], "opinion_index": -1, "case_paths": ["/sc/27/0621-01", "/sc/27/0621-02"]}, {"cite": "25 S. C. 510", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C. 480", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343514], "opinion_index": -1, "case_paths": ["/sc/21/0480-01"]}, {"cite": "83 S. C. 257", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 S. C. 293", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C. 18", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "78 S. C. 191", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "51 S. C. 557", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "74 S. C. 428", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. E. 39", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "12 L. R. A., N. S. 298", "category": "reporters:federal", "reporter": "L.R.A.N.S.", "opinion_index": 0}, {"cite": "57 S. E. 614", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "76 S. C. 487", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "51 S. C. 555", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716846], "opinion_index": 0, "case_paths": ["/sc/51/0555-01"]}, {"cite": "65 S. E. 108", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "84 S. C. 428", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "14 S. E. 714", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "35 S. C. 314", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4395784], "opinion_index": 0,