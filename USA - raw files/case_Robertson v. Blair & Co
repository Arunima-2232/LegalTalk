{"id": 9503392, "name": "ROBERTSON AND THOMPSON v. BLAIR & CO.; KENT FURNITURE MFG. CO. v. SAME; BAGBY AND RIVERS v. SAME", "name_abbreviation": "Robertson v. Blair & Co.", "decision_date": "1899-09-30", "docket_number": "", "first_page": "96", "last_page": "111", "citations": [{"type": "official", "cite": "56 S.C. 96"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "38 S. C, 556", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4398619], "opinion_index": -1, "case_paths": ["/sc/38/0556-01"]}, {"cite": "2 Bail., 114", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2510095], "opinion_index": -1, "case_paths": ["/scl/18/0114-01"]}, {"cite": "3 Rich., 165", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "24 Wis., 340", "category": "reporters:state", "reporter": "Wis.", "case_ids": [8708706], "opinion_index": -1, "case_paths": ["/wis/24/0340-01"]}, {"cite": "44 Wis., 136", "category": "reporters:state", "reporter": "Wis.", "case_ids": [8704796], "opinion_index": -1, "case_paths": ["/wis/44/0136-01"]}, {"cite": "86 Wis., 378", "category": "reporters:state", "reporter": "Wis.", "case_ids": [11283343], "opinion_index": -1, "case_paths": ["/wis/86/0378-01"]}, {"cite": "27 S. C., 300", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387912], "opinion_index": -1, "case_paths": ["/sc/27/0300-01"]}, {"cite": "2 Hill, 480", "category": "reporters:state", "reporter": "Hill,", "opinion_index": -1}, {"cite": "52 S. C, 36", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378537], "opinion_index": -1, "case_paths": ["/sc/52/0036-01"]}, {"cite": "2 Rich., 324", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8858372], "opinion_index": -1, "case_paths": ["/scl/31/0324-01"]}, {"cite": "68 Ind., 569", "category": "reporters:s