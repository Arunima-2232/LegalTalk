{"id": 375483, "name": "BLACKWELL v. BRITISH AMERICAN MTG. CO.", "name_abbreviation": "Blackwell v. British American Mtg. Co.", "decision_date": "1902-01-10", "docket_number": "", "first_page": "105", "last_page": "122", "citations": [{"type": "official", "cite": "65 S.C. 105"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "57 S. C., 182", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4411760], "opinion_index": -1, "case_paths": ["/sc/57/0182-01"]}, {"cite": "47 S. C., 299", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 S. C., 411", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 18", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4384787], "opinion_index": -1, "case_paths": ["/sc/24/0018-01"]}, {"cite": "53 S. C., 126", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715634], "opinion_index": -1, "case_paths": ["/sc/53/0126-01"]}, {"cite": "20 S. C., 52", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 S. C., 535", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 98", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "31 S. C., 280", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 563", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716841], "opinion_index": -1, "case_paths": ["/sc/53/0563-01"]}, {"cite": "24 S. C., 33", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Bail. Eq., 347", "category": "reporters:state", "reporter": "Bail. Eq.", "opinion_index": -1}, {"cite": "36 S. C., 343", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "42 S. C