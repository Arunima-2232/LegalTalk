2-01"]}, {"cite": "20 S. C, 518", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C., 283", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 579", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "29 S. C., 338", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "14 Rich. Eq., 304", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [1835976], "opinion_index": -1, "case_paths": ["/sc-eq/35/0304-01"]}, {"cite": "16 S. C., 142", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Am. Dec., 267", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "19 S. C., 480", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 S. C., 577", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2341170], "opinion_index": -1, "case_paths": ["/sc/3/0577-01"]}, {"cite": "4 Rich., 424", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "9 Rich., 53", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "17 S. C., 35", "category": "reporters:state", "reporter": "S.C.", "case_ids": [363285], "opinion_index": -1, "case_paths": ["/sc/17/0035-01"]}, {"cite": "57 S. C., 60", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412625], "opinion_index": -1, "case_paths": ["/sc/57/0060-01"]}, {"cite": "66 S. C., 68", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 187", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915520], "opinion_index": -1, "case_paths": ["/sc/77/0187-01"]}, {"cite": "13 Pet, 99", "category": "reporters:scotus_early", "reporter": "Pet.", "opinion_index": -1}, {"cite": "24 Am. St. R., 706", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index":