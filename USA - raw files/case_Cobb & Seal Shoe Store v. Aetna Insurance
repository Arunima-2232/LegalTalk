{"id": 1917276, "name": "COBB AND SEAL SHOE STORE v. AETNA INSURANCE CO.", "name_abbreviation": "Cobb & Seal Shoe Store v. Aetna Insurance", "decision_date": "1907-10-18", "docket_number": "6690", "first_page": "388", "last_page": "398", "citations": [{"type": "official", "cite": "78 S.C. 388"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "46 Am. St. R., 797", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "54 S. C., 603", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "70 S. C., 78", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 231", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "76 S. C., 82", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C., 370", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. E., 254", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "70 S. C., 303", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 N. Y., 6", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [1952922], "opinion_index": -1, "case_paths": ["/ny/65/0006-01"]}, {"cite": "45 N. Y., 454", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2049796], "opinion_index": -1, "case_paths": ["/ny/45/0454-01"]}, {"cite": "7 Mo. App., 77", "category": "reporters:state", "reporter": "Mo. App.", "case_ids": [556829], "opinion_index": -1, "case_paths": ["/mo-app/7/0077-01"]}, {"cite": "76 S. C., 76", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429486], "opinion_index": -1, "case_paths": ["/sc/76/0076-01"]}, {"cite": "68 S. C., 365", "category": "reporters:state", "reporter": "S.C.", "o