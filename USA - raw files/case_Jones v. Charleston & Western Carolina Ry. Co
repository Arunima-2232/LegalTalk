{"id": 375447, "name": "JONES v. CHARLESTON & WESTERN CAROLINA RY. CO.", "name_abbreviation": "Jones v. Charleston & Western Carolina Ry. Co.", "decision_date": "1903-03-25", "docket_number": "", "first_page": "410", "last_page": "421", "citations": [{"type": "official", "cite": "65 S.C. 410"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "61 S. C., 487", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 136", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "25 S. C., 128", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715676], "opinion_index": -1, "case_paths": ["/sc/25/0128-01"]}, {"cite": "23 S. C., 537", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 S. C., 491", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373582], "opinion_index": -1, "case_paths": ["/sc/61/0491-01"]}, {"cite": "53 S. C., 215", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "11 S. C., 195", "category": "reporters:state", "reporter": "S.C.", "case_ids": [359602], "pin_cites": [{"page": "589"}], "opinion_index": -1, "case_paths": ["/sc/11/0195-01"]}, {"cite": "63 S. C., 495", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 70", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4413803], "opinion_index": -1, "case_paths": ["/sc/58/0070-01"]}, {"cite": "52 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378506], "opinion_index": -1, "case_paths": ["/sc/52/0323-01"]}, {"cite": "62 S. C., 334", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "64 S. C., 104", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381976], "opinion_index": -1