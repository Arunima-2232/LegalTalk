{"id": 8715602, "name": "SINGLETON v. SINGLETON", "name_abbreviation": "Singleton v. Singleton", "decision_date": "1901-04-08", "docket_number": "", "first_page": "216", "last_page": "237", "citations": [{"type": "official", "cite": "60 S.C. 216"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "51 S. C., 467", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "45 S. C., 83", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368958], "opinion_index": -1, "case_paths": ["/sc/45/0083-01"]}, {"cite": "43 S. C., 287", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346305], "opinion_index": -1, "case_paths": ["/sc/43/0287-01"]}, {"cite": "38 S. C., 148", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "22 S. C., 9", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4382596], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/22/0009-01"]}, {"cite": "11 Rich., 432", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486251], "opinion_index": -1, "case_paths": ["/scl/45/0432-01"]}, {"cite": "4 Rich. Eq., 116", "category": "reporters:state", "reporter": "Rich. Eq.", "weight": 2, "opinion_index": -1}, {"cite": "57 S. C., 147", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412516], "opinion_index": -1, "case_paths": ["/sc/57/0147-01"]}, {"cite": "57 S. C., 467", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412274], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/57/0467-01"]}, {"cite": "51 S. C., 38", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C., 74", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378549], "pin_cites": [{"page": "405"}], "opinion_index": -1, "case_paths": ["/sc/52/0074-01"]}, {"cit