{"id": 1928101, "name": "GLENN v. WESTERN UNION TEL. CO.", "name_abbreviation": "Glenn v. Western Union Tel. Co.", "decision_date": "1909-11-03", "docket_number": "7359", "first_page": "155", "last_page": "167", "citations": [{"type": "official", "cite": "84 S.C. 155"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "78 S'. C., 562", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1917272], "opinion_index": -1, "case_paths": ["/sc/78/0562-01"]}, {"cite": "71 S'. C., 95", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4425209], "opinion_index": -1, "case_paths": ["/sc/71/0095-01"]}, {"cite": "78 S'. C., 552", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1917237], "opinion_index": -1, "case_paths": ["/sc/78/0552-01"]}, {"cite": "79 S. C., 66", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "78 S'. C., 364", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "73 S'. C., 274", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2351120], "opinion_index": -1, "case_paths": ["/sc/73/0274-01"]}, {"cite": "81 S. C., 436", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "75 S'. C., 512", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2353156], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/75/0512-01"]}, {"cite": "79 S. C., 163", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 399", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915528], "pin_cites": [{"page": "122, 56"}], "opinion_index": -1, "case_paths": ["/sc/77/0399-01"]}, {"cite": "74 S. C., 304", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 113", "category": "reporters:state", "rep