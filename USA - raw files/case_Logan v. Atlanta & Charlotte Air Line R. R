{"id": 1924759, "name": "LOGAN v. ATLANTA & CHARLOTTE AIR LINE R. R. CO.", "name_abbreviation": "Logan v. Atlanta & Charlotte Air Line R. R.", "decision_date": "1909-05-08", "docket_number": "7187", "first_page": "518", "last_page": "528", "citations": [{"type": "official", "cite": "82 S.C. 518"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "7 L. R. A., 277", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "4 N. E., 382", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "19 N. E., 788", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "136 Fed., 1", "category": "reporters:federal", "reporter": "F.", "case_ids": [3874309], "opinion_index": -1, "case_paths": ["/f/136/0001-01"]}, {"cite": "135 Fed., 650", "category": "reporters:federal", "reporter": "F.", "case_ids": [3868418], "opinion_index": -1, "case_paths": ["/f/135/0650-01"]}, {"cite": "109 Fed., 508", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "22 Fed., 30", "category": "reporters:federal", "reporter": "F.", "pin_cites": [{"page": "711"}], "opinion_index": -1}, {"cite": "9 Fed., 789", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "7 Fed., 522", "category": "reporters:federal", "reporter": "F.", "opinion_index": -1}, {"cite": "93 U. S., 578", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "99 U. S., 178", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "29 Am. St. R., 312", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "42 L. R. A., 450", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "3 L. R. A., 597", "category": "repo