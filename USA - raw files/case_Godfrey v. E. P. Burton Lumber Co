{"id": 1935142, "name": "GODFREY v. E. P. BURTON LUMBER CO.", "name_abbreviation": "Godfrey v. E. P. Burton Lumber Co.", "decision_date": "1911-03-15", "docket_number": "7821", "first_page": "132", "last_page": "161", "citations": [{"type": "official", "cite": "88 S.C. 132"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "141 U. S. 429", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3556095], "opinion_index": -1, "case_paths": ["/us/141/0429-01"]}, {"cite": "93 U. S. 55", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5645785], "opinion_index": -1, "case_paths": ["/us/93/0055-01"]}, {"cite": "13 S. C. 211", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "7 S. C. 47", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4373108], "opinion_index": -1, "case_paths": ["/sc/7/0047-01"]}, {"cite": "50 S. C. 397", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408130], "opinion_index": -1, "case_paths": ["/sc/50/0397-01"]}, {"cite": "46 S. C. 426", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348852], "opinion_index": -1, "case_paths": ["/sc/46/0426-01"]}, {"cite": "13 S. C. 203", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4373866], "opinion_index": -1, "case_paths": ["/sc/13/0203-01"]}, {"cite": "2 Bail. 269", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2514494], "opinion_index": -1, "case_paths": ["/scl/18/0269-01"]}, {"cite": "2 Hill 658", "category": "reporters:state", "reporter": "Hill", "opinion_index": -1}, {"cite": "57 S. C. 393", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Rich. Eq. 404", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8714151], "opinion_index": -1, "case_paths": ["/sc-eq/18/0404-