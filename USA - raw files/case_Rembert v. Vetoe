{"id": 1936751, "name": "REMBERT v. VETOE", "name_abbreviation": "Rembert v. Vetoe", "decision_date": "1911-07-07", "docket_number": "7953", "first_page": "198", "last_page": "217", "citations": [{"type": "official", "cite": "89 S.C. 198"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "1 Hill Ch. 295", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "54 S. C. 383", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C. 64", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377059], "opinion_index": -1, "case_paths": ["/sc/16/0064-01"]}, {"cite": "14 S. C. 540", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "35 S. C. 123", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Rich. Eq. 550", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "21 S. C. 183", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343489], "opinion_index": -1, "case_paths": ["/sc/21/0183-01"]}, {"cite": "37 S. C. 265", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "72 S. C. 183", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "80 S. C. 94", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1920996], "opinion_index": -1, "case_paths": ["/sc/80/0094-01"]}, {"cite": "2 Hill Ch. 328", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "84 S. C. 81", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1928033], "opinion_index": -1, "case_paths": ["/sc/84/0081-01"]}, {"cite": "9 Rich. Eq. 459", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713649], "opinion_index": -1, "case_paths": ["/sc-eq/30/