{"id": 4422230, "name": "CHARLESTON & WESTERN CAR. RY. CO. v. REYNOLDS", "name_abbreviation": "Charleston & Western Car. Ry. Co. v. Reynolds", "decision_date": "1904-07-30", "docket_number": "", "first_page": "481", "last_page": "520", "citations": [{"type": "official", "cite": "69 S.C. 481"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "38 S. C., 38", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "64 S. C., 438", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381987], "opinion_index": -1, "case_paths": ["/sc/64/0438-01"]}, {"cite": "21 S. C., 530", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 375", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 532", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412823], "opinion_index": -1, "case_paths": ["/sc/58/0532-01"]}, {"cite": "10 Gratt., 363", "category": "reporters:state", "reporter": "Gratt.", "opinion_index": -1}, {"cite": "3 Strob. Eq., 359", "category": "reporters:state", "reporter": "Strob. Eq.", "opinion_index": -1}, {"cite": "15 Rich., 198", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "16 S. C., 426", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 430", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C., 324", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "59 S. C., 37", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Rich. Eq., 277", "category": "reporters:state", "reporter": "Rich. Eq.", "weight": 2, "opinion_index": -1}, {"cite": "38 S. C., 313", "category": "reporters:state", "reporter": "S.C.", "weight": 2, "opinion_index": -1}, {"cite": "59 S. C., 371", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415266], "weight": 3, "opinion_index": -1, "case_paths": ["/sc/59/0371-01"]}, {"cite": "38 S. C., 34", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4398917], "opinion_index": -1, "case_paths": ["/sc/38/0034-01"]}, {"cite": "28 S. C., 388", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4388643], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/28/0388-01"]}, {"cite": "25 S. E., 200", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "64 S. C., 433", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "41 S. E., 451", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "63 S. C., 348", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350453], "opinion_index": 0, "case_paths": ["/sc/63/0348-01"]}, {"cite": "39 S. E., 780", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "62 S. C., 56", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "17 S. E., 24", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": 0}, {"cite": "38 S. C., 308", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4398320], "opinion_index": 0, "case_paths": ["/sc/38/0308-01"]}, {"cite": "59 S. C., 377", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "2 S. C., 421", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "10 S. C., 376", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716351], "opinion_index": 0, "case_paths": ["/sc/10/0376-01"]}, {"cite": "39 S. E., 373", "category": "reporters:state_regional", "reporter": "S.E.", "year": 1901, "opinion_index": 0}, {"cite": "61 S. C., 236", "category": "reporters:state", "reporter"