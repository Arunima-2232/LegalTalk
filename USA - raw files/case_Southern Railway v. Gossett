{"id": 1919632, "name": "SOUTHERN RAILWAY v. GOSSETT", "name_abbreviation": "Southern Railway v. Gossett", "decision_date": "1908-03-18", "docket_number": "6810", "first_page": "372", "last_page": "383", "citations": [{"type": "official", "cite": "79 S.C. 372"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "75 S. C, 407", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C, 549", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C, 427", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412502], "opinion_index": -1, "case_paths": ["/sc/57/0427-01"]}, {"cite": "69 S. C, 116", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422243], "opinion_index": -1, "case_paths": ["/sc/69/0116-01"]}, {"cite": "42 S. C, 145", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "63 S. C, 267", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "67 S. C, 505", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "22 S. C, 547", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "67 S. C, 553", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4419786], "opinion_index": -1, "case_paths": ["/sc/67/0553-01"]}, {"cite": "4 Rich, 107", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486300], "opinion_index": -1, "case_paths": ["/scl/38/0107-01"]}, {"cite": "73 S. C, 215", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2351262], "opinion_index": -1, "case_paths": ["/sc/73/0215-01"]}, {"cite": "76 S, C, 285", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "48 S. C, 364", "category": "reporters:state", "reporter": "S.C.", "case_ids": [44