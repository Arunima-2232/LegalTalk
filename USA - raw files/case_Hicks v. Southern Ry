{"id": 2350422, "name": "HICKS v. SOUTHERN RY.", "name_abbreviation": "Hicks v. Southern Ry.", "decision_date": "1902-04-18", "docket_number": "", "first_page": "559", "last_page": "577", "citations": [{"type": "official", "cite": "63 S.C. 559"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "5 S. C., 389", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "35 S. C., 407", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "31 Pac., 283", "category": "reporters:state_regional", "reporter": "P.", "case_ids": [2272912], "opinion_index": -1, "case_paths": ["/or/23/0094-01"]}, {"cite": "35 S. C., 405", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4395599], "opinion_index": -1, "case_paths": ["/sc/35/0405-01"]}, {"cite": "15 S. C., 457", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 Gray., 440", "category": "reporters:state", "reporter": "Gray", "opinion_index": -1}, {"cite": "58 Tex., 276", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2175099], "opinion_index": -1, "case_paths": ["/tex/58/0276-01"]}, {"cite": "107 U. S., 4541", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "35 S. C., 406", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "81 Tex., 517", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2215437], "opinion_index": -1, "case_paths": ["/tex/81/0517-01"]}, {"cite": "25 S. 'C., 135", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 91", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503362], "opinion_index": -1, "case_paths": ["/sc/56/0091-01"]}, {"cite": "35 S. C., 409", "category": "reporters:state", "reporter": "S.C.", "case_ids"