{"id": 2353156, "name": "WALKER v. WESTERN UNION TEL. CO.", "name_abbreviation": "Walker v. Western Union Tel. Co.", "decision_date": "1906-12-12", "docket_number": "", "first_page": "512", "last_page": "532", "citations": [{"type": "official", "cite": "75 S.C. 512"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "163 U. S., 1105", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "55 S. C., 153", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C., 484", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364810], "opinion_index": -1, "case_paths": ["/sc/39/0484-01"]}, {"cite": "113 Mo., 633", "category": "reporters:state", "reporter": "Mo.", "case_ids": [8843940], "opinion_index": -1, "case_paths": ["/mo/113/0633-01"]}, {"cite": "39 Mo. App., 88", "category": "reporters:state", "reporter": "Mo. App.", "case_ids": [8849935], "opinion_index": -1, "case_paths": ["/mo-app/39/0088-01"]}, {"cite": "37 S. C., 413", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396724], "opinion_index": -1, "case_paths": ["/sc/37/0413-01"]}, {"cite": "139 U. S., 788", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "45 N. Y., 113", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2049758], "opinion_index": -1, "case_paths": ["/ny/45/0113-01"]}, {"cite": "54 L. R. A., 161", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "54 S. C., 498", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409362], "opinion_index": -1, "case_paths": ["/sc/54/0498-01"]}, {"cite": "60 S. C., 74", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "35 S. C., 484", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -