{"id": 8715241, "name": "CROSSWELL v. THE CONNECTICUT INDEMNITY ASSOCIATION", "name_abbreviation": "Crosswell v. Connecticut Indemnity Ass'n", "decision_date": "1897-11-09", "docket_number": "", "first_page": "103", "last_page": "121", "citations": [{"type": "official", "cite": "51 S.C. 103"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "94 U. S., 567", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "94 U. S., 457", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5645329], "opinion_index": -1, "case_paths": ["/us/94/0457-01"]}, {"cite": "108 Pa., 656", "category": "reporters:state", "reporter": "Pa.", "opinion_index": -1}, {"cite": "112 Pa. St., 257", "category": "reporters:state", "reporter": "Pa.", "opinion_index": -1}, {"cite": "36 Kan., 146", "category": "reporters:state", "reporter": "Kan.", "case_ids": [1159794], "opinion_index": -1, "case_paths": ["/kan/36/0146-01"]}, {"cite": "81 Ky., 368", "category": "reporters:state", "reporter": "Ky.", "case_ids": [1311694], "opinion_index": -1, "case_paths": ["/ky/81/0368-01"]}, {"cite": "81 Ala., 329", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3357944], "opinion_index": -1, "case_paths": ["/ala/81/0329-01"]}, {"cite": "76 Ala., 183", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5618658], "opinion_index": -1, "case_paths": ["/ala/76/0183-01"]}, {"cite": "81 Pa. St., 154", "category": "reporters:state", "reporter": "Pa.", "case_ids": [1044118], "opinion_index": -1, "case_paths": ["/pa/81/0154-01"]}, {"cite": "80 Ill., 35", "category": "reporters:state", "reporter": "Ill.", "case_ids": [2682254], "opinion_index": -1, "case_paths": ["/ill/80/0035-01"]}, {"cite": "94 U. S., 40", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "39 Conn., 104", "cate