{"id": 8716239, "name": "MAULDIN v. THE CITY COUNCIL OF GREENVILLE", "name_abbreviation": "Mauldin v. City Council of Greenville", "decision_date": "1898-09-29", "docket_number": "", "first_page": "285", "last_page": "295", "citations": [{"type": "official", "cite": "53 S.C. 285"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "31 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392473], "opinion_index": -1, "case_paths": ["/sc/31/0001-01"]}, {"cite": "9 Heisk, 349", "category": "reporters:state", "reporter": "Heisk.", "case_ids": [8539761], "opinion_index": -1, "case_paths": ["/tenn/56/0349-01"]}, {"cite": "4 S. C., 422", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "32 Ark., 31", "category": "reporters:state", "reporter": "Ark.", "case_ids": [1877144], "opinion_index": -1, "case_paths": ["/ark/32/0031-01"]}, {"cite": "34 Ill., 203", "category": "reporters:state", "reporter": "Ill.", "case_ids": [5288608], "opinion_index": -1, "case_paths": ["/ill/34/0203-01"]}, {"cite": "12 Rich., 702", "category": "reporters:state", "reporter": "Rich.", "case_ids": [907741], "opinion_index": -1, "case_paths": ["/scl/46/0702-01"]}, {"cite": "34 N. E., 677", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "8 Heisk, 456", "category": "reporters:state", "reporter": "Heisk.", "case_ids": [771775], "opinion_index": -1, "case_paths": ["/tenn/55/0456-01"]}, {"cite": "51 Ala., 42", "category": "reporters:state", "reporter": "Ala.", "case_ids": [2996303], "opinion_index": -1, "case_paths": ["/ala/51/0042-01"]}, {"cite": "10 Wis., 258", "category": "reporters:state", "reporter": "Wis.", "opinion_index": -1}, {"cite": "5 Ohio, 243", "category": "reporters:state", "reporter": "Ohio", "case_ids": [579745], "opinion_index": -1, "case_paths": ["/