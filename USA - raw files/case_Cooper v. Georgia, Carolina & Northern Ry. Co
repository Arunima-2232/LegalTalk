{"id": 373611, "name": "COOPER v. GEORGIA, CAROLINA AND NORTHERN RY. CO.", "name_abbreviation": "Cooper v. Georgia, Carolina & Northern Ry. Co.", "decision_date": "1901-08-05", "docket_number": "", "first_page": "345", "last_page": "360", "citations": [{"type": "official", "cite": "61 S.C. 345"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "41 S. C., 440", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4400349], "opinion_index": -1, "case_paths": ["/sc/41/0440-01"]}, {"cite": "39 S. C., 162", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364816], "opinion_index": -1, "case_paths": ["/sc/39/0162-01"]}, {"cite": "58 S. C., 49", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 244", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "303"}], "opinion_index": -1}, {"cite": "57 S. C., 224", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "489"}], "opinion_index": -1}, {"cite": "44 S. C., 546", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2347565], "opinion_index": -1, "case_paths": ["/sc/44/0546-01"]}, {"cite": "40 S. C., 537", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C., 239", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 Rich., 90", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "59 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 Rich., 228", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486491], "opinion_index": -1, "case_paths": ["/scl/38/0228-01"]}, {"cite": "56 S. C., 95", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 192", "category": "re