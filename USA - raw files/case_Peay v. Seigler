{"id": 4406124, "name": "PEAY v. SEIGLER", "name_abbreviation": "Peay v. Seigler", "decision_date": "1897-03-20", "docket_number": "", "first_page": "496", "last_page": "516", "citations": [{"type": "official", "cite": "48 S.C. 496"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "5 Rich. Eq., 170", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713556], "opinion_index": -1, "case_paths": ["/sc-eq/26/0170-01"]}, {"cite": "25 S. C., 507", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 Rich. Eq., 250", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8712692], "opinion_index": -1, "case_paths": ["/sc-eq/34/0250-01"]}, {"cite": "7 Rich. Eq., 378", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713605], "opinion_index": -1, "case_paths": ["/sc-eq/28/0378-01"]}, {"cite": "2 Hill Ch., 426", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "41 S. C., 46", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "40 S. C., 149", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "29 S. C., 127", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 295", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S. C., 492", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "22 S. C., 40", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 N. J. Eq., 504", "category": "reporters:state", "reporter": "N.J. Eq.", "opinion_index": -1}, {"cite": "14 S. C., 90", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "318"}], "opinion_index": -1}, {"cite": "5 S. C., 101", "category": "reporter