{"id": 4416526, "name": "DOOLITTLE v. SOUTHERN RY.", "name_abbreviation": "Doolittle v. Southern Ry.", "decision_date": "1901-11-29", "docket_number": "", "first_page": "130", "last_page": "144", "citations": [{"type": "official", "cite": "62 S.C. 130"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "98 N. Y., 650", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [558041, 557869, 557901], "opinion_index": -1, "case_paths": ["/ny/98/0650-01", "/ny/98/0650-02", "/ny/98/0650-03"]}, {"cite": "56 N. Y., 367", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "56 S. C., 91", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503362], "opinion_index": -1, "case_paths": ["/sc/56/0091-01"]}, {"cite": "29 S. C., 322", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 156", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "238"}], "opinion_index": -1}, {"cite": "60 S. C., 153", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715410], "opinion_index": -1, "case_paths": ["/sc/60/0153-01"]}, {"cite": "49 S. C.-, 303", "category": "reporters:federal", "reporter": "S. Ct.", "opinion_index": -1}, {"cite": "33 S. C., 595", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "48 S. C., 232", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "25 S. C., 258", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 Pet., 181", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [3337824], "opinion_index": -1, "case_paths": ["/us/38/0181-01"]}, {"cite": "41 S. C., 419", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "39 S. C., 516", "category": "reporters:sta