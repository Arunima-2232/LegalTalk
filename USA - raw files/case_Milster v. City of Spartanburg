{"id": 4421118, "name": "MILSTER v. CITY OF SPARTANBURG", "name_abbreviation": "Milster v. City of Spartanburg", "decision_date": "1903-12-08", "docket_number": "", "first_page": "26", "last_page": "37", "citations": [{"type": "official", "cite": "68 S.C. 26"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "102 U. S., 472", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5629890], "opinion_index": -1, "case_paths": ["/us/102/0472-01"]}, {"cite": "88 N. C., 489", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8683316], "opinion_index": -1, "case_paths": ["/nc/88/0489-01"]}, {"cite": "2 Or., 84", "category": "reporters:state", "reporter": "Or.", "opinion_index": -1}, {"cite": "39 Tex., 396", "category": "reporters:state", "reporter": "Tex.", "case_ids": [2131196], "opinion_index": -1, "case_paths": ["/tex/39/0396-01"]}, {"cite": "63 la., 583", "category": "reporters:state", "reporter": "Iowa", "case_ids": [4371128], "opinion_index": -1, "case_paths": ["/iowa/63/0583-01"]}, {"cite": "6 S. C., 126", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4371738], "opinion_index": -1, "case_paths": ["/sc/6/0126-01"]}, {"cite": "7 Rich., 322", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "77 N. C., 4", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8681393], "opinion_index": -1, "case_paths": ["/nc/77/0004-01"]}, {"cite": "10 S. C., 299", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716159], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/10/0299-01"]}, {"cite": "16 S. C., 53", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "12 S. C., 82", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "64 S. C., 566", "category": "reporters:state", "re