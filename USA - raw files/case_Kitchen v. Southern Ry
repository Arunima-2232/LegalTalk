{"id": 4420954, "name": "KITCHEN v. SOUTHERN RY.", "name_abbreviation": "Kitchen v. Southern Ry.", "decision_date": "1904-04-21", "docket_number": "", "first_page": "554", "last_page": "568", "citations": [{"type": "official", "cite": "68 S.C. 554"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "28 S. C., 238", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4388901], "opinion_index": -1, "case_paths": ["/sc/28/0238-01"]}, {"cite": "16 S. C., 425", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 495", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 55", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C., 468", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "133 Mass., 430", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2150952], "opinion_index": -1, "case_paths": ["/mass/133/0430-01"]}, {"cite": "52 N. Y., 389", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [510960], "opinion_index": -1, "case_paths": ["/ny/52/0389-01"]}, {"cite": "23 N. Y., 158", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "71 Minn., 516", "category": "reporters:state", "reporter": "Minn.", "opinion_index": -1}, {"cite": "40 L. R. A., 133", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "60 S. C., 415", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "32 S. C., 144", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 Rich., 208", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "54 S. C., 492", "category": "reporters:state", "reporter": "S.C.", "case_ids": [44093