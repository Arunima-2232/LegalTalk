{"id": 4392111, "name": "Weathersbee v. Blanton", "name_abbreviation": "Weathersbee v. Blanton", "decision_date": "1889-07-06", "docket_number": "No. 2452", "first_page": "604", "last_page": "605", "citations": [{"type": "official", "cite": "31 S.C. 604"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 103, "char_count": 917, "ocr_confidence": 0.558, "sha256": "bc7b8371423c02403f91020d958b6fd136c7fb1a7c66201cf0d791a32392f439", "simhash": "1:f80216e05f892619", "word_count": 145}, "last_updated": "2023-07-14T21:19:28.311668+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["Weathersbee v. Blanton."], "opinions": [{"text": "Opinion by\nMr. Chief Justice Simpson,\nA testator expressed the desire that his infant daughter should be well educated, according to her degree and circumstances in life. Her guardian becoming possessed of her patrimony when she was sixteen years of age, and finding her education very deficient, expended $1,799.20 in the next five years on her maintenance and education, of which only $758.95 was income \u2014 thus showing an encroachment upon the corpus of her estate in these five years to the extent of $1,040.25.\nIn action by this ward against her guardian after site attained her majority, the Circuit Judge (Witherspoon) sustained and approved this expenditure of the corpus, and this court declared itself unwilling to say that the Circuit Judge transcended his powers. Judgment affirmed.", "type": "majority", "author": "Mr. Chief Justice Simpson,"}], "attorneys": ["Robert Aldrich, for appellant. Geo. G. Thompson, contra."], "corrections": "", "head_matter": "No. 2452.\nWeathersbee v. Blanton.\nApril Term, 1889.\nJuly 6, 1889.\nRobert Aldrich, for appellant. Geo. G. Thompson, contra."}, "file_name": "0604-02", "first_page_order": 612, "last_page_order": 613}