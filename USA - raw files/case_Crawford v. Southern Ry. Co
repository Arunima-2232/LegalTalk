{"id": 9503472, "name": "CRAWFORD v. SOUTHERN RY. CO.", "name_abbreviation": "Crawford v. Southern Ry. Co.", "decision_date": "1899-10-06", "docket_number": "", "first_page": "136", "last_page": "154", "citations": [{"type": "official", "cite": "56 S.C. 136"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "24 S. C., 497", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 S. C, 124", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C., 477", "category": "reporters:state", "reporter": "S.C.", "case_ids": [363248], "opinion_index": -1, "case_paths": ["/sc/17/0477-01"]}, {"cite": "15 S. C, 10", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715118], "opinion_index": -1, "case_paths": ["/sc/15/0010-01"]}, {"cite": "3 S. C, 251", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2340966], "opinion_index": -1, "case_paths": ["/sc/3/0251-01"]}, {"cite": "112 U. S., 261", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3508962], "opinion_index": -1, "case_paths": ["/us/112/0261-01"]}, {"cite": "22 S. C., 236", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "154 U. S., 204", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3578936], "opinion_index": -1, "case_paths": ["/us/154/0204-01"]}, {"cite": "163 U. S., 2997165", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "128 U. S., 96", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3533416], "opinion_index": -1, "case_paths": ["/us/128/0096-01"]}, {"cite": "118 U. S., 4557124", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "95 U. S., 465", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3383427], "opin