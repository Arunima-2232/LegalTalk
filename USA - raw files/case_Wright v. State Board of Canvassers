{"id": 4429245, "name": "WRIGHT v. STATE BOARD OF CANVASSERS", "name_abbreviation": "Wright v. State Board of Canvassers", "decision_date": "1907-04-22", "docket_number": "", "first_page": "574", "last_page": "593", "citations": [{"type": "official", "cite": "76 S.C. 574"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "54 S. C., 556", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409187], "opinion_index": -1, "case_paths": ["/sc/54/0556-01"]}, {"cite": "47 S. C., 66", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "12 S. C., 130", "category": "reporters:state", "reporter": "S.C.", "case_ids": [361335], "opinion_index": -1, "case_paths": ["/sc/12/0130-01"]}, {"cite": "15 la., 304", "category": "reporters:state", "reporter": "Iowa", "case_ids": [645280], "opinion_index": -1, "case_paths": ["/la/15/0304-01"]}, {"cite": "28 la., 267", "category": "reporters:state", "reporter": "Iowa", "case_ids": [2283043], "opinion_index": -1, "case_paths": ["/iowa/28/0267-01"]}, {"cite": "38 Wis., 71", "category": "reporters:state", "reporter": "Wis.", "case_ids": [8704549], "opinion_index": -1, "case_paths": ["/wis/38/0071-01"]}, {"cite": "22 Neb., 265", "category": "reporters:state", "reporter": "Neb.", "case_ids": [4410831], "opinion_index": -1, "case_paths": ["/neb/22/0265-01"]}, {"cite": "7 L. R. A., 99", "category": "reporters:federal", "reporter": "L.R.A.", "case_ids": [6034614], "opinion_index": -1, "case_paths": ["/mcgrath/1/1107\u00bd-02"]}, {"cite": "52 S. C., 298", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378514], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/52/0298-01"]}, {"cite": "57 S. C., 105", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412220], "pin_cites": [{"page": "125"}], "opinion_index": -1, "case_paths": ["/sc/