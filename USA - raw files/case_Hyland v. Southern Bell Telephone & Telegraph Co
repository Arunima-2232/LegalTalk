{"id": 4425090, "name": "HYLAND v. SOUTHERN BELL TELEPHONE AND TELEGRAPH CO.", "name_abbreviation": "Hyland v. Southern Bell Telephone & Telegraph Co.", "decision_date": "1904-12-03", "docket_number": "", "first_page": "315", "last_page": "328", "citations": [{"type": "official", "cite": "70 S.C. 315"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "63 S. C., 575", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "136 N. C., 359", "category": "reporters:state", "reporter": "N.C.", "opinion_index": -1}, {"cite": "61 S-. C., 477", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 SC., 18", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 100", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S'. C., 438", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "66 S. C., 483", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "303"}], "opinion_index": -1}, {"cite": "63 S'. C., 559", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350422], "opinion_index": -1, "case_paths": ["/sc/63/0559-01"]}, {"cite": "55 S. C., 90", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4410737], "opinion_index": -1, "case_paths": ["/sc/55/0090-01"]}, {"cite": "53 S. C., 358", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716346], "opinion_index": -1, "case_paths": ["/sc/53/0358-01"]}, {"cite": "53 S. C., 438", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "48 S. C., 364", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4406541], "opinion_index": -1, "case_paths": ["/sc/48/0364-01"]}, {"cite": "18 S'. C., 381", "category": "reporters:state", "repo