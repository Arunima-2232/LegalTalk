{"id": 1920968, "name": "STURGISS v. ATLANTIC COAST LINE R. R. CO.", "name_abbreviation": "Sturgiss v. Atlantic Coast Line R. R.", "decision_date": "1908-04-22", "docket_number": "6893", "first_page": "167", "last_page": "207", "citations": [{"type": "official", "cite": "80 S.C. 167"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "194 U. S., 269", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "73 S. C, 174", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "68 S. C, 339", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4421786], "opinion_index": -1, "case_paths": ["/sc/68/0339-01"]}, {"cite": "203 U. S-, 243", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8291925], "opinion_index": -1, "case_paths": ["/us/203/0243-01"]}, {"cite": "187 U. S., 198", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "169 U. S., 466", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3597602], "opinion_index": -1, "case_paths": ["/us/169/0466-01"]}, {"cite": "126 U. S., 181", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "125 Fed., 121", "category": "reporters:federal", "reporter": "F.", "case_ids": [65707], "opinion_index": -1, "case_paths": ["/f/125/0121-01"]}, {"cite": "66 N. E., 1006", "category": "reporters:state_regional", "reporter": "N.E.", "opinion_index": -1}, {"cite": "111 Am. St. Rep., 262", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "93 Am. St. Rep., 670", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "68 Am. St. Rep., 736", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "52 Am. St. Rep., 344", "category":