{"id": 375468, "name": "OLIVER v. COLUMBIA, NEWBERRY AND LAURENS R. R. CO.", "name_abbreviation": "Oliver v. Columbia, Newberry & Laurens R. R.", "decision_date": "1902-12-08", "docket_number": "", "first_page": "1", "last_page": "45", "citations": [{"type": "official", "cite": "65 S.C. 1"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "50 S. C., 109", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C. 72", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 505", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C., 252", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4416132], "pin_cites": [{"page": "334"}], "opinion_index": -1, "case_paths": ["/sc/62/0252-01"]}, {"cite": "34 S. C., 312", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 440", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4414776], "opinion_index": -1, "case_paths": ["/sc/59/0440-01"]}, {"cite": "58 S. C., 227", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 332", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "467"}], "opinion_index": -1}, {"cite": "51 S. C., 296", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716029], "pin_cites": [{"page": "469"}], "opinion_index": -1, "case_paths": ["/sc/51/0296-01"]}, {"cite": "52 S. C., 224", "category": "reporters:state", "reporter": "S.C.", "case_ids": [378569], "opinion_index": -1, "case_paths": ["/sc/52/0224-01"]}, {"cite": "28 S. C., 29", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4389374], "opinion_index