{"id": 4404886, "name": "LEITZSEY v. THE COLUMBIA WATER POWER COMPANY", "name_abbreviation": "Leitzsey v. Columbia Water Power Co.", "decision_date": "1896-10-17", "docket_number": "", "first_page": "464", "last_page": "485", "citations": [{"type": "official", "cite": "47 S.C. 464"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 Rich., 153", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8485869], "opinion_index": -1, "case_paths": ["/scl/45/0153-01"]}, {"cite": "5 Rich., 420", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "115 N. Y., 203", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [562815], "opinion_index": -1, "case_paths": ["/ny/115/0203-01"]}, {"cite": "38 S. C., 312", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "42 S. C., 431", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4401787], "opinion_index": -1, "case_paths": ["/sc/42/0431-01"]}, {"cite": "15 S. C., 476", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716618], "opinion_index": -1, "case_paths": ["/sc/15/0476-01"]}, {"cite": "28 S. C., 400", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 387", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 217", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 S. C., 48", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "483"}], "opinion_index": -1}, {"cite": "108 Mass., 363", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2105974], "opinion_index": -1, "case_paths": ["/mass/108/0363-01"]}, {"cite": "133 Mass., 549", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2150986], "opinion_index":