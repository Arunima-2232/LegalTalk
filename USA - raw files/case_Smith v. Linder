{"id": 1915559, "name": "SMITH v. LINDER", "name_abbreviation": "Smith v. Linder", "decision_date": "1907-08-09", "docket_number": "6622", "first_page": "535", "last_page": "546", "citations": [{"type": "official", "cite": "77 S.C. 535"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "8 Rich. Eq., 130", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713278], "opinion_index": -1, "case_paths": ["/sc-eq/29/0130-01"]}, {"cite": "2 Strob. Eq., 14", "category": "reporters:state", "reporter": "Strob. Eq.", "case_ids": [8712772], "opinion_index": -1, "case_paths": ["/sc-eq/21/0014-01"]}, {"cite": "6 Rich. Eq., 140", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [8713469], "opinion_index": -1, "case_paths": ["/sc-eq/27/0140-01"]}, {"cite": "1 Hill Eq., 410", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "40 S. C., 435", "category": "reporters:state", "reporter": "S.C.", "case_ids": [366343], "opinion_index": -1, "case_paths": ["/sc/40/0435-01"]}, {"cite": "167 U. S., 224", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3595150], "opinion_index": -1, "case_paths": ["/us/167/0224-01"]}, {"cite": "164 U. S., 255", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3591110], "opinion_index": -1, "case_paths": ["/us/164/0255-01"]}, {"cite": "2 Hill, 657", "category": "reporters:state", "reporter": "Hill,", "case_ids": [11255832], "opinion_index": -1, "case_paths": ["/scl/20/0657-01"]}, {"cite": "16 S. C., 550", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4377214], "opinion_index": -1, "case_paths": ["/sc/16/0550-01"]}, {"cite": "6 Rich. Eq., 102", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "1 Hill Ch., 217", "category": "reporters:state", "reporter": "Hill Eq.", "case_ids": [9503898], "opinion_index": -1, "case_paths": ["/sc-eq/10/0149-01"]}, {"cite": "7 Rich. Eq., 44", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "44 S. C., 378", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2347590], "opinion_index": -1, "case_paths": ["/sc/44/0378-01"]}, {"cite": "6 Rich. Eq., 145", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "1 Hill Ch., 210", "category": "reporters:state", "reporter": "Hill Eq.", "case_ids": [9503844], "pin_cites": [{"page": "387"}], "opinion_index": -1, "case_paths": ["/sc-eq/10/0145-01"]}, {"cite": "11 Rich. Eq., 39", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "1 Rich., 106", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "44 S. C., 34", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "20 S. C., 322", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Hill Ch., 251", "category": "reporters:state", "reporter": "Hill Eq.", "opinion_index": -1}, {"cite": "44 Am. Dec., 448", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "80 N. Y., 544", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2173216], "opinion_index": -1, "case_paths": ["/ny/80/0544-01"]}, {"cite": "21 N. Y., 205", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "153 N. Y., 241", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "18 S. C., 505", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "137 N. Y, 374", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "111 N. Y., 217", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "20 S. C., 333", "category": "reporters:state", "reporter": "S.C."