{"id": 1936733, "name": "IRVINE v. TOWN OF GREENWOOD", "name_abbreviation": "Irvine v. Town of Greenwood", "decision_date": "1911-10-02", "docket_number": "8015", "first_page": "511", "last_page": "525", "citations": [{"type": "official", "cite": "89 S.C. 511"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "29 S. C. 161", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4389643], "opinion_index": -1, "case_paths": ["/sc/29/0161-01"]}, {"cite": "66 S. C. 412", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "20 S. C. 412", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2341491], "opinion_index": -1, "case_paths": ["/sc/20/0412-01"]}, {"cite": "79 S. C. 363", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C. 12", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915572], "opinion_index": -1, "case_paths": ["/sc/77/0012-01"]}, {"cite": "91 Am. D. 718", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "13 Gray 59", "category": "reporters:state", "reporter": "Gray", "case_ids": [2087732], "opinion_index": -1, "case_paths": ["/mass/79/0059-01"]}, {"cite": "48 Am. St. R. 553", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "70 S. C. 142", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "66 S. C. 448", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C. 413", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4413448], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/58/0413-01"]}, {"cite": "3 S. C. 398", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "213 U. S. 151", "category": "reporters:federal", "r