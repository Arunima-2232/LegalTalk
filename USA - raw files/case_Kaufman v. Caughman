{"id": 8715333, "name": "KAUFMAN v. CAUGHMAN", "name_abbreviation": "Kaufman v. Caughman", "decision_date": "1897-04-06", "docket_number": "", "first_page": "159", "last_page": "171", "citations": [{"type": "official", "cite": "49 S.C. 159"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "6 Rich., 14", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "16 R. I., 640", "category": "reporters:state", "reporter": "R.I.", "case_ids": [4823091], "opinion_index": -1, "case_paths": ["/ri/16/0640-01"]}, {"cite": "4 Bradf., 311", "category": "reporters:state", "reporter": "Bradf.", "case_ids": [791276], "opinion_index": -1, "case_paths": ["/brad/4/0311-01"]}, {"cite": "17 Ala., 55", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3131462], "opinion_index": -1, "case_paths": ["/ala/17/0055-01"]}, {"cite": "95 U. S., 232", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3382431], "opinion_index": -1, "case_paths": ["/us/95/0232-01"]}, {"cite": "56 N. H., 227", "category": "reporters:state", "reporter": "N.H.", "case_ids": [1803605], "opinion_index": -1, "case_paths": ["/nh/56/0227-01"]}, {"cite": "27 Conn., 193", "category": "reporters:state", "reporter": "Conn.", "opinion_index": -1}, {"cite": "2 Ired., 78", "category": "reporters:state", "reporter": "Ired.", "case_ids": [8685220], "opinion_index": -1, "case_paths": ["/nc/24/0078-01"]}, {"cite": "3 Wall., Jr., C. C., 88", "category": "reporters:federal", "reporter": "Wall. Jr.", "case_ids": [6596421], "opinion_index": -1, "case_paths": ["/f-cas/24/0355-02"]}, {"cite": "52 Wis., 543", "category": "reporters:state", "reporter": "Wis.", "case_ids": [8706656], "opinion_index": -1, "case_paths": ["/wis/52/0543-01"]}, {"cite": "15 Ark., 556", "category": "reporters:state", "reporter": "Ark.", "opinion_index": -1}, {"cite"