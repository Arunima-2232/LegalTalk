{"id": 1935121, "name": "HUESTESS v. SOUTH ATLANTIC LIFE INS. CO.", "name_abbreviation": "Huestess v. South Atlantic Life Ins.", "decision_date": "1911-03-01", "docket_number": "7797", "first_page": "31", "last_page": "46", "citations": [{"type": "official", "cite": "88 S.C. 31"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "74 S. C. 374", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "50 S. C. 290", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 S. C. 338", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373591], "opinion_index": -1, "case_paths": ["/sc/61/0338-01"]}, {"cite": "84 S. C. 95", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1928030], "opinion_index": -1, "case_paths": ["/sc/84/0095-01"]}, {"cite": "91 U. S. 45", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5648982], "pin_cites": [{"page": "83, 236"}], "opinion_index": -1, "case_paths": ["/us/91/0045-01"]}, {"cite": "14 Pa. St. 496", "category": "reporters:state", "reporter": "Pa.", "opinion_index": -1}, {"cite": "77 S. C. 361", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915537], "opinion_index": -1, "case_paths": ["/sc/77/0361-01"]}, {"cite": "62 S. C. 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415818], "opinion_index": -1, "case_paths": ["/sc/62/0001-01"]}, {"cite": "77 S. C. 187", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1915520], "opinion_index": -1, "case_paths": ["/sc/77/0187-01"]}, {"cite": "83 S. C. 264", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "52 S. C. 228", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C. 457", "category": "reporters:state", "reporter": "S.C.", "cas