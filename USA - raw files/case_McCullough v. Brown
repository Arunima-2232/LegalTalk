{"id": 4401176, "name": "McCULLOUGH v. BROWN; STATE v. JACOBS; SAME v. TROEGER; SAME v. FAGAN; SAME v. BYRD; SAME v. DAVID", "name_abbreviation": "McCullough v. Brown", "decision_date": "1894-04-19", "docket_number": "", "first_page": "220", "last_page": "285", "citations": [{"type": "official", "cite": "41 S.C. 220"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "39 S. C., 301", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4394346], "opinion_index": -1, "case_paths": ["/sc/33/0001-01"]}, {"cite": "39 S. C., 307", "category": "reporters:state", "reporter": "S.C.", "case_ids": [364830], "opinion_index": 0, "case_paths": ["/sc/39/0307-01"]}, {"cite": "11 Wall, 113", "category": "reporters:scotus_early", "reporter": "Wall,", "case_ids": [3412793], "opinion_index": 0, "case_paths": ["/us/78/0113-01"]}, {"cite": "12 Wheat., 419", "category": "reporters:scotus_early", "reporter": "Wheat.", "case_ids": [1429870], "opinion_index": 0, "case_paths": ["/us/25/0419-01"]}, {"cite": "4 Wheat., 316", "category": "reporters:scotus_early", "reporter": "Wheat.", "case_ids": [4702], "opinion_index": 0, "case_paths": ["/us/17/0316-01"]}, {"cite": "15 Am. Rep., 45", "category": "reporters:state_regional", "reporter": "Am. Rep.", "opinion_index": 0}, {"cite": "111 Mass., 454", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2113065], "opinion_index": 0, "case_paths": ["/mass/111/0454-01"]}, {"cite": "11 Am. Rep., 185", "category": "reporters:state_regional", "reporter": "Am. Rep.", "opinion_index": 0}, {"cite": "60 Me., 124", "category": "reporters:state", "reporter": "Me.", "case_ids": [661031], "opinion_index": 0, "case_paths": ["/me/60/0124-01"]}, {"cite": "23 S. C., 57", "category": "reporters:state", "repor