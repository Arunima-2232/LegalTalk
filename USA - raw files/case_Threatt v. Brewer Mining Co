{"id": 8715242, "name": "THREATT v. BREWER MINING CO.", "name_abbreviation": "Threatt v. Brewer Mining Co.", "decision_date": "1897-03-31", "docket_number": "", "first_page": "95", "last_page": "135", "citations": [{"type": "official", "cite": "49 S.C. 95"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 S. C., 447", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "9 S. C., 147", "category": "reporters:state", "reporter": "S.C.", "case_ids": [356604], "opinion_index": -1, "case_paths": ["/sc/9/0147-01"]}, {"cite": "14 S. C., 246", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "8 Rich. Eq., 54", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "18 S. C., 604", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4379007, 4379617, 4379463], "opinion_index": -1, "case_paths": ["/sc/18/0604-03", "/sc/18/0604-01", "/sc/18/0604-02"]}, {"cite": "8 S. C., 262", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "38 S. C., 290", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C., 66", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4380255], "pin_cites": [{"page": "525"}], "opinion_index": -1, "case_paths": ["/sc/19/0066-01"]}, {"cite": "17 S. C., 71", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "42 S. C., 414", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "5 Rich., 421", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "11 Rich., 217", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8485947], "opinion_index": -1, "case_paths": ["/scl/45/0217-01"]}, {"cite": "22 S. C., 479", "category": "reporters:sta