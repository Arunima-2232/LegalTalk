{"id": 4386588, "name": "Raysor v. Berkeley County Railway and Lumber Company", "name_abbreviation": "Raysor v. Berkeley County Railway & Lumber Co.", "decision_date": "1887-03-19", "docket_number": "No. 2020", "first_page": "610", "last_page": "610", "citations": [{"type": "official", "cite": "26 S.C. 610"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 98, "char_count": 879, "ocr_confidence": 0.475, "sha256": "88e8f80e0590e860d9b64199ab36720c72e75e238109ff9464bd71c2998e2da1", "simhash": "1:7fdf4f9ecfc65548", "word_count": 155}, "last_updated": "2023-07-14T18:25:44.487885+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["Raysor v. Berkeley County Railway and Lumber Company."], "opinions": [{"text": "Opinion by\nMr. Justice McGowan,\nPlaintiff was employed by defendant at a salary of $100 a month. Prior to January, 1886, he demanded of the superintendent an increase of $25 a month, after January, or he would leave. The superintendent promised an answer in a few days, but did not answer for several months, when he informed plaintiff that his salary had been increased to $125 a month from May 1. This was an action to recover $75 \u2014 from February 1 to May 1 \u2014 the balance of salary having been paid. The claim was sustained by the trial justice, and by Judge Witherspoon on appeal to the Circuit Court. This court reversed the judgment below, holding that there was no assent by defendant to the increase of salary sued for.", "type": "majority", "author": "Mr. Justice McGowan,"}], "attorneys": ["G. P. Garrere, for appellant.", "G. W. Boyle, contra."], "corrections": "", "head_matter": "No. 2020.\nRaysor v. Berkeley County Railway and Lumber Company.\nNovember Term, 1886.\nMarch 19, 1887.\nG. P. Garrere, for appellant.\nG. W. Boyle, contra."}, "file_name": "0610-01", "first_page_order": 620, "last_page_order": 620}