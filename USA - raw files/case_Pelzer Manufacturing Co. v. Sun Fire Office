{"id": 8715768, "name": "1. PELZER MANUFACTURING COMPANY v. SUN FIRE OFFICE; 2. SAME v. GERMAN AMERICAN INSURANCE CO.; 3. SAME v. HIBERNIA INSURANCE COMPANY; 4. SAME v. SAME; 5. SAME v. HAMBURG-BREMEN INSURANCE CO.; 6. SAME v. SAME; 7. SAME v. SOUTHERN INSURANCE COMPANY; 8. SAME v. SAME; 9. SAME v. AMERICAN FIRE INSURANCE CO.; 10. SAME v. SAME", "name_abbreviation": "Pelzer Manufacturing Co. v. Sun Fire Office", "decision_date": "1892-04-21", "docket_number": "", "first_page": "213", "last_page": "273", "citations": [{"type": "official", "cite": "36 S.C. 213"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "2 N. Y. Supp., 365", "category": "reporters:state", "reporter": "N.Y.S.", "case_ids": [5399386], "opinion_index": -1, "case_paths": ["/nys/2/0365-01"]}, {"cite": "18 N. Y., 777", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "62 Pa., 83", "category": "reporters:state", "reporter": "Pa.", "case_ids": [1017202], "opinion_index": -1, "case_paths": ["/pa/62/0083-01"]}, {"cite": "8 Am. Rep., 526", "category": "reporters:state_regional", "reporter": "Am. Rep.", "opinion_index": -1}, {"cite": "48 N. Y., 132", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2055484], "opinion_index": -1, "case_paths": ["/ny/48/0132-01"]}, {"cite": "17 Am. Rep., 69", "category": "reporters:state_regional", "reporter": "Am. Rep.", "opinion_index": -1}, {"cite": "112 Miss., 71", "category": "reporters:state", "reporter": "Miss.", "opinion_index": -1}, {"cite": "11 Gray, 163", "category": "reporters:state", "reporter": "Gray", "case_ids": [2084868], "opinion_index": -1, "case_paths": ["/mass/77/0163-01"]}, {"cite": "62 N. Y., 47", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2160491], "opinion_index": -1, "case_paths": ["/ny/62/0047-01"]}, {"cite": "10 Pet. 507", "category": "r