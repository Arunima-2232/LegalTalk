{"id": 1928027, "name": "EX PARTE CAROLINA, CLINCHFIELD & OHIO RAILWAY v. R. M. McCOWN, SECRETARY OF STATE", "name_abbreviation": "Carolina, Clinchfield & Ohio Railway v. McCown", "decision_date": "1909-11-27", "docket_number": "7393", "first_page": "318", "last_page": "343", "citations": [{"type": "official", "cite": "84 S.C. 318"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "82 S. C., 127", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1924745], "opinion_index": -1, "case_paths": ["/sc/82/0127-01"]}, {"cite": "64 S. C., 164", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 246", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716187], "opinion_index": -1, "case_paths": ["/sc/53/0246-01"]}, {"cite": "166 Fed., 850", "category": "reporters:federal", "reporter": "F.", "case_ids": [6725478], "opinion_index": -1, "case_paths": ["/f/166/0850-01"]}, {"cite": "107 U. S., 581", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3499692], "opinion_index": -1, "case_paths": ["/us/107/0581-01"]}, {"cite": "190 U. S., 226", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "161 U. S., 562", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "161 U. S., 545", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5701404], "opinion_index": -1, "case_paths": ["/us/161/0545-01"]}, {"cite": "48 S. C., 52", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 52", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "157 U. S., 1", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3584354], "opinion_index": -1, "case_paths": ["/us/157/0001-01"]}, {"cite": "54 N. Y., 43", "category"