{"id": 1917206, "name": "V. P. RANDOLPH & CO. v. WALKER", "name_abbreviation": "V. P. Randolph & Co. v. Walker", "decision_date": "1907-09-11", "docket_number": "6652", "first_page": "157", "last_page": "166", "citations": [{"type": "official", "cite": "78 S.C. 157"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "45 S. C., 373", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368957], "opinion_index": -1, "case_paths": ["/sc/45/0373-01"]}, {"cite": "1 Rawle, 330", "category": "reporters:state", "reporter": "Rawle", "case_ids": [1819317], "opinion_index": -1, "case_paths": ["/rawle/1/0330-01"]}, {"cite": "57 S. C., 151", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4412460], "opinion_index": -1, "case_paths": ["/sc/57/0151-01"]}, {"cite": "89 Am. D., 483", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "30 S. C., 127", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "90 Am. D., 24", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "30 Am. D., 681", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "12 Am. D., 153", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "30 S. C., 126", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392118], "opinion_index": -1, "case_paths": ["/sc/30/0126-01"]}, {"cite": "20 S. C., 535", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "71 S. C., 33", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "50 S. C., 537", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408192], "opinion_index": -1, "case_paths": ["/sc/50/0537-01"]}, {"cite": "73 S. C., 36", "category": "reporters