{"id": 4404471, "name": "AVERY & SON v. WILSON", "name_abbreviation": "Avery v. Wilson", "decision_date": "1896-07-11", "docket_number": "", "first_page": "78", "last_page": "101", "citations": [{"type": "official", "cite": "47 S.C. 78"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "43 S. C., 342", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346235], "opinion_index": -1, "case_paths": ["/sc/43/0342-01"]}, {"cite": "31 S. C., 36", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392155], "opinion_index": -1, "case_paths": ["/sc/31/0036-01"]}, {"cite": "1 Hill, 25", "category": "reporters:state", "reporter": "Hill,", "opinion_index": -1}, {"cite": "31 S. C., 147", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392786], "opinion_index": -1, "case_paths": ["/sc/31/0147-01"]}, {"cite": "27 S. C., 285", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "40 S. C., 437", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 S. C., 446", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Bail., 328", "category": "reporters:state", "reporter": "Bail.", "opinion_index": -1}, {"cite": "32 S. C., 171", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346449], "opinion_index": -1, "case_paths": ["/sc/32/0171-01"]}, {"cite": "23 S. C., 94", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 472", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "473"}], "opinion_index": -1}, {"cite": "31 S. C., 150", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "16 S. C., 633", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 546", "categor