{"id": 4421298, "name": "CARSON v. SOUTHERN RY.", "name_abbreviation": "Carson v. Southern Ry.", "decision_date": "1903-12-26", "docket_number": "", "first_page": "55", "last_page": "88", "citations": [{"type": "official", "cite": "68 S.C. 55"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "19 S. E., 262", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "6 L. R. A., 484", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "61 S. C., 96", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "118 U. S., 264", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3519822], "opinion_index": -1, "case_paths": ["/us/118/0264-01"]}, {"cite": "117 U. S., 275", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8299757], "opinion_index": -1, "case_paths": ["/us/117/0275-01"]}, {"cite": "37 S. C., 380", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Pet., 46", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [1432412], "opinion_index": -1, "case_paths": ["/us/26/0046-01"]}, {"cite": "115 U. S., 41", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3514899], "weight": 2, "opinion_index": -1, "case_paths": ["/us/115/0041-01"]}, {"cite": "114 U. S., 52", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [11292832], "opinion_index": -1, "case_paths": ["/us/114/0052-01"]}, {"cite": "11 Am. St. R., 905", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "94 U. S., 469", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [5643926], "opinion_index": -1, "case_paths": ["/us/94/0469-01"]}, {"cite": "58 S. C., 493", "category": "reporters:state", "reporter": "S.C.", "