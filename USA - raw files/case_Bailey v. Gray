{"id": 8716737, "name": "BAILEY & SON v. GRAY", "name_abbreviation": "Bailey v. Gray", "decision_date": "1898-11-04", "docket_number": "", "first_page": "503", "last_page": "519", "citations": [{"type": "official", "cite": "53 S.C. 503"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "22 S. C., 545", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "122 Mass., 122", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2134598], "opinion_index": -1, "case_paths": ["/mass/122/0122-01"]}, {"cite": "146 Ill., 481", "category": "reporters:state", "reporter": "Ill.", "case_ids": [3066557], "opinion_index": -1, "case_paths": ["/ill/146/0481-01"]}, {"cite": "19 Ohio St., 135", "category": "reporters:state", "reporter": "Ohio St.", "case_ids": [882948], "opinion_index": -1, "case_paths": ["/ohio-st/19/0135-01"]}, {"cite": "115 Mass., 204", "category": "reporters:state", "reporter": "Mass.", "case_ids": [717907], "opinion_index": -1, "case_paths": ["/mass/115/0204-01"]}, {"cite": "5 Rich., 311", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8484295], "opinion_index": -1, "case_paths": ["/scl/39/0311-01"]}, {"cite": "68 N. Y., 62", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [529020], "opinion_index": -1, "case_paths": ["/ny/68/0062-01"]}, {"cite": "14 Am. St. R., 550", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "4 Miss., 367", "category": "reporters:state", "reporter": "Miss.", "opinion_index": -1}, {"cite": "21 S. C., 224", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "61 A. D., 276", "category": "reporters:state", "reporter": "A.D.", "opinion_index": -1}, {"cite": "54 A. D., 668", "category": "reporters:state", "reporter": "A.D.", "opinion_index": -1}, {"cite": "1 M