{"id": 1919651, "name": "STATE v. MILLS", "name_abbreviation": "State v. Mills", "decision_date": "1908-02-25", "docket_number": "6768", "first_page": "187", "last_page": "198", "citations": [{"type": "official", "cite": "79 S.C. 187"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "55 S'. C., 100", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "47 S. C., 488", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4404667], "opinion_index": -1, "case_paths": ["/sc/47/0488-01"]}, {"cite": "58 S. C., 380", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "59 S. C., 246", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4415120], "pin_cites": [{"page": "303"}], "opinion_index": -1, "case_paths": ["/sc/59/0246-01"]}, {"cite": "26 S. C., 119", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 533", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 368", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "576"}], "opinion_index": -1}, {"cite": "43 S. C., 148", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "68 S. C., 500", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "73 S. C., 518", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "75 S. C., 296", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 S. C., 250", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 378", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503848], "opinion_index": -1, "case_paths": ["/sc/56/0378-01"]}, {"cite": "58 S. C., 335", "category": "reporters:state",