{"id": 1936754, "name": "JONES v. A. H. WILLIAMS & CO.", "name_abbreviation": "Jones v. A. H. Williams & Co.", "decision_date": "1911-11-07", "docket_number": "8027", "first_page": "574", "last_page": "584", "citations": [{"type": "official", "cite": "89 S.C. 574"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "64 S. C. 338", "category": "reporters:state", "reporter": "S.C.", "case_ids": [381944], "opinion_index": -1, "case_paths": ["/sc/64/0338-01"]}, {"cite": "88 S. C. 302", "category": "reporters:state", "reporter": "S.C.", "case_ids": [1935193], "pin_cites": [{"page": "333"}], "opinion_index": -1, "case_paths": ["/sc/88/0302-01"]}, {"cite": "32 S. C. 142", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346254], "opinion_index": -1, "case_paths": ["/sc/32/0142-01"]}, {"cite": "51 S. C. 412", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716484], "opinion_index": -1, "case_paths": ["/sc/51/0412-01"]}, {"cite": "39 S. C. 223", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "86 S. C. 102", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "30 S. C. 564", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4391395], "opinion_index": -1, "case_paths": ["/sc/30/0564-01"]}, {"cite": "27 S. C. 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387559], "opinion_index": -1, "case_paths": ["/sc/27/0001-01"]}, {"cite": "18 S. C. 315", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C. 560", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4380502], "opinion_index": -1, "case_paths": ["/sc/19/0560-01"]}, {"cite": "13 S. C. 21", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "397"}], "opinion_index": -1}, {"cite": "10