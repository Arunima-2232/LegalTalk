{"id": 1932995, "name": "SOVEREIGN CAMP OF THE WOODMEN OF THE WORLD v. MEANS", "name_abbreviation": "Sovereign Camp of the Woodmen of the World v. Means", "decision_date": "1910-10-14", "docket_number": "7685", "first_page": "127", "last_page": "135", "citations": [{"type": "official", "cite": "87 S.C. 127"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "1 Hill 263", "category": "reporters:state", "reporter": "Hill", "opinion_index": -1}, {"cite": "46 S. C. 474", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348641], "opinion_index": -1, "case_paths": ["/sc/46/0474-01"]}, {"cite": "51 S. C. 333", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716246], "opinion_index": -1, "case_paths": ["/sc/51/0333-01"]}, {"cite": "52 S. C. 171", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "35 S. C. 613", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396203], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/35/0613-01"]}, {"cite": "47 S. C. 525", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4404855], "weight": 2, "opinion_index": -1, "case_paths": ["/sc/47/0525-01"]}, {"cite": "24 How. 341", "category": "reporters:scotus_early", "reporter": "How.", "opinion_index": -1}, {"cite": "9 S. C. 582", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "4 S. C. 45", "category": "reporters:state", "reporter": "S.C.", "case_ids": [351711], "opinion_index": -1, "case_paths": ["/sc/4/0045-01"]}, {"cite": "42 S. C. 357", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4402257], "opinion_index": -1, "case_paths": ["/sc/42/0357-01"]}, {"cite": "18 S. C. 352", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "58 S. C. 280", "category": "reporters:state", "rep