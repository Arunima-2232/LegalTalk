{"id": 378577, "name": "THE SOUTH CAROLINA TERMINAL CO. v. SOUTH CAROLINA AND GEORGIA RAILROAD CO.", "name_abbreviation": "South Carolina Terminal Co. v. South Carolina & Georgia Railroad", "decision_date": "1898-03-24", "docket_number": "", "first_page": "1", "last_page": "25", "citations": [{"type": "official", "cite": "52 S.C. 1"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "70 Ala., 52", "category": "reporters:state", "reporter": "Ala.", "opinion_index": -1}, {"cite": "7 Rich., 354", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "6 Rich., 353", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "2 Daly, 298", "category": "reporters:state", "reporter": "Daly", "opinion_index": -1}, {"cite": "15 Am. Dec., 543", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "3 McLean, 431", "category": "reporters:federal", "reporter": "McLean", "case_ids": [6630851], "opinion_index": -1, "case_paths": ["/f-cas/15/0763-01"]}, {"cite": "3 Pet., 43", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [3305559], "opinion_index": -1, "case_paths": ["/us/28/0043-01"]}, {"cite": "27 S. C., 559", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Rich., 434", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486968], "opinion_index": -1, "case_paths": ["/scl/37/0434-01"]}, {"cite": "42 S. C., 434", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "38 S. C., 312", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C-, 483", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "11 Mass., 536", "category": "reporters:state", "reporter": "Mass.", "opinion_index": -1}, {"c