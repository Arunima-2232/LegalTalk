{"id": 2352544, "name": "McCARLEY v. GLENN-LOWRY MFG. CO.", "name_abbreviation": "McCarley v. Glenn-Lowry Mfg. Co.", "decision_date": "1906-11-23", "docket_number": "", "first_page": "390", "last_page": "409", "citations": [{"type": "official", "cite": "75 S.C. 390"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "48 S. C., 190", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4406306], "weight": 3, "opinion_index": -1, "case_paths": ["/sc/48/0190-01"]}, {"cite": "46 S. C., 104", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348376], "opinion_index": -1, "case_paths": ["/sc/46/0104-01"]}, {"cite": "45 S. C., 283", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368977], "opinion_index": -1, "case_paths": ["/sc/45/0283-01"]}, {"cite": "66 S. C., 302", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4417738], "opinion_index": -1, "case_paths": ["/sc/66/0302-01"]}, {"cite": "71 S. C., 61", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "8"}], "opinion_index": -1}, {"cite": "25 S. C., 446", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716797], "opinion_index": -1, "case_paths": ["/sc/25/0446-01"]}, {"cite": "37 S. C., 42", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4396957], "opinion_index": -1, "case_paths": ["/sc/37/0042-01"]}, {"cite": "22 S. C., 557", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4381634], "opinion_index": -1, "case_paths": ["/sc/22/0557-01"]}, {"cite": "69 S. C., 392", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S. C., 528", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "60 S. C., 9", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8714902], "weight": 2, "opinio