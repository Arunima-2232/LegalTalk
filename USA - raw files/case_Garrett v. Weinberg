{"id": 4414794, "name": "GARRETT v. WEINBERG", "name_abbreviation": "Garrett v. Weinberg", "decision_date": "1900-12-08", "docket_number": "", "first_page": "162", "last_page": "194", "citations": [{"type": "official", "cite": "59 S.C. 162"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "13 Rich. Eq., 223", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "11 S. C., 54", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "2 Hill, 493", "category": "reporters:state", "reporter": "Hill,", "opinion_index": -1}, {"cite": "22 S. C., 132", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "57 S. C., 12", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "15 Rich., 312", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486224], "opinion_index": -1, "case_paths": ["/scl/49/0312-01"]}, {"cite": "9 Rich., 106", "category": "reporters:state", "reporter": "Rich.", "case_ids": [2514382], "opinion_index": -1, "case_paths": ["/scl/43/0106-01"]}, {"cite": "2 Bail., 576", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2513010], "opinion_index": -1, "case_paths": ["/scl/18/0576-01"]}, {"cite": "54 S. C., 154", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "40 S. C., 89", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 S. C., 105", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "23 S..C., 231", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 215", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C., 263", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9503624], "opini