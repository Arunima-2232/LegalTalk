{"id": 1924913, "name": "ANCRUM v. CAMDEN WATER, LIGHT AND ICE CO.", "name_abbreviation": "Ancrum v. Camden Water, Light & Ice Co.", "decision_date": "1909-04-09", "docket_number": "7135", "first_page": "284", "last_page": "299", "citations": [{"type": "official", "cite": "82 S.C. 284"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "69 S. C., 434", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422591], "opinion_index": -1, "case_paths": ["/sc/69/0434-01"]}, {"cite": "61 S. C., 83", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373629], "opinion_index": -1, "case_paths": ["/sc/61/0083-01"]}, {"cite": "44 Am. St. R., 43", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "61 S. E., 884", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "7 L. R. A. (N. S.), 917", "category": "reporters:federal", "reporter": "L.R.A.N.S.", "opinion_index": -1}, {"cite": "36 L. R. A., 535", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "6 L. R. A. (N. S.), 1171", "category": "reporters:federal", "reporter": "L.R.A.N.S.", "opinion_index": -1}, {"cite": "81 Wis., 48", "category": "reporters:state", "reporter": "Wis.", "case_ids": [8701996], "opinion_index": -1, "case_paths": ["/wis/81/0048-01"]}, {"cite": "6 Mich. L. Rev., 455", "category": "journals:journal", "reporter": "Mich. L. Rev.", "opinion_index": -1}, {"cite": "48 Kan., 12", "category": "reporters:state", "reporter": "Kan.", "case_ids": [1114010], "opinion_index": -1, "case_paths": ["/kan/48/0012-01"]}, {"cite": "37 Neb., 146", "category": "reporters:state", "reporter": "Neb.", "opinion_index": -1}, {"cite": "94 Fed., 238", "category": "reporters:federal", "reporter": "F.", "case_ids": [6751332], "opinion_index": -1, "case_paths":