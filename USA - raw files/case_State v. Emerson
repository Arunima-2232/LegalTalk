{"id": 1917223, "name": "STATE v. EMERSON", "name_abbreviation": "State v. Emerson", "decision_date": "1907-09-06", "docket_number": "6641", "first_page": "83", "last_page": "103", "citations": [{"type": "official", "cite": "78 S.C. 83"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "75 S. C., 510", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "28 S. C., 36", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "24 S. C., 283", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4385096], "opinion_index": -1, "case_paths": ["/sc/24/0283-01"]}, {"cite": "33 S. C., 99", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "49 S. C., 285", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715763], "opinion_index": -1, "case_paths": ["/sc/49/0285-01"]}, {"cite": "75 S. C., 544", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "83 Ga., 744", "category": "reporters:state", "reporter": "Ga.", "case_ids": [73422], "opinion_index": -1, "case_paths": ["/ga/83/0744-01"]}, {"cite": "43 S. C., 217", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "43 S. C., 107", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 Pac., 1113", "category": "reporters:state_regional", "reporter": "P.", "opinion_index": -1}, {"cite": "52 Am. St. R., 717", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "51 S. C., 69", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "30 S. C., 490", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4392010], "opinion_index": -1, "case_paths": ["/sc/30/0490-01"]}, {"cite": "32 S. C., 410", "category": "reporters:s