{"id": 1922988, "name": "TRIMMIER v. ATLANTA AND CHARLOTTE AIR LINE RY.", "name_abbreviation": "Trimmier v. Atlanta & Charlotte Air Line Ry.", "decision_date": "1908-09-01", "docket_number": "6999", "first_page": "203", "last_page": "214", "citations": [{"type": "official", "cite": "81 S.C. 203"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "57 S. C., 395", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4411800], "opinion_index": -1, "case_paths": ["/sc/57/0395-01"]}, {"cite": "66 S. C., 302", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4417738], "opinion_index": -1, "case_paths": ["/sc/66/0302-01"]}, {"cite": "47 S. C., 375", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4404539], "opinion_index": -1, "case_paths": ["/sc/47/0375-01"]}, {"cite": "29 S. C., 303", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4390503], "opinion_index": -1, "case_paths": ["/sc/29/0303-01"]}, {"cite": "58 S. C., 77", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "68 S. C., 86", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "76 S. C., 202", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429294], "opinion_index": -1, "case_paths": ["/sc/76/0202-01"]}, {"cite": "75 S. C., 92", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "293"}], "opinion_index": -1}, {"cite": "74 S. C., 135", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "72 S. C., 1", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4426639], "opinion_index": -1, "case_paths": ["/sc/72/0001-01"]}, {"cite": "54 S. C., 505", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "64 S. C., 8", "category": "reporters:state", "rep