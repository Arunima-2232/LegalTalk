{"id": 361323, "name": "G. M. WALKER, CASHIER, v. THE STATE OF SOUTH CAROLINA; F. J. PELZER v. THE SAME; EDWARD SEBRING v. THE SAME; THE BANK OF CHARLESTON N. B. A. v. THE SAME; THE W. L. I. CHARITABLE ASSOCIATION v. THE SAME; F. J. HERRON v. THE SAME", "name_abbreviation": "Walker v. State", "decision_date": "1879-09-29", "docket_number": "CASE No. 760", "first_page": "200", "last_page": "313", "citations": [{"type": "official", "cite": "12 S.C. 200"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "96 U. S. 60", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "15 Cal. 236", "category": "reporters:state", "reporter": "Cal.", "opinion_index": -1}, {"cite": "94 U. S. 205", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "16 Wall. 11", "category": "reporters:scotus_early", "reporter": "Wall.", "opinion_index": -1}, {"cite": "5 Wall. 784", "category": "reporters:scotus_early", "reporter": "Wall.", "opinion_index": -1}, {"cite": "1 Wall. 175", "category": "reporters:scotus_early", "reporter": "Wall.", "case_ids": [3472079], "opinion_index": -1, "case_paths": ["/us/68/0175-01"]}, {"cite": "1 Wall. 393", "category": "reporters:scotus_early", "reporter": "Wall.", "opinion_index": -1}, {"cite": "1 Wall. 83", "category": "reporters:scotus_early", "reporter": "Wall.", "case_ids": [3470921], "opinion_index": -1, "case_paths": ["/us/68/0083-01"]}, {"cite": "24 How. 288", "category": "reporters:scotus_early", "reporter": "How.", "opinion_index": -1}, {"cite": "21 How. 540", "category": "reporters:scotus_early", "reporter": "How.", "opinion_index": -1}, {"cite": "14 Wall. 296", "category": "reporters:scotus_early", "reporter": "Wall.", "opinion_index": -1}, {"cite": "96 US. 432", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3381586], "opinion_in