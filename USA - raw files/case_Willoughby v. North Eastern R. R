{"id": 378573, "name": "WILLOUGHBY v. NORTH EASTERN R. R. CO.", "name_abbreviation": "Willoughby v. North Eastern R. R.", "decision_date": "1898-03-28", "docket_number": "", "first_page": "166", "last_page": "176", "citations": [{"type": "official", "cite": "52 S.C. 166"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "51 S. C., 55", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715063], "opinion_index": -1, "case_paths": ["/sc/51/0055-01"]}, {"cite": "47 S. C., 91", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. C., 101", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "45 S. C., 244", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "43 S. C., 99", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "40 S. C., 88", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "366, 537"}], "opinion_index": -1}, {"cite": "30 S. C., 170", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "50 S. C., 129", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408100], "opinion_index": -1, "case_paths": ["/sc/50/0129-01"]}, {"cite": "46 S. C., 550", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348678], "opinion_index": -1, "case_paths": ["/sc/46/0550-01"]}, {"cite": "44 S. C., 288", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "47 S. C., 488", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4404667], "opinion_index": -1, "case_paths": ["/sc/47/0488-01"]}, {"cite": "50 S. C., 218", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4407543], "opinion_index": -1, "case_paths": ["/sc/50/0218-01"]}, {"cite": "27 S. C., 459", "category"