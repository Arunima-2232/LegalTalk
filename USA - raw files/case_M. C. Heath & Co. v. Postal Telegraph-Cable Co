{"id": 1932998, "name": "M. C. HEATH & CO. v. POSTAL TELEGRAPH-CABLE CO.", "name_abbreviation": "M. C. Heath & Co. v. Postal Telegraph-Cable Co.", "decision_date": "1910-11-07", "docket_number": "7709", "first_page": "219", "last_page": "239", "citations": [{"type": "official", "cite": "87 S.C. 219"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "107 S. W. 560", "category": "reporters:state_regional", "reporter": "S.W.", "opinion_index": -1}, {"cite": "60 S. E. 355", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "75 S. C. 526", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "56 S. C. 148", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "19 S. C. 364", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "72 S. C. 531", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "526"}], "opinion_index": -1}, {"cite": "19 Am. St. R. 55", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "72 S. C. 116", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4426213], "opinion_index": -1, "case_paths": ["/sc/72/0116-01"]}, {"cite": "71 S. C. 85", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "48 Fed. 810", "category": "reporters:federal", "reporter": "F.", "case_ids": [6722194, 6722141], "opinion_index": -1, "case_paths": ["/f/48/0810-02", "/f/48/0810-01"]}, {"cite": "32 Barb. 530", "category": "reporters:state", "reporter": "Barb.", "case_ids": [5050482], "weight": 2, "opinion_index": -1, "case_paths": ["/barb/32/0530-01"]}, {"cite": "29 Ind. 243", "category": "reporters:state", "reporter": "Ind.", "opinion_index": -1}, {"cite": "71 S. C. 211", "category": "reporters:state", "reporter