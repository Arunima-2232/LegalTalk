{"id": 8716056, "name": "IN RE ESTATE OF MAYO", "name_abbreviation": "In re Estate of Mayo", "decision_date": "1901-04-18", "docket_number": "", "first_page": "401", "last_page": "426", "citations": [{"type": "official", "cite": "60 S.C. 401"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "20 S. C., 154", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "5 Fed. R., 523", "category": "reporters:federal", "reporter": "F.", "case_ids": [3752485], "opinion_index": -1, "case_paths": ["/f/5/0523-01"]}, {"cite": "41 S. C., 18", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 276", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4393098], "opinion_index": -1, "case_paths": ["/sc/33/0276-01"]}, {"cite": "38 S. C., 45", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "6 Rich. Eq., 380", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "102 U. S., 443", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "102 Mass., 186", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2142843], "opinion_index": -1, "case_paths": ["/mass/102/0186-01"]}, {"cite": "65 la., 729", "category": "reporters:state", "reporter": "Iowa", "opinion_index": -1}, {"cite": "36 Conn., 213", "category": "reporters:state", "reporter": "Conn.", "case_ids": [782585], "opinion_index": -1, "case_paths": ["/conn/36/0213-01"]}, {"cite": "68 Mich., 146", "category": "reporters:state", "reporter": "Mich.", "opinion_index": -1}, {"cite": "35 Am. Dec., 486", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "2 Bail., 437", "category": "reporters:state", "reporter": "Bail.", "opinion_index": -1}, {"cite": "58 S. C., 469", "catego