{"id": 4404360, "name": "THE STATE v. RICHARDSON", "name_abbreviation": "State v. Richardson", "decision_date": "1896-07-16", "docket_number": "", "first_page": "166", "last_page": "176", "citations": [{"type": "official", "cite": "47 S.C. 166"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "5 Iowa, 288", "category": "reporters:state", "reporter": "Iowa", "opinion_index": -1}, {"cite": "5 Cold., 311", "category": "reporters:state", "reporter": "Cold.", "case_ids": [8540666], "opinion_index": -1, "case_paths": ["/tenn/45/0311-01"]}, {"cite": "20 Pick., 365", "category": "reporters:state", "reporter": "Pick.", "opinion_index": -1}, {"cite": "23 Pa. St., 12", "category": "reporters:state", "reporter": "Pa.", "case_ids": [974071], "opinion_index": -1, "case_paths": ["/pa/23/0012-01"]}, {"cite": "5 Ind., 292", "category": "reporters:state", "reporter": "Ind.", "opinion_index": -1}, {"cite": "17 Wend., 386", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2020988], "opinion_index": -1, "case_paths": ["/wend/17/0218-01"]}, {"cite": "2 Yerg., 24", "category": "reporters:state", "reporter": "Yer.", "case_ids": [11265588], "opinion_index": -1, "case_paths": ["/tenn/10/0024-01"]}, {"cite": "2 Rich., 218", "category": "reporters:state", "reporter": "Rich.", "opinion_index": -1}, {"cite": "12 Cush., 247", "category": "reporters:state", "reporter": "Cush.", "opinion_index": -1}, {"cite": "11 Gray, 237", "category": "reporters:state", "reporter": "Gray", "opinion_index": -1}, {"cite": "149 Mass., 7", "category": "reporters:state", "reporter": "Mass.", "case_ids": [778405], "opinion_index": -1, "case_paths": ["/mass/149/0007-01"]}, {"cite": "53 Miss., 439", "category": "reporters:state", "reporter": "Miss.", "case_ids": [1670056], "opinion_index": -1, "case_paths": ["/miss/53/0439-01"]}, {"cite": "105 Pa. St., 1", "cate