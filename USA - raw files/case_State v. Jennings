{"id": 366340, "name": "State v. Jennings", "name_abbreviation": "State v. Jennings", "decision_date": "1894-01-15", "docket_number": "No. 3275", "first_page": "553", "last_page": "553", "citations": [{"type": "official", "cite": "40 S.C. 553"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 87, "char_count": 848, "ocr_confidence": 0.483, "sha256": "6d6b8cb8cac8c95d1bcf67bea3e1b633f2a0d819cd7795df87f0223cbf8a77b6", "simhash": "1:47881b787d551d51", "word_count": 149}, "last_updated": "2023-07-14T20:51:14.593960+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["State v. Jennings,"], "opinions": [{"text": "This was a motion which was refused by the following order of\nPee Oubiam.\nThe defendant in this case having been convicted of murder, and having perfected his appeal from the judgment of the Circuit Court, now moves to suspend the appeal for the purpose of enabling him to move for a new trial in the Circuit Court upon the ground of after-discovered evidence. Under the well settled practice of this court, it is necessary that the appellant should make such a prima facie showing as would satisfy this court that this was a proper case for the granting of the motion submitted by the appellant. After a careful consideration of the affidavits upon which the motion is made, we cannot say that such a showing has been made. It is, therefore, ordered, that the motion be refused.", "type": "majority", "author": "Pee Oubiam."}], "attorneys": [], "corrections": "", "head_matter": "No. 3275.\nState v. Jennings,\nNovember Term, 1893.\nJanuary 15, 1894,"}, "file_name": "0553-01", "first_page_order": 561, "last_page_order": 561}