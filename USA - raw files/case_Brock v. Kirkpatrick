{"id": 4426505, "name": "BROCK v. KIRKPATRICK", "name_abbreviation": "Brock v. Kirkpatrick", "decision_date": "1905-10-30", "docket_number": "", "first_page": "491", "last_page": "508", "citations": [{"type": "official", "cite": "72 S.C. 491"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "25 S. C., 214", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Brev., 289", "category": "reporters:state", "reporter": "Brev.", "case_ids": [222498], "opinion_index": -1, "case_paths": ["/scl/3/0289-01"]}, {"cite": "21 S. C., 147", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343351], "opinion_index": -1, "case_paths": ["/sc/21/0147-01"]}, {"cite": "71 S, C., 67", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4424911], "opinion_index": -1, "case_paths": ["/sc/71/0067-01"]}, {"cite": "61 S. C., 426", "category": "reporters:state", "reporter": "S.C.", "case_ids": [373616], "opinion_index": -1, "case_paths": ["/sc/61/0426-01"]}, {"cite": "43 S. C., 436", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346334], "opinion_index": -1, "case_paths": ["/sc/43/0436-01"]}, {"cite": "25 S, C., 204", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716018], "opinion_index": -1, "case_paths": ["/sc/25/0204-01"]}, {"cite": "28 S'. C., 101", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4388839], "opinion_index": -1, "case_paths": ["/sc/28/0101-01"]}, {"cite": "26 S. C., 186", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "69 S. C., 231", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4421898], "opinion_index": -1, "case_paths": ["/sc/69/0231-01"]}, {"cite": "60 S. C., 352", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "62 S. C.', 89", "c