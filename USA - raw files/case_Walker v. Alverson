{"id": 1933002, "name": "WALKER v. ALVERSON", "name_abbreviation": "Walker v. Alverson", "decision_date": "1910-09-20", "docket_number": "7667", "first_page": "55", "last_page": "66", "citations": [{"type": "official", "cite": "87 S.C. 55"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "10 S. C., 386", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "1 Hill Ch., 360", "category": "reporters:state", "reporter": "Hill Eq.", "case_ids": [9504352], "opinion_index": -1, "case_paths": ["/sc-eq/10/0246-01"]}, {"cite": "2 S. C., 6", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "110 N. C., 93", "category": "reporters:state", "reporter": "N.C.", "case_ids": [11272730], "opinion_index": -1, "case_paths": ["/nc/110/0093-01"]}, {"cite": "108 Ind., 264", "category": "reporters:state", "reporter": "Ind.", "case_ids": [1971684], "opinion_index": -1, "case_paths": ["/ind/108/0264-01"]}, {"cite": "112 N. C., 1", "category": "reporters:state", "reporter": "N.C.", "case_ids": [8650307], "opinion_index": -1, "case_paths": ["/nc/112/0001-01"]}, {"cite": "75 Ga., 377", "category": "reporters:state", "reporter": "Ga.", "case_ids": [57096], "opinion_index": -1, "case_paths": ["/ga/75/0377-01"]}, {"cite": "19 S. C., 323", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4379871], "opinion_index": -1, "case_paths": ["/sc/19/0323-01"]}, {"cite": "69 S. C., 288", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S, C., 421", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "20 S. C., 72", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "38 S. C., 197", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "79 S. C., 409", "category": "r