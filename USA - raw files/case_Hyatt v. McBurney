{"id": 4379052, "name": "HYATT v. McBURNEY", "name_abbreviation": "Hyatt v. McBurney", "decision_date": "1882-10-28", "docket_number": "", "first_page": "199", "last_page": "222", "citations": [{"type": "official", "cite": "18 S.C. 199"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "99 U. S. 188", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3373303], "opinion_index": 0, "case_paths": ["/us/99/0188-01"]}, {"cite": "96 U. S. 177", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": 0}, {"cite": "17 Wall. 571", "category": "reporters:scotus_early", "reporter": "Wall.", "opinion_index": 0}, {"cite": "22 Wall. 198", "category": "reporters:scotus_early", "reporter": "Wall.", "case_ids": [3408490], "opinion_index": 0, "case_paths": ["/us/89/0198-01"]}, {"cite": "11 S. C. 551", "category": "reporters:state", "reporter": "S.C.", "case_ids": [359582], "opinion_index": 0, "case_paths": ["/sc/11/0551-01"]}, {"cite": "10 S. C. 6", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "3 S. C. 77", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2340863], "opinion_index": 0, "case_paths": ["/sc/3/0077-01"]}, {"cite": "1 S. C. 452", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9504878], "opinion_index": 0, "case_paths": ["/sc/1/0452-01"]}, {"cite": "13 Rich. Eq. 265", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": 0}, {"cite": "1 Rich. Eq. 226", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": 0}, {"cite": "1 S. C. 383", "category": "reporters:state", "reporter": "S.C.", "case_ids": [9504789], "opinion_index": 0, "case_paths": ["/sc/1/0383-01"]}, {"cite": "14 Rich. Eq. 167", "category": "reporters:state", "reporter": "Rich. Eq.", "case_ids": [1835989], "opinion_index": 0, "case_paths":