{"id": 8714902, "name": "YOUNGBLOOD v. SOUTH CAROLINA AND GEORGIA R. R. CO.", "name_abbreviation": "Youngblood v. South Carolina & Georgia R. R.", "decision_date": "1901-03-27", "docket_number": "", "first_page": "9", "last_page": "23", "citations": [{"type": "official", "cite": "60 S.C. 9"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "6 L. R. A., 246", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "45 S. C., 146", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368967], "opinion_index": -1, "case_paths": ["/sc/45/0146-01"]}, {"cite": "46 S. C., 203", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2348666], "opinion_index": -1, "case_paths": ["/sc/46/0203-01"]}, {"cite": "56 S. C., 95", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "3 Hun., 338", "category": "reporters:state", "reporter": "Hun.,", "opinion_index": -1}, {"cite": "95 N. Y., 546", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2193538], "opinion_index": -1, "case_paths": ["/ny/95/0546-01"]}, {"cite": "26 S. C., 263", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "21 S. C., 541", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2343548], "opinion_index": -1, "case_paths": ["/sc/21/0541-01"]}, {"cite": "55 S. C., 102", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "5 L. R. A., 439", "category": "reporters:federal", "reporter": "L.R.A.", "pin_cites": [{"page": "750"}], "opinion_index": -1}, {"cite": "8 Allen, 441", "category": "reporters:state", "reporter": "Allen", "case_ids": [2120358], "opinion_index": -1, "case_paths": ["/mass/90/0441-01"]}, {"cite": "18 S. C., 281", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite