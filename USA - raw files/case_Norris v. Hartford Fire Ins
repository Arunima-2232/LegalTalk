{"id": 4412339, "name": "NORRIS v. HARTFORD FIRE INS. CO", "name_abbreviation": "Norris v. Hartford Fire Ins.", "decision_date": "1900-04-13", "docket_number": "", "first_page": "358", "last_page": "371", "citations": [{"type": "official", "cite": "57 S.C. 358"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "46 Am. St. R., 796", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "15 Am. St. R., 275", "category": "reporters:state", "reporter": "Am. St. Rep.", "opinion_index": -1}, {"cite": "54 S. C., 599", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4409388], "opinion_index": -1, "case_paths": ["/sc/54/0599-01"]}, {"cite": "54 S. C., 601", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "46 S. C., 546", "category": "reporters:state", "reporter": "S.C.", "pin_cites": [{"page": "93"}], "opinion_index": -1}, {"cite": "43 S. C., 26", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346068], "opinion_index": -1, "case_paths": ["/sc/43/0026-01"]}, {"cite": "42 S. C., 14", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4401631], "opinion_index": -1, "case_paths": ["/sc/42/0014-01"]}, {"cite": "25 S. C., 27", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 544", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "54 S. C., 605", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "55 S. C., 455", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "51 S. C., 540", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8716812], "opinion_index": -1, "case_paths": ["/sc/51/0540-01"]}, {"cite": "87 Pa., 399", "category": "reporters:state", "reporter": "Pa.", "case_id