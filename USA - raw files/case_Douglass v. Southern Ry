{"id": 1924844, "name": "DOUGLASS v. SOUTHERN RY.", "name_abbreviation": "Douglass v. Southern Ry.", "decision_date": "1908-11-28", "docket_number": "7076", "first_page": "71", "last_page": "86", "citations": [{"type": "official", "cite": "82 S.C. 71"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "128 U. S., 91", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3533526], "opinion_index": -1, "case_paths": ["/us/128/0091-01"]}, {"cite": "7 L. R. A., 843", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "144 U. S-, 408", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3561123], "opinion_index": -1, "case_paths": ["/us/144/0408-01"]}, {"cite": "152 U. S., 281", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "75 S. C., 73", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "76 S'. C., 368", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429352], "opinion_index": -1, "case_paths": ["/sc/76/0368-01"]}, {"cite": "76 S. C., 308", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4429643], "opinion_index": -1, "case_paths": ["/sc/76/0308-01"]}, {"cite": "63 S. C., 271", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350479], "opinion_index": -1, "case_paths": ["/sc/63/0271-01"]}, {"cite": "72 S. C., 392", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "25 S. C., 60", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "206 U. S-, 1", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [6930837], "opinion_index": -1, "case_paths": ["/us/206/0001-01"]}, {"cite": "70 S. C., 525", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "78 S-