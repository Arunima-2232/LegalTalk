{"id": 4369990, "name": "Magwood vs. Railroad Bank", "name_abbreviation": "Magwood v. Railroad Bank", "decision_date": "1874-04", "docket_number": "", "first_page": "379", "last_page": "392", "citations": [{"type": "official", "cite": "5 S.C. 379"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "11 Wall, 377", "category": "reporters:scotus_early", "reporter": "Wall,", "pin_cites": [{"page": "378"}], "opinion_index": -1}, {"cite": "29 Conn., 246", "category": "reporters:state", "reporter": "Conn.", "opinion_index": -1}, {"cite": "5 Conn., 246", "category": "reporters:state", "reporter": "Conn.", "case_ids": [12126828], "opinion_index": -1, "case_paths": ["/conn/5/0246-01"]}, {"cite": "2 Conn., 579", "category": "reporters:state", "reporter": "Conn.", "case_ids": [6755576], "opinion_index": -1, "case_paths": ["/conn/2/0579-01"]}, {"cite": "3 Conn., 544", "category": "reporters:state", "reporter": "Conn.", "case_ids": [6755762], "opinion_index": -1, "case_paths": ["/conn/3/0544-01"]}, {"cite": "2 Wheat., 393", "category": "reporters:scotus_early", "reporter": "Wheat.", "opinion_index": -1}, {"cite": "6 Wheat., 487", "category": "reporters:scotus_early", "reporter": "Wheat.", "opinion_index": -1}, {"cite": "5 Rich. Eq., 242", "category": "reporters:state", "reporter": "Rich. Eq.", "opinion_index": -1}, {"cite": "52 Penn., 233", "category": "reporters:state", "reporter": "Penn.,", "opinion_index": -1}, {"cite": "14 Allen, 523", "category": "reporters:state", "reporter": "Allen", "case_ids": [2138173], "opinion_index": -1, "case_paths": ["/mass/96/0523-01"]}, {"cite": "8 Allen 15", "category": "reporters:state", "reporter": "Allen", "case_ids": [2120445], "weight": 2, "opinion_index": -1, "case_paths": ["/mass/90/0015-01"]}, {"cite": "12 Johns., 343", "category": "reporters:state", "reporter": "Johns.", "case_ids": [2139245], "