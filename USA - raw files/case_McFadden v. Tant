{"id": 2341958, "name": "McFadden v. Tant", "name_abbreviation": "McFadden v. Tant", "decision_date": "1884-03-13", "docket_number": "No. 1537", "first_page": "585", "last_page": "585", "citations": [{"type": "official", "cite": "20 S.C. 585"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "18 S. C. 481", "category": "reporters:state", "reporter": "S.C.", "opinion_index": 0}, {"cite": "13 Rich. 283", "category": "reporters:state", "reporter": "Rich.", "opinion_index": 0}], "analysis": {"cardinality": 135, "char_count": 1415, "ocr_confidence": 0.507, "sha256": "c5a41afb5a61c8acfdb6f331a00c7abc8913ce79d023f7377082832eb7f0dcfb", "simhash": "1:b2ad452973bfe255", "word_count": 252}, "last_updated": "2024-02-27T18:33:51.777074+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["McFadden v. Tant."], "opinions": [{"text": "Opinion by\nMr. Justice McIver,\nThis was an action for claim and delivery of a horse, judgment being rendered for defendant by the trial justice, on January 9th, 1882. Plaintiff appealed to the Court of Common Pleas, where it was heard in November, 1882, plaintiff claiming a trial de novo. The presiding judge (Aldrich) ruled that, under the provisions of section 358 of the code of procedure, which went into effect on May 1st, 1882, the appeal must be heard on the original papers sent up by the trial justice, without a jury, and without the examination of witnesses. To this ruling plaintiff excepted, and his appeal being dismissed, he further appealed to this court, upon the ground, inter alia, that \u201c his Honor erred in ruling that an appeal taken from a trial justice\u2019s court prior to May 1st, 1882, must be tried on the papers sent up from the inferior court.\u201d Upon this ground the judgment of the Circuit Court was reversed, this court holding that the change in the law of appeals from trial justices\u2019 courts, as enacted in section 358 of the code, did not apply to trials had before a trial justice prior to May 1st, 1882. Citing Lynch\u2019s Code, \u00a7 369; Ex parte Graham, 13 Rich. 283; Nichols v. Briggs, 18 S. C. 481, and that plaintiff was entitled to a trial de novo in the Circuit Court.", "type": "majority", "author": "Mr. Justice McIver,"}], "attorneys": ["L. T. Lzlar, for appellant. No counsel contra."], "corrections": "", "head_matter": "No. 1537.\nMcFadden v. Tant.\nNovember Term, 1883.\nMarch 13th, 1884.\nL. T. Lzlar, for appellant. No counsel contra."}, "file_name": "0585-01", "first_page_order": 623, "last_page_order": 623}