{"id": 359577, "name": "SPEARS & COLTON v. SPARTANBURG, UNION AND COLUMBIA RAILROAD COMPANY; GEE & HUMPHRIES v. THE SAME; THOMAS McNALLY v. THE SAME; J. C. FARRAR v. THE SAME; PHILIP M. COHEN v. THE SAME; WM. A. NICHOLSON v. THE SAME; WM. E. MoNEACE v. THE SAME", "name_abbreviation": "Spears v. Spartanburg, Union & Columbia Railroad", "decision_date": "1878-11-25", "docket_number": "CASE No. 656", "first_page": "158", "last_page": "189", "citations": [{"type": "official", "cite": "11 S.C. 158"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "34 N. Y. 501", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "10 N. Y. 438", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "44 N. Y. 510", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "52 N. Y. 637", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [510889, 511003], "opinion_index": -1, "case_paths": ["/ny/52/0637-01", "/ny/52/0637-02"]}, {"cite": "49 N. Y. 225", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "44 N. Y 511", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2335773], "opinion_index": -1, "case_paths": ["/ny-2d/44/0511-01"]}, {"cite": "19 Am. Rep. 436", "category": "reporters:state_regional", "reporter": "Am. Rep.", "pin_cites": [{"page": "437"}], "opinion_index": -1}, {"cite": "118 Mass. 201", "category": "reporters:state", "reporter": "Mass.", "case_ids": [2154053], "weight": 2, "opinion_index": -1, "case_paths": ["/mass/118/0201-01"]}, {"cite": "16 Mich. 79", "category": "reporters:state", "reporter": "Mich.", "case_ids": [1945564, 1945580], "weight": 2, "opinion_index": -1, "case_paths": ["/mich/16/0079-01", "/mich/16/0079-02"]}, {"cite": "16 Wall. 324", "category": "reporters:scotus_early", "repo