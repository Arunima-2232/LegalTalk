{"id": 4393113, "name": "State ex rel Parrott v. Evans", "name_abbreviation": "State ex rel Parrott v. Evans", "decision_date": "1891-01-28", "docket_number": "No. 2738", "first_page": "612", "last_page": "612", "citations": [{"type": "official", "cite": "33 S.C. 612"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 84, "char_count": 787, "ocr_confidence": 0.488, "sha256": "83ba01f2648a378e2a2b4179c2f03c4d1998880dda9f36a390d369d532e8fb3f", "simhash": "1:e490a06cdb5afb24", "word_count": 141}, "last_updated": "2023-07-14T18:44:25.637539+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["State ex rel Parrott v. Evans."], "opinions": [{"text": "This case is sufficiently stated in the following decision, rendered January 28, 1891:\nPer Curiam.\nThe relator, upon a proceeding in the nature of quo warranto, moved the court to issue a rule to show cause against the defendant, the object of the proceeding being to try the question of the title to the office of school commissioner, held by the defendant and claimed by the relator. This court holds that under the law they do not consider the court authorized to issue a rule to show cause in a case like this. Under the code, the proceeding should be in the nature of an action, and all actions are commenced by complaint, to which the defendant is entitled to file an answer.", "type": "majority", "author": "Per Curiam."}], "attorneys": ["Motion refused. S. S. Newton, for relator."], "corrections": "", "head_matter": "No. 2738.\nState ex rel Parrott v. Evans.\nNovember Term, 1890.\nMotion refused. S. S. Newton, for relator."}, "file_name": "0612-03", "first_page_order": 622, "last_page_order": 622}