{"id": 1923003, "name": "McLEAN v. ATLANTIC COAST LINE R. R. CO.", "name_abbreviation": "McLean v. Atlantic Coast Line R. R.", "decision_date": "1908-07-25", "docket_number": "6978", "first_page": "100", "last_page": "114", "citations": [{"type": "official", "cite": "81 S.C. 100"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "92 Mo., 208", "category": "reporters:state", "reporter": "Mo.", "case_ids": [1024247], "opinion_index": -1, "case_paths": ["/mo/92/0208-01"]}, {"cite": "24 L. R. A., 710", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "39 L. R. A., 499", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "15 L. R. A., 33", "category": "reporters:federal", "reporter": "L.R.A.", "opinion_index": -1}, {"cite": "74 S. C., 136", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "34 Mo. App, 57", "category": "reporters:state", "reporter": "Mo. App.", "case_ids": [494423], "opinion_index": -1, "case_paths": ["/mo-app/34/0057-01"]}, {"cite": "6 Bush, 574", "category": "reporters:state", "reporter": "Bush", "case_ids": [2344003], "opinion_index": -1, "case_paths": ["/ky/69/0574-01"]}, {"cite": "5 Bush, 1", "category": "reporters:state", "reporter": "Bush", "case_ids": [2343830], "opinion_index": -1, "case_paths": ["/ky/68/0001-01"]}, {"cite": "2 Dud, 114", "category": "reporters:state", "reporter": "Dud.", "opinion_index": -1}, {"cite": "59 Ala, 272", "category": "reporters:state", "reporter": "Ala.", "case_ids": [5621985], "opinion_index": -1, "case_paths": ["/ala/59/0272-01"]}, {"cite": "81 Ala, 185", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3359760], "opinion_index": -1, "case_paths": ["/ala/81/0185-01"]}, {"cite": "53 Ala, 70", "category": "reporters:state", "reporter": "Ala.", "case_ids": [3