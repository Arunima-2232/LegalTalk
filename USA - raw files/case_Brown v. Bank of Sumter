{"id": 4410358, "name": "BROWN v. THE BANK OF SUMTER", "name_abbreviation": "Brown v. Bank of Sumter", "decision_date": "1899-04-22", "docket_number": "", "first_page": "51", "last_page": "78", "citations": [{"type": "official", "cite": "55 S.C. 51"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "45 S. C, 614", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368972], "opinion_index": -1, "case_paths": ["/sc/45/0614-01"]}, {"cite": "26 S. C., 401", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4386132], "opinion_index": -1, "case_paths": ["/sc/26/0401-01"]}, {"cite": "20 S. C., 558", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "41 S. C., 169", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "26 Mass., 184", "category": "reporters:state", "reporter": "Mass.", "opinion_index": -1}, {"cite": "7 Conn., 143", "category": "reporters:state", "reporter": "Conn.", "case_ids": [6753362], "opinion_index": -1, "case_paths": ["/conn/7/0143-01"]}, {"cite": "19 Wend., 518", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2023416], "opinion_index": -1, "case_paths": ["/wend/19/0518-01"]}, {"cite": "16 N. J. Eq., 189", "category": "reporters:state", "reporter": "N.J. Eq.", "case_ids": [514277], "opinion_index": -1, "case_paths": ["/nj-eq/16/0189-01"]}, {"cite": "14 Pick., 467", "category": "reporters:state", "reporter": "Pick.", "case_ids": [2018910], "opinion_index": -1, "case_paths": ["/mass/31/0467-01"]}, {"cite": "2 Cranch, 218", "category": "reporters:scotus_early", "reporter": "Cranch,", "case_ids": [6760802, 6760813], "opinion_index": -1, "case_paths": ["/dc/2/0218-01", "/dc/2/0218-02"]}, {"cite": "33 Vt., 125", "category": "reporters:state", "reporter": "Vt.", "opinion_index": -1}, {"cite": "7 la., 114", "cate