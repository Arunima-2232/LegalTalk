{"id": 4422191, "name": "RICHEY v. SOUTHERN RY.", "name_abbreviation": "Richey v. Southern Ry.", "decision_date": "1904-07-13", "docket_number": "", "first_page": "387", "last_page": "399", "citations": [{"type": "official", "cite": "69 S.C. 387"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "68 S. C., 55", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4421298], "opinion_index": -1, "case_paths": ["/sc/68/0055-01"]}, {"cite": "80 N. Y., 46", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [2173179], "opinion_index": -1, "case_paths": ["/ny/80/0046-01"]}, {"cite": "18 S. C., 262", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4379420], "pin_cites": [{"page": "275"}], "opinion_index": -1, "case_paths": ["/sc/18/0262-01"]}, {"cite": "19 S. C., 20", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4380519], "opinion_index": -1, "case_paths": ["/sc/19/0020-01"]}, {"cite": "22 S. C., 557", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4381634], "opinion_index": -1, "case_paths": ["/sc/22/0557-01"]}, {"cite": "23 S. C., 528", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 54", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 Fed. R., 384", "category": "reporters:federal", "reporter": "F.", "case_ids": [3788771], "opinion_index": -1, "case_paths": ["/f/65/0384-01"]}, {"cite": "66 S. C., 302", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4417738], "opinion_index": -1, "case_paths": ["/sc/66/0302-01"]}, {"cite": "61 S. C., 494", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "65 S. C., 194", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "18 S. C., 268", "category": "reporters:s