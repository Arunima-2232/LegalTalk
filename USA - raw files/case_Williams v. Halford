{"id": 2351179, "name": "WILLIAMS v. HALFORD", "name_abbreviation": "Williams v. Halford", "decision_date": "1905-12-05", "docket_number": "", "first_page": "119", "last_page": "129", "citations": [{"type": "official", "cite": "73 S.C. 119"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "23 S, C., 120", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4383464], "opinion_index": -1, "case_paths": ["/sc/23/0120-01"]}, {"cite": "45 S. C., 4", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368987], "opinion_index": -1, "case_paths": ["/sc/45/0004-01"]}, {"cite": "54 S. C., 155", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4408930], "opinion_index": -1, "case_paths": ["/sc/54/0155-01"]}, {"cite": "67 S. C., 296", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4419149], "opinion_index": -1, "case_paths": ["/sc/67/0296-01"]}, {"cite": "45 S. C., 107", "category": "reporters:state", "reporter": "S.C.", "case_ids": [368983], "opinion_index": -1, "case_paths": ["/sc/45/0107-01"]}, {"cite": "32 S. C., 107", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2346175], "opinion_index": -1, "case_paths": ["/sc/32/0107-01"]}, {"cite": "27 S. C., 39", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387596], "opinion_index": -1, "case_paths": ["/sc/27/0039-01"]}, {"cite": "26 S. C., 179", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4387414], "opinion_index": -1, "case_paths": ["/sc/26/0179-01"]}, {"cite": "63 S. C., 219", "category": "reporters:state", "reporter": "S.C.", "case_ids": [2350257], "opinion_index": -1, "case_paths": ["/sc/63/0219-01"]}, {"cite": "59 S. C., 440", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4414776], "opinion_index": -1, "case_paths": ["/sc/59/0440-01"]}, {"cite": "25 S, C,