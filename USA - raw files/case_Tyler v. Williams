{"id": 8716396, "name": "TYLER v. WILLIAMS", "name_abbreviation": "Tyler v. Williams", "decision_date": "1898-10-20", "docket_number": "", "first_page": "367", "last_page": "382", "citations": [{"type": "official", "cite": "53 S.C. 367"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "65 Am. Dec., 621", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "2 Bail., 101", "category": "reporters:state", "reporter": "Bail.", "case_ids": [2514120, 2510137], "opinion_index": -1, "case_paths": ["/scl/18/0101-01", "/scl/18/0101-02"]}, {"cite": "7 S. C., 228", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4373030], "opinion_index": -1, "case_paths": ["/sc/7/0228-01"]}, {"cite": "1 Rich., 429", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8486872], "pin_cites": [{"page": "435"}], "opinion_index": -1, "case_paths": ["/scl/30/0429-01"]}, {"cite": "14 Am. Dec., 695", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "65 Ga., 201", "category": "reporters:state", "reporter": "Ga.", "case_ids": [52392], "opinion_index": -1, "case_paths": ["/ga/65/0201-01"]}, {"cite": "70 Ga., 756", "category": "reporters:state", "reporter": "Ga.", "case_ids": [27598], "opinion_index": -1, "case_paths": ["/ga/70/0756-01"]}, {"cite": "19 S. C., 124", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "17 S. C., 481", "category": "reporters:state", "reporter": "S.C.", "case_ids": [363255], "opinion_index": -1, "case_paths": ["/sc/17/0481-01"]}, {"cite": "15 S. C., 10", "category": "reporters:state", "reporter": "S.C.", "case_ids": [8715118], "pin_cites": [{"page": "296"}], "opinion_index": -1, "case_paths": ["/sc/15/0010-01"]}, {"cite": "24 S. C., 497", "category": "reporters:state", "reporter": "S.C.", "opinion_inde