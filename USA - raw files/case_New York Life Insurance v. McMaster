": "142 U. S., 399", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "134 U. S., 232", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8299194], "opinion_index": -1, "case_paths": ["/us/134/0232-01"]}, {"cite": "148 U. S., 662", "category": "reporters:federal", "reporter": "U.S.", "opinion_index": -1}, {"cite": "134 U. S., 594", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [8299488], "opinion_index": -1, "case_paths": ["/us/134/0594-01"]}, {"cite": "115 U. S., 321", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3514416], "opinion_index": -1, "case_paths": ["/us/115/0321-01"]}, {"cite": "16 Wis., 136", "category": "reporters:state", "reporter": "Wis.", "case_ids": [11285340], "opinion_index": -1, "case_paths": ["/wis/16/0136-01"]}, {"cite": "40 S. E., 514", "category": "reporters:state_regional", "reporter": "S.E.", "opinion_index": -1}, {"cite": "13 Gratt., 767", "category": "reporters:state", "reporter": "Gratt.", "case_ids": [4437622], "opinion_index": -1, "case_paths": ["/va/54/0292-01"]}, {"cite": "85 Pa., 513", "category": "reporters:state", "reporter": "Pa.", "case_ids": [440454], "opinion_index": -1, "case_paths": ["/pa/85/0513-01"]}, {"cite": "28 Ohio St., 521", "category": "reporters:state", "reporter": "Ohio St.", "case_ids": [894670], "opinion_index": -1, "case_paths": ["/ohio-st/28/0521-01"]}, {"cite": "13 Nev., 424", "category": "reporters:state", "reporter": "Nev.", "case_ids": [4624379], "opinion_index": -1, "case_paths": ["/nev/13/0424-01"]}, {"cite": "29 Kans., 672", "category": "reporters:state", "reporter": "Kan.", "case_ids": [60786], "opinion_index": -1, "case_paths": ["/kan/29/0672-01"]}, {"cite": "115 Ind., 257", "category": "reporters:state", "reporter": "Ind.", "case_ids": [1327430], "opinion_index": -1, "case_paths": ["/ind/115/0257-01"]}, {"cite": "104 Ill., 653", "category": "reporters:state", "reporter": "Ill.", "case_ids": [5348663], "opinion_i