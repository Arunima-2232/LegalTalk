{"id": 4419571, "name": "SMITH, RECEIVER, v. JENNINGS, TREASURER", "name_abbreviation": "Smith v. Jennings", "decision_date": "1903-09-10", "docket_number": "", "first_page": "324", "last_page": "338", "citations": [{"type": "official", "cite": "67 S.C. 324"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "4 S. C., 431", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "86 N. W., 956", "category": "reporters:state_regional", "reporter": "N.W.", "opinion_index": -1}, {"cite": "52 Mo., 426", "category": "reporters:state", "reporter": "Mo.", "opinion_index": -1}, {"cite": "16 Ind., 49", "category": "reporters:state", "reporter": "Ind.", "opinion_index": -1}, {"cite": "40 Miss., 293", "category": "reporters:state", "reporter": "Miss.", "opinion_index": -1}, {"cite": "73 Minn., 203", "category": "reporters:state", "reporter": "Minn.", "case_ids": [1638667], "opinion_index": -1, "case_paths": ["/minn/73/0203-01"]}, {"cite": "10 Nev., 250", "category": "reporters:state", "reporter": "Nev.", "case_ids": [8577524], "opinion_index": -1, "case_paths": ["/nev/10/0250-01"]}, {"cite": "12 Wheat., 213", "category": "reporters:scotus_early", "reporter": "Wheat.", "case_ids": [1429818], "opinion_index": -1, "case_paths": ["/us/25/0213-01"]}, {"cite": "135 U. S., 662", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3543740], "opinion_index": -1, "case_paths": ["/us/135/0662-01"]}, {"cite": "96 U. S-, 595", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [3379669], "opinion_index": -1, "case_paths": ["/us/96/0595-01"]}, {"cite": "4 Wheat., 122", "category": "reporters:scotus_early", "reporter": "Wheat.", "case_ids": [4696], "opinion_index": -1, "case_paths": ["/us/17/0122-01"]}, {"cite": "2 Pet., 627", "category": "reporters:scotus_early", "reporter": "Pet.", "case_ids": [