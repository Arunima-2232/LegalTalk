{"id": 4392339, "name": "Holliday v. Holliday", "name_abbreviation": "Holliday v. Holliday", "decision_date": "1889-03-06", "docket_number": "No. 2371", "first_page": "613", "last_page": "613", "citations": [{"type": "official", "cite": "30 S.C. 613"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [], "analysis": {"cardinality": 81, "char_count": 726, "ocr_confidence": 0.559, "sha256": "0989191050c4e7cb697d8a211bd1fba2f79c0ba3d13bb6930ba947ba8d8bc18f", "simhash": "1:bed34198700a4efc", "word_count": 116}, "last_updated": "2023-07-14T18:07:02.879123+00:00", "provenance": {"date_added": "2019-08-29", "source": "Harvard", "batch": "2018"}, "casebody": {"judges": [], "parties": ["Holliday v. Holliday."], "opinions": [{"text": "Opinion by\nMr. Justice McGowan,\nSome hogs of defendant trespassed upon land owned by plaintiff, but occupied and cultivated by P. as tenant of plaintiff. P., as agent of plaintiff, and under his direction, seized these hogs. The action was to recover compensation for their seizure, under the statute. Gen. Stat., \u00a7 1186. Held, that only P. could maintain the action, he being owner within the meaning of the statute, which gives an action to \u201cany freeholder or tenant of land, his agent or representative,\u201d for compensation for hogs trespassing \u201coil his premises.\u201d Judgment (Aldrich, J.) reversed.", "type": "majority", "author": "Mr. Justice McGowan,"}], "attorneys": ["Haynsworth $ Dinkins, for appellant.", "B. P. Barron, contra."], "corrections": "", "head_matter": "No. 2371.\nHolliday v. Holliday.\nNovember Term, 1888.\nMarch 6, 1889.\nHaynsworth $ Dinkins, for appellant.\nB. P. Barron, contra."}, "file_name": "0613-01", "first_page_order": 623, "last_page_order": 623}