{"id": 4429706, "name": "EXCHANGE BANK v. McMILLAN", "name_abbreviation": "Exchange Bank v. McMillan", "decision_date": "1907-04-19", "docket_number": "", "first_page": "561", "last_page": "574", "citations": [{"type": "official", "cite": "76 S.C. 561"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "29 S. C., 345", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "33 S. C., 243", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4393640], "opinion_index": -1, "case_paths": ["/sc/33/0243-01"]}, {"cite": "42 S. C., 8", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "13 S. C., 240", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "69 S. C., 168", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422523], "opinion_index": -1, "case_paths": ["/sc/69/0168-01"]}, {"cite": "69 S. C., 374", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4422106], "opinion_index": -1, "case_paths": ["/sc/69/0374-01"]}, {"cite": "49 S. C., 45", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "37 S. C., 579", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4397639], "opinion_index": -1, "case_paths": ["/sc/37/0579-01"]}, {"cite": "62 S. C., 178", "category": "reporters:state", "reporter": "S.C.", "case_ids": [4416071], "opinion_index": -1, "case_paths": ["/sc/62/0178-01"]}, {"cite": "58 S. C., 345", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "53 S. C., 117", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "47 S. C., 406", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "29 S. C., 508", "category": "reporters:state", "reporter": "S.C.", "opinion_index