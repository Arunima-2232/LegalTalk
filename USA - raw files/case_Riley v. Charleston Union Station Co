{"id": 4425253, "name": "RILEY v. CHARLESTON UNION STATION CO.", "name_abbreviation": "Riley v. Charleston Union Station Co.", "decision_date": "1905-04-18", "docket_number": "", "first_page": "457", "last_page": "492", "citations": [{"type": "official", "cite": "71 S.C. 457"}], "court": {"name_abbreviation": "S.C.", "id": 8894, "name": "Supreme Court of South Carolina"}, "jurisdiction": {"id": 59, "name_long": "South Carolina", "name": "S.C."}, "cites_to": [{"cite": "77 N. Y., 149", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "6 Vroom, 546", "category": "reporters:state", "reporter": "Vroom", "opinion_index": -1}, {"cite": "80 Ky., 259", "category": "reporters:state", "reporter": "Ky.", "case_ids": [4396829], "opinion_index": -1, "case_paths": ["/ky/80/0259-01"]}, {"cite": "46 N. Y., 346", "category": "reporters:state", "reporter": "N.Y.", "opinion_index": -1}, {"cite": "2 Rich., 434", "category": "reporters:state", "reporter": "Rich.", "case_ids": [8859540], "opinion_index": -1, "case_paths": ["/scl/31/0434-01"]}, {"cite": "70 Ky., 635", "category": "reporters:state", "reporter": "Ky.", "case_ids": [4383885], "opinion_index": -1, "case_paths": ["/ky/70/0635-01"]}, {"cite": "23 S. C., 434", "category": "reporters:state", "reporter": "S.C.", "opinion_index": -1}, {"cite": "77 N. Y., 248", "category": "reporters:state", "reporter": "N.Y.", "case_ids": [542854], "opinion_index": -1, "case_paths": ["/ny/77/0248-01"]}, {"cite": "68 Am. Dec., 660", "category": "reporters:federal", "reporter": "Am. Dec.", "opinion_index": -1}, {"cite": "98 U. S., 403", "category": "reporters:federal", "reporter": "U.S.", "case_ids": [11280], "opinion_index": -1, "case_paths": ["/us/98/0403-01"]}, {"cite": "50 N. J. Eq., 74", "category": "reporters:state", "reporter": "N.J. Eq.", "opinion_index": -1}, {"cite": "23 Wend., 193", "category": "reporters:state", "reporter": "Wend.", "case_ids": [2025510], "opinion_index": -1, "case_paths": ["/wend/23/0193-0